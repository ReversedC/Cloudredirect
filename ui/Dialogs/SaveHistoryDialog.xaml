<ui:FluentWindow x:Class="CloudRedirect.Dialogs.SaveHistoryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:res="clr-namespace:CloudRedirect.Resources"
        Title="Save Version History &amp; Rollback"
        Width="720" Height="500"
        MinWidth="580" MinHeight="380"
        MaxWidth="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Width}"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SteamWindowBackgroundGradient}"
        ExtendsContentIntoTitleBar="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="AppTitleBar" Grid.Row="0" Title="{res:Loc SaveHistory_Title}" />

        <Grid Grid.Row="1" Margin="24,12,24,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header section -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="GameTitleText"
                               Text="Game Save History"
                               FontSize="18" FontWeight="Bold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock x:Name="GameSubtitleText"
                               Text="{res:Loc SaveHistory_Subtitle}"
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Margin="0,3,0,0" />
                </StackPanel>

                <ui:Button Grid.Column="1"
                           Appearance="Primary"
                           Click="CreateSnapshotNow_Click"
                           VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Camera24" FontSize="14" Margin="0,0,6,0" />
                        <TextBlock Text="Create Snapshot" VerticalAlignment="Center" />
                    </StackPanel>
                </ui:Button>
            </Grid>

            <!-- Empty state when no snapshots exist (Centered) -->
            <Border x:Name="EmptyStateBorder"
                    Grid.Row="1"
                    Visibility="Collapsed"
                    Background="#141E28"
                    BorderBrush="#253548"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="32,24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MaxWidth="520">
                <StackPanel HorizontalAlignment="Center">
                    <ui:SymbolIcon Symbol="History24" FontSize="36" Foreground="#445870" HorizontalAlignment="Center" />
                    <TextBlock Text="{res:Loc SaveHistory_EmptyTitle}"
                               FontWeight="SemiBold" FontSize="14"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               HorizontalAlignment="Center" Margin="0,10,0,4" />
                    <TextBlock Text="{res:Loc SaveHistory_EmptySubtitle}"
                               FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" TextAlignment="Center" MaxWidth="440" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                        <ui:Button Appearance="Primary"
                                   Click="CreateSnapshotNow_Click"
                                   Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Camera24" FontSize="14" Margin="0,0,6,0" />
                                <TextBlock Text="Create Snapshot Now" VerticalAlignment="Center" />
                            </StackPanel>
                        </ui:Button>
                        <ui:Button Content="{res:Loc SaveHistory_BtnDrive}"
                                   Appearance="Secondary"
                                   Icon="{ui:SymbolIcon Cloud24}"
                                   Click="OpenDriveFolder_Click"
                                   Margin="0,0,8,0" />
                        <ui:Button Content="{res:Loc SaveHistory_BtnLocal}"
                                   Appearance="Secondary"
                                   Icon="{ui:SymbolIcon FolderOpen24}"
                                   Click="OpenLocalFolder_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Snapshots List -->
            <ListBox x:Name="SnapshotsListBox"
                     Grid.Row="1"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,8" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#16222F"
                                BorderBrush="#2A3D52"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="14,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Icon -->
                                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18"
                                        Background="#1C2D3E" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="History24" FontSize="18" Foreground="#66C0F4"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>

                                <!-- Info -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding FormattedTime}"
                                                   FontWeight="SemiBold" FontSize="13"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <Border Background="#1E3324" BorderBrush="#355E18" BorderThickness="1"
                                                CornerRadius="3" Padding="5,1" Margin="8,0,0,0">
                                            <TextBlock Text="{Binding Trigger}"
                                                       FontSize="10" FontWeight="SemiBold"
                                                       Foreground="#A4D007" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock FontSize="11" Foreground="#8F98A0" Margin="0,3,0,0">
                                        <Run Text="{Binding FileCount, Mode=OneWay}" />
                                        <Run Text=" file(s)  •  " />
                                        <Run Text="{Binding FormattedSize, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>

                                <!-- Action Buttons -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:Button Appearance="Secondary"
                                               Click="BrowseSnapshot_Click"
                                               Tag="{Binding}"
                                               Margin="0,0,6,0"
                                               Padding="10,5">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="FolderOpen24" FontSize="14" Margin="0,0,6,0" Foreground="#66C0F4" />
                                            <TextBlock Text="{res:Loc SaveHistory_BtnBrowse}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </ui:Button>
                                    <ui:Button Appearance="Primary"
                                               Click="RestoreSnapshot_Click"
                                               Tag="{Binding}"
                                               Margin="0,0,6,0"
                                               Padding="12,5">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="14" Margin="0,0,6,0" />
                                            <TextBlock Text="{res:Loc SaveHistory_BtnRestore}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </ui:Button>
                                    <ui:Button Appearance="Secondary"
                                               Click="DeleteSnapshot_Click"
                                               Tag="{Binding}"
                                               Padding="8,5"
                                               ToolTip="Delete this snapshot">
                                        <ui:SymbolIcon Symbol="Delete24" FontSize="14" Foreground="#FF6B6B" />
                                    </ui:Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <!-- Bottom Action Bar -->
        <Border Grid.Row="2" Background="#141E28" BorderBrush="#253548" BorderThickness="0,1,0,0" Padding="20,12">
            <DockPanel LastChildFill="False">
                <ui:Button Content="{res:Loc SaveHistory_BtnClose}"
                           Appearance="Secondary"
                           Click="Close_Click"
                           DockPanel.Dock="Right"
                           HorizontalAlignment="Right"
                           MinWidth="80" />
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <ui:Button Content="{res:Loc SaveHistory_BtnDrive}"
                               Appearance="Secondary"
                               Icon="{ui:SymbolIcon Cloud24}"
                               Click="OpenDriveFolder_Click"
                               Margin="0,0,8,0" />
                    <ui:Button Content="{res:Loc SaveHistory_BtnFolder}"
                               Appearance="Secondary"
                               Icon="{ui:SymbolIcon Folder24}"
                               Click="OpenBaseFolder_Click"
                               Margin="0,0,8,0" />
                    <ui:Button Content="{res:Loc SaveHistory_BtnLocal}"
                               Appearance="Secondary"
                               Icon="{ui:SymbolIcon FolderOpen24}"
                               Click="OpenLocalFolder_Click" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
