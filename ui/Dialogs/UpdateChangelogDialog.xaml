<ui:FluentWindow x:Class="CloudRedirect.Dialogs.UpdateChangelogDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:res="clr-namespace:CloudRedirect.Resources"
        Title="CloudRedirect — Update Changelog"
        Width="700" Height="540"
        MinWidth="540" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SteamWindowBackgroundGradient}"
        ExtendsContentIntoTitleBar="True">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- TitleBar -->
            <RowDefinition Height="*" />    <!-- Content -->
            <RowDefinition Height="Auto" /> <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- Steam Window TitleBar -->
        <ui:TitleBar x:Name="AppTitleBar" Grid.Row="0" Title="Update Changelog" />

        <Grid Grid.Row="1" Margin="24,8,24,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 1. Header with Controls -->
            <Border Grid.Row="0"
                    Background="#101923"
                    BorderBrush="#1F3347"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16,12"
                    Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="#182E42"
                            BorderBrush="#254A6B"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="8"
                            Margin="0,0,12,0"
                            VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="History24" FontSize="20" Foreground="#66C0F4" />
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="Release Changelog"
                                   FontSize="17" FontWeight="Bold"
                                   Foreground="#FFFFFF" />
                        <TextBlock Text="Explore recent updates, new gaming optimizations, and fixes."
                                   FontSize="11" Foreground="#8F98A0" Margin="0,2,0,0" TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:Button x:Name="RefreshButton"
                                   Appearance="Secondary"
                                   Padding="12,5"
                                   FontSize="11"
                                   Icon="{ui:SymbolIcon ArrowSync24}"
                                   Content="Refresh"
                                   Click="RefreshButton_Click"
                                   Cursor="Hand" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. Main Releases List with Loading State -->
            <Grid Grid.Row="1">
                <!-- Loading State -->
                <StackPanel x:Name="LoadingState"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Visibility="Visible">
                    <ui:ProgressRing IsIndeterminate="True" Width="36" Height="36" Margin="0,0,0,12" />
                    <TextBlock Text="Loading release notes..."
                               FontSize="12" Foreground="#8F98A0"
                               HorizontalAlignment="Center" />
                </StackPanel>

                <!-- Scrollable Changelog List -->
                <ScrollViewer x:Name="ChangelogScroll"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Visibility="Collapsed">
                    <ItemsControl x:Name="ReleasesItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#14202D"
                                        BorderBrush="#21374C"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="16,14"
                                        Margin="0,0,0,12">
                                    <StackPanel>
                                        <!-- Top Row: Tag, Badges, Date -->
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding TagName}"
                                                           FontSize="15" FontWeight="Bold"
                                                           Foreground="#66C0F4"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,8,0" />

                                                <!-- Current Version Badge -->
                                                <Border Background="#143224"
                                                        BorderBrush="#5BA32B"
                                                        BorderThickness="1"
                                                        CornerRadius="4"
                                                        Padding="6,2"
                                                        Margin="0,0,6,0"
                                                        VerticalAlignment="Center"
                                                        Visibility="{Binding IsCurrentVersion, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="CURRENT"
                                                               FontSize="9" FontWeight="Bold"
                                                               Foreground="#A4D007" />
                                                </Border>

                                                <!-- Pre-release / Beta Badge -->
                                                <Border Background="#162B3D"
                                                        BorderBrush="#00D2FF"
                                                        BorderThickness="1"
                                                        CornerRadius="4"
                                                        Padding="6,2"
                                                        VerticalAlignment="Center"
                                                        Visibility="{Binding IsPrerelease, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="BETA"
                                                               FontSize="9" FontWeight="Bold"
                                                               Foreground="#00D2FF" />
                                                </Border>
                                            </StackPanel>

                                            <!-- Release Date -->
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding PublishedAt}"
                                                       FontSize="11"
                                                       Foreground="#8F98A0"
                                                       VerticalAlignment="Center" />
                                        </Grid>

                                        <!-- Title / Headline -->
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="12" FontWeight="SemiBold"
                                                   Foreground="#C7D5E0"
                                                   Margin="0,0,0,8"
                                                   TextWrapping="Wrap" />

                                        <!-- Changelog Body -->
                                        <Border Background="#0C141C"
                                                BorderBrush="#192A3A"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="12,10">
                                            <TextBlock Text="{Binding Body}"
                                                       FontSize="11.5"
                                                       LineHeight="17"
                                                       Foreground="#A6B4C2"
                                                       TextWrapping="Wrap" />
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- 3. Bottom Close Bar -->
        <Border Grid.Row="2"
                Background="#0F1822"
                BorderBrush="#1B2D3E"
                BorderThickness="0,1,0,0"
                Padding="24,10">
            <DockPanel LastChildFill="False">
                <TextBlock Text="CloudRedirect Auto-Update System"
                           FontSize="11" Foreground="#556778"
                           VerticalAlignment="Center"
                           DockPanel.Dock="Left" />
                <ui:Button Appearance="Secondary"
                           Content="Close"
                           Padding="18,6"
                           FontSize="11"
                           Click="CloseButton_Click"
                           Cursor="Hand"
                           DockPanel.Dock="Right" />
            </DockPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
