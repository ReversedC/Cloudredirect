<ui:FluentWindow x:Class="CloudRedirect.Dialogs.MobileStreamingGuideDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="CloudRedirect — Mobile Streaming &amp; Moonlight Guide"
        Width="880" Height="680"
        MinWidth="640" MinHeight="480"
        MaxWidth="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Width}"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SteamWindowBackgroundGradient}"
        ExtendsContentIntoTitleBar="True">

    <Grid Margin="0,0,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- TitleBar -->
        <ui:TitleBar Grid.Row="0" Title="Mobile Streaming Guide (GameHub &amp; Moonlight)">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/steam_logo3.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- Main Scrollable Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="24,10,24,12">
            <StackPanel>

                <!-- HERO STATUS & HOST INFO CARD -->
                <Border Background="#14202D" BorderBrush="#253D52" BorderThickness="1.5" CornerRadius="8" Padding="18,16" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Host Details Left -->
                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="32" Height="32" Background="#1D3042" CornerRadius="16" Margin="0,0,10,0">
                                    <ui:SymbolIcon Symbol="Tv24" FontSize="18" Foreground="#00D2FF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Sunshine GameStream Host" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                <Border Background="#163823" BorderBrush="#287340" BorderThickness="1" CornerRadius="12" Padding="10,3" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="7" Height="7" Fill="#66D18F" Margin="0,0,6,0" />
                                        <TextBlock x:Name="SunshineStatusBadge" Text="Active &amp; Ready" FontSize="11.5" FontWeight="SemiBold" Foreground="#66D18F" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <TextBlock Text="Stream your .lua and Steam games to mobile devices at 60/120 FPS with built-in GameHub touch HUD." 
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12.5" Margin="0,6,0,12" />

                            <!-- IP & PC Info Pill Badges -->
                            <WrapPanel VerticalAlignment="Center">
                                <Border Background="#0E1620" BorderBrush="#1C2E3F" BorderThickness="1" CornerRadius="6" Padding="10,5" Margin="0,0,10,6">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:SymbolIcon Symbol="Desktop24" FontSize="14" Foreground="#8F98A0" Margin="0,0,6,0" />
                                        <TextBlock Text="PC Name: " Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" />
                                        <TextBlock x:Name="PcNameText" Text="MY-PC" FontWeight="Bold" Foreground="#66C0F4" FontSize="12" />
                                    </StackPanel>
                                </Border>

                                <Border Background="#0E1620" BorderBrush="#1C2E3F" BorderThickness="1" CornerRadius="6" Padding="10,5" Margin="0,0,10,6">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:SymbolIcon Symbol="Wifi124" FontSize="14" Foreground="#00D2FF" Margin="0,0,6,0" />
                                        <TextBlock Text="Home LAN IP: " Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" />
                                        <TextBlock x:Name="LanIpText" Text="192.168.1.100" FontWeight="Bold" Foreground="#00D2FF" FontSize="12" Margin="0,0,8,0" />
                                        <ui:Button x:Name="CopyIpBtn" Content="Copy" Appearance="Transparent" Padding="6,2" FontSize="11" Click="CopyIp_Click" Cursor="Hand" />
                                    </StackPanel>
                                </Border>

                                <Border x:Name="TailscaleIpBorder" Background="#0E1620" BorderBrush="#254359" BorderThickness="1" CornerRadius="6" Padding="10,5" Margin="0,0,10,6">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:SymbolIcon Symbol="Globe24" FontSize="14" Foreground="#66D18F" Margin="0,0,6,0" />
                                        <TextBlock Text="Work / 5G IP: " Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" />
                                        <TextBlock x:Name="TailscaleIpText" Text="100.120.175.117" FontWeight="Bold" Foreground="#66D18F" FontSize="12" Margin="0,0,8,0" />
                                        <ui:Button x:Name="CopyTailscaleIpBtn" Content="Copy" Appearance="Transparent" Padding="6,2" FontSize="11" Click="CopyTailscaleIp_Click" Cursor="Hand" />
                                    </StackPanel>
                                </Border>

                                <Border Background="#0E1620" BorderBrush="#1C2E3F" BorderThickness="1" CornerRadius="6" Padding="10,5" Margin="0,0,0,6">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:SymbolIcon Symbol="LockClosed20" FontSize="13" Foreground="#66D18F" Margin="0,0,6,0" />
                                        <TextBlock Text="Port: " Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" />
                                        <TextBlock Text="47990 (SSL)" FontWeight="SemiBold" Foreground="#66D18F" FontSize="12" />
                                    </StackPanel>
                                </Border>
                            </WrapPanel>
                        </StackPanel>

                        <!-- Host Actions Right -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                            <ui:Button Appearance="Primary"
                                       Content="Enter 4-Digit PIN"
                                       Icon="{ui:SymbolIcon Key24}"
                                       Click="EnterPin_Click"
                                       Width="160"
                                       Margin="0,0,0,6"
                                       Cursor="Hand" />
                            <ui:Button Appearance="Secondary"
                                       Content="Open Dashboard"
                                       Icon="{ui:SymbolIcon Globe24}"
                                       Click="OpenDashboard_Click"
                                       Width="160"
                                       Margin="0,0,0,6"
                                       Cursor="Hand" />
                            <ui:Button Appearance="Secondary"
                                       Content="Sync Games Now"
                                       Icon="{ui:SymbolIcon ArrowSync24}"
                                       Click="SyncGames_Click"
                                       Width="160"
                                       Cursor="Hand" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- MIDDLE DUAL-CARD ROW: CREDENTIALS & PHONE QR CODE -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.35*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- CARD 1: SUNSHINE CREDENTIALS -->
                    <Border Grid.Column="0" Background="#14202D" BorderBrush="#253D52" BorderThickness="1" CornerRadius="8" Padding="16,14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Header -->
                            <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="ShieldKeyhole24" FontSize="18" Foreground="#00D2FF" Margin="0,0,8,0" />
                                    <TextBlock Text="Sunshine Web Credentials" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                </StackPanel>
                                <ui:Button DockPanel.Dock="Right"
                                           Appearance="Transparent"
                                           Content="Web UI"
                                           Icon="{ui:SymbolIcon Globe20}"
                                           Padding="8,4"
                                           Click="OpenDashboard_Click"
                                           Cursor="Hand" />
                            </DockPanel>

                            <!-- Inputs Row -->
                            <Grid Grid.Row="1" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="1.4*" />
                                </Grid.ColumnDefinitions>

                                <!-- Username -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Username" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,3" />
                                    <Grid>
                                        <TextBox x:Name="SunshineUsernameText" Text="admin" IsReadOnly="True" Height="32" VerticalContentAlignment="Center" Background="#0E1620" BorderBrush="#243C52" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Padding="8,0,30,0" />
                                        <ui:Button HorizontalAlignment="Right" VerticalAlignment="Center" Width="26" Height="26" Margin="0,0,2,0" Appearance="Transparent" Icon="{ui:SymbolIcon Copy16}" ToolTip="Copy Username" Click="CopyUsername_Click" Cursor="Hand" />
                                    </Grid>
                                </StackPanel>

                                <!-- Password with Reveal & Copy -->
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Web Password" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,3" />
                                    <Grid>
                                        <TextBox x:Name="SunshinePasswordText" Height="32" VerticalContentAlignment="Center" Background="#0E1620" BorderBrush="#243C52" Foreground="#66D18F" FontWeight="Bold" Padding="8,0,56,0" IsReadOnly="True" />
                                        <PasswordBox x:Name="SunshinePasswordBox" Height="32" VerticalContentAlignment="Center" Background="#0E1620" BorderBrush="#243C52" Foreground="#66D18F" Padding="8,0,56,0" Visibility="Collapsed" IsEnabled="False" />
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,2,0">
                                            <ui:Button x:Name="TogglePasswordBtn" Width="26" Height="26" Appearance="Transparent" Icon="{ui:SymbolIcon Eye24}" ToolTip="Show/Hide Password" Click="TogglePassword_Click" Cursor="Hand" />
                                            <ui:Button Width="26" Height="26" Appearance="Transparent" Icon="{ui:SymbolIcon Copy16}" ToolTip="Copy Password" Click="CopyPassword_Click" Cursor="Hand" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Grid>

                            <!-- Action Buttons -->
                            <WrapPanel Grid.Row="2" VerticalAlignment="Center">
                                <ui:Button Appearance="Secondary"
                                           Content="Auto-Generate"
                                           Icon="{ui:SymbolIcon Sparkle24}"
                                           Click="AutoGeneratePassword_Click"
                                           Padding="8,5"
                                           Margin="0,0,6,0"
                                           Cursor="Hand" />
                                <ui:Button Appearance="Secondary"
                                           Content="Set Custom"
                                           Icon="{ui:SymbolIcon Edit24}"
                                           Click="SetCustomPassword_Click"
                                           Padding="8,5"
                                           Margin="0,0,6,0"
                                           Cursor="Hand" />
                                <ui:Button Appearance="Secondary"
                                           Content="Reset"
                                           Icon="{ui:SymbolIcon ArrowReset24}"
                                           Click="ResetPassword_Click"
                                           Padding="8,5"
                                           Cursor="Hand" />
                            </WrapPanel>

                            <!-- Inline Custom Password Form -->
                            <Border x:Name="CustomPasswordPanel" Grid.Row="3" Background="#0E1620" BorderBrush="#2A475E" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,10,0,0" Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ui:TextBox x:Name="NewCustomPasswordBox" PlaceholderText="Enter new password (at least 8 chars)..." Height="30" VerticalContentAlignment="Center" Background="#162534" BorderBrush="#2A475E" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,6,0" />
                                    <ui:Button Grid.Column="1" Appearance="Primary" Content="Save" Click="SaveCustomPassword_Click" Margin="0,0,4,0" Cursor="Hand" />
                                    <ui:Button Grid.Column="2" Appearance="Secondary" Content="Cancel" Click="CancelCustomPassword_Click" Cursor="Hand" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- CARD 2: PHONE QUICK-CONNECT QR CODE -->
                    <Border Grid.Column="2" Background="#14202D" BorderBrush="#253D52" BorderThickness="1" CornerRadius="8" Padding="14,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- QR Selector Header -->
                            <StackPanel Grid.Row="0">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                                    <ui:Button x:Name="QrModeApkBtn" Content="Stream APK" Appearance="Primary" Padding="10,4" Margin="0,0,4,0" Click="QrModeApk_Click" Cursor="Hand" />
                                    <ui:Button x:Name="QrModePinBtn" Content="Pairing PIN" Appearance="Secondary" Padding="10,4" Click="QrModePin_Click" Cursor="Hand" />
                                </StackPanel>
                            </StackPanel>

                            <!-- QR Code Box -->
                            <Border Grid.Row="1" Background="#FFFFFF" CornerRadius="6" Padding="6" Width="120" Height="120" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Image x:Name="QrCodeImage" Width="108" Height="108" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                            </Border>

                            <!-- QR Caption -->
                            <TextBlock Grid.Row="2" x:Name="QrModeDescription"
                                       Text="Scan with phone camera to download CloudRedirect-Stream.apk directly."
                                       FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0" />
                        </Grid>
                    </Border>
                </Grid>

                <!-- PLATFORM & CLIENT TABS -->
                <TabControl Background="Transparent" BorderThickness="0">
                    
                    <!-- TAB 1: CLOUDREDIRECT STREAM (CUSTOM MOONLIGHT + GAMEHUB) -->
                    <TabItem Header="CloudRedirect Stream (Moonlight + GameHub)">
                        <StackPanel Margin="0,10,0,0">
                            
                            <!-- Hero Banner -->
                            <Border Background="#111B25" BorderBrush="#00D2FF" BorderThickness="1.5" CornerRadius="8" Padding="16,14" Margin="0,0,0,12">
                                <DockPanel LastChildFill="False">
                                    <StackPanel VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Custom Steam Theme &amp; GameHub Touch HUD" FontWeight="Bold" FontSize="14" Foreground="#00D2FF" />
                                            <Border Background="#1C384F" CornerRadius="4" Padding="6,2" Margin="10,0,0,0">
                                                <TextBlock Text="Recommended for Mobile" FontSize="11" Foreground="#66C0F4" FontWeight="SemiBold" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="Packaged with authentic Steam dark UI (#171A21), floating [🎮 STEAM] pill, draggable D-pad, and quick action keys."
                                                   FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <ui:Button DockPanel.Dock="Right"
                                               Appearance="Primary"
                                               Content="Locate / Install APK"
                                               Icon="{ui:SymbolIcon Folder24}"
                                               Click="OpenMobileApk_Click"
                                               Padding="14,7"
                                               VerticalAlignment="Center"
                                               Cursor="Hand" />
                                </DockPanel>
                            </Border>

                            <!-- 4 Visual Step Cards (2x2 Grid) -->
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Step 1 -->
                                <Border Grid.Row="0" Grid.Column="0" Background="#14202D" BorderBrush="#233B4F" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,12">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <Border Width="22" Height="22" Background="#1C384F" CornerRadius="11" Margin="0,0,8,0">
                                                <TextBlock Text="1" FontWeight="Bold" Foreground="#00D2FF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Text="Install on Android Phone" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="Scan the QR code above or transfer CloudRedirect-Stream.apk to your phone to install." FontSize="11.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <!-- Step 2 -->
                                <Border Grid.Row="0" Grid.Column="2" Background="#14202D" BorderBrush="#233B4F" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,12">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <Border Width="22" Height="22" Background="#1C384F" CornerRadius="11" Margin="0,0,8,0">
                                                <TextBlock Text="2" FontWeight="Bold" Foreground="#00D2FF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Text="Automatic Discovery &amp; Pairing" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="Open the app: your PC appears in glowing Steam Cyan. Tap your PC to see the 4-digit PIN, then click 'Enter 4-Digit PIN'." FontSize="11.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <!-- Step 3 -->
                                <Border Grid.Row="1" Grid.Column="0" Background="#14202D" BorderBrush="#233B4F" BorderThickness="1" CornerRadius="8" Padding="14,12">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <Border Width="22" Height="22" Background="#1C384F" CornerRadius="11" Margin="0,0,8,0">
                                                <TextBlock Text="3" FontWeight="Bold" Foreground="#00D2FF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Text="GameHub Floating Touch HUD" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="Tap the floating [🎮 STEAM] pill in-game to toggle Action Keys (E, F, Space, Shift, Ctrl, Tab, Esc) and Quickslots (1-9) with instant tactile touch feedback!" FontSize="11.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <!-- Step 4 -->
                                <Border Grid.Row="1" Grid.Column="2" Background="#14202D" BorderBrush="#233B4F" BorderThickness="1" CornerRadius="8" Padding="14,12">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <Border Width="22" Height="22" Background="#1C384F" CornerRadius="11" Margin="0,0,8,0">
                                                <TextBlock Text="4" FontWeight="Bold" Foreground="#00D2FF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Text="60/120 FPS Ultra Low Latency" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="Stream synced .lua games, Steam library, or desktop at ultra-smooth frame rates with hardware acceleration (NVENC/AMD)." FontSize="11.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </TabItem>

                    <!-- TAB 2: GAMEHUB & STANDARD CLIENTS -->
                    <TabItem Header="Stock Moonlight &amp; GameHub">
                        <StackPanel Margin="0,10,0,0">
                            <Border Background="#14202D" BorderBrush="#253D52" BorderThickness="1" CornerRadius="8" Padding="16,14">
                                <StackPanel>
                                    <TextBlock Text="Connecting via Official Moonlight or GameHub:" FontWeight="Bold" FontSize="14" Foreground="#66C0F4" Margin="0,0,0,12" />

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <Border Width="24" Height="24" Background="#1A2D3E" CornerRadius="12" Margin="0,0,10,0">
                                            <TextBlock Text="1" FontWeight="Bold" Foreground="#66C0F4" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="Download official Moonlight Game Streaming from Google Play Store or use the GameHub emulator." VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <Border Width="24" Height="24" Background="#1A2D3E" CornerRadius="12" Margin="0,0,10,0">
                                            <TextBlock Text="2" FontWeight="Bold" Foreground="#66C0F4" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="Open Moonlight: your PC will appear automatically with a lock icon. Tap it to see a 4-digit PIN." VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <Border Width="24" Height="24" Background="#1A2D3E" CornerRadius="12" Margin="0,0,10,0">
                                            <TextBlock Text="3" FontWeight="Bold" Foreground="#66C0F4" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="Click 'Enter 4-Digit PIN' above to pair." VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <Border Width="24" Height="24" Background="#1A2D3E" CornerRadius="12" Margin="0,0,10,0" VerticalAlignment="Top">
                                            <TextBlock Text="4" FontWeight="Bold" Foreground="#66C0F4" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Select any game or 'Steam Big Picture' to stream." FontWeight="SemiBold" Foreground="#66D18F" />
                                            <TextBlock Text="In Moonlight Settings -> On-Screen Controls, you can drag, drop, and resize default gamepad controls." 
                                                       FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </TabItem>

                    <!-- TAB 3: 5G & REMOTE NETWORKS -->
                    <TabItem Header="Workplace, 5G &amp; Outside Wi-Fi">
                        <StackPanel Margin="0,10,0,0">
                            <!-- Hero Remote Status Card -->
                            <Border Background="#111D2A" BorderBrush="#254359" BorderThickness="1.5" CornerRadius="8" Padding="16,14" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="28" Height="28" Background="#1B3347" CornerRadius="14" Margin="0,0,10,0">
                                                <ui:SymbolIcon Symbol="Globe24" FontSize="16" Foreground="#66D18F" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Text="Remote Streaming IP (Tailscale Mesh VPN)" FontWeight="Bold" FontSize="14" Foreground="#66D18F" />
                                            <Border Background="#163823" BorderBrush="#287340" BorderThickness="1" CornerRadius="12" Padding="8,2" Margin="10,0,0,0">
                                                <TextBlock x:Name="TailscaleStatusBadge" Text="Active &amp; Ready" FontSize="11" FontWeight="SemiBold" Foreground="#66D18F" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="Bypasses home router firewalls, workplace network blocks, and CGNAT automatically with WireGuard encryption."
                                                   FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,10" />
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Background="#091017" BorderBrush="#1C2F40" BorderThickness="1" CornerRadius="6" Padding="10,6">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="PC Remote IP: " Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12.5" />
                                                    <TextBlock x:Name="TabTailscaleIpText" Text="100.120.175.117" FontWeight="Bold" Foreground="#66D18F" FontSize="13" Margin="0,0,10,0" />
                                                    <ui:Button x:Name="TabCopyTailscaleBtn" Content="Copy IP" Appearance="Primary" Padding="8,3" FontSize="11.5" Click="CopyTailscaleIp_Click" Cursor="Hand" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                                        <ui:Button Appearance="Secondary"
                                                   Content="Start / Reconnect"
                                                   Icon="{ui:SymbolIcon Play24}"
                                                   Click="StartTailscale_Click"
                                                   Width="140"
                                                   Cursor="Hand" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Why LAN IP Fails Note -->
                            <Border Background="#1E1911" BorderBrush="#4A3B18" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Warning24" FontSize="16" Foreground="#E5A823" Margin="0,2,10,0" VerticalAlignment="Top" />
                                    <TextBlock Text="Why LAN IP (192.168.x.x) doesn't work from work: Local IPs only exist inside your home router's Wi-Fi. Outside your house, your phone cannot reach 192.168.x.x without Tailscale or port forwarding."
                                               FontSize="11.5" Foreground="#E5C170" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- 3 Step Remote Play Guide -->
                            <Border Background="#14202D" BorderBrush="#253D52" BorderThickness="1" CornerRadius="8" Padding="16,14">
                                <StackPanel>
                                    <TextBlock Text="3 Steps to Play from Workplace or 4G/5G Cellular:" FontWeight="Bold" FontSize="13.5" Foreground="#66C0F4" Margin="0,0,0,10" />

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <Border Width="22" Height="22" Background="#1A2D3E" CornerRadius="11" Margin="0,0,10,0">
                                            <TextBlock Text="1" FontWeight="Bold" Foreground="#66C0F4" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="Open Tailscale on your Android phone and toggle it to Connected (same account as your PC)." VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="12" />
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <Border Width="22" Height="22" Background="#1A2D3E" CornerRadius="11" Margin="0,0,10,0">
                                            <TextBlock Text="2" FontWeight="Bold" Foreground="#66C0F4" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="Open Moonlight (CloudRedirect Stream) on your phone and tap '+' (Add Computer Manually) in the top-right." VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="12" />
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="22" Height="22" Background="#1A2D3E" CornerRadius="11" Margin="0,0,10,0">
                                            <TextBlock Text="3" FontWeight="Bold" Foreground="#66C0F4" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="Type your PC's Remote IP (shown above). Your PC will show online and ready to stream with low latency!" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="12" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </TabItem>

                </TabControl>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer Bar -->
        <Border Grid.Row="2" Background="#101822" BorderBrush="#203244" BorderThickness="0,1,0,0" Padding="24,12">
            <DockPanel LastChildFill="False">
                <ui:Button Appearance="Secondary"
                           Content="Open Sunshine Web Dashboard"
                           Icon="{ui:SymbolIcon Globe24}"
                           Click="OpenDashboard_Click"
                           Cursor="Hand" />
                <ui:Button DockPanel.Dock="Right"
                           Appearance="Primary"
                           Content="Close"
                           Click="Close_Click"
                           Cursor="Hand" />
            </DockPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
