<ui:FluentWindow x:Class="CloudRedirect.Dialogs.MobileStreamingGuideDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="CloudRedirect — Mobile Streaming Guide"
        Width="820" Height="640"
        MinWidth="760" MinHeight="540"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SteamWindowBackgroundGradient}"
        ExtendsContentIntoTitleBar="True">

    <Grid Margin="0,0,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- TitleBar -->
        <ui:TitleBar Grid.Row="0" Title="Mobile Streaming Guide (GameHub &amp; Moonlight)" />

        <!-- Main Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="24,10,24,12">
            <StackPanel>
                
                <!-- Status & Host Info Card -->
                <Border Background="#162534" BorderBrush="#253E54" BorderThickness="1" CornerRadius="6" Padding="16,14" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Tv24" FontSize="20" Foreground="#00D2FF" Margin="0,0,8,0" />
                                <TextBlock Text="Sunshine GameStream Host" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <Border Background="#1A3E26" BorderBrush="#2E7D48" BorderThickness="1" CornerRadius="4" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="SunshineStatusBadge" Text="Active &amp; Running" FontSize="11" FontWeight="SemiBold" Foreground="#66D18F" />
                                </Border>
                            </StackPanel>

                            <TextBlock Text="Streams your .lua and Steam games to mobile with full GameHub drag-and-drop touch buttons." 
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12.5" Margin="0,4,0,10" />

                            <WrapPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Margin="0,0,20,4">
                                    <TextBlock Text="PC Name: " Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" />
                                    <TextBlock x:Name="PcNameText" Text="MY-PC" FontWeight="SemiBold" Foreground="#66C0F4" FontSize="12" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,20,4">
                                    <TextBlock Text="LAN IP: " Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" />
                                    <TextBlock x:Name="LanIpText" Text="192.168.1.100" FontWeight="SemiBold" Foreground="#00D2FF" FontSize="12" />
                                </StackPanel>
                            </WrapPanel>
                        </StackPanel>                        <!-- Quick Action Buttons -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <ui:Button Appearance="Primary"
                                       Content="Enter 4-Digit PIN"
                                       Icon="{ui:SymbolIcon Key24}"
                                       Click="EnterPin_Click"
                                       Margin="0,0,0,6"
                                       Cursor="Hand" />
                            <ui:Button Appearance="Secondary"
                                       Content="Get Stream APK"
                                       Icon="{ui:SymbolIcon Phone24}"
                                       Click="OpenMobileApk_Click"
                                       Margin="0,0,0,6"
                                       Cursor="Hand" />
                            <ui:Button Appearance="Secondary"
                                       Content="Sync Games Now"
                                       Icon="{ui:SymbolIcon ArrowSync24}"
                                       Click="SyncGames_Click"
                                       Cursor="Hand" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Platform Tabs -->
                <TabControl Background="Transparent" BorderThickness="0">
                    
                    <!-- TAB 1: CLOUDREDIRECT STREAM (CUSTOM MOONLIGHT + GAMEHUB) -->
                    <TabItem Header="CloudRedirect Stream (Recommended)">
                        <StackPanel Margin="0,12,0,0">
                            <Border Background="#121C26" BorderBrush="#00D2FF" BorderThickness="1.5" CornerRadius="6" Padding="16">
                                <StackPanel>
                                    <DockPanel LastChildFill="False" Margin="0,0,0,12">
                                        <TextBlock Text="Custom Steam Theme &amp; GameHub Floating Controls" FontWeight="Bold" FontSize="14" Foreground="#00D2FF" VerticalAlignment="Center" />
                                        <ui:Button DockPanel.Dock="Right"
                                                   Appearance="Primary"
                                                   Content="Open / Locate APK"
                                                   Icon="{ui:SymbolIcon Folder24}"
                                                   Click="OpenMobileApk_Click"
                                                   Cursor="Hand" />
                                    </DockPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <Border Width="24" Height="24" Background="#1C384F" CornerRadius="12" Margin="0,0,10,0">
                                            <TextBlock Text="1" FontWeight="Bold" Foreground="#00D2FF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Install CloudRedirect-Stream.apk on your Android phone." FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                            <TextBlock Text="Packaged with authentic Steam dark theme (#171A21) and custom touch controls." FontSize="11.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <Border Width="24" Height="24" Background="#1C384F" CornerRadius="12" Margin="0,0,10,0">
                                            <TextBlock Text="2" FontWeight="Bold" Foreground="#00D2FF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="Open the app: your PC appears automatically in glowing Steam Cyan. Tap it to see your 4-digit pairing PIN." VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <Border Width="24" Height="24" Background="#1C384F" CornerRadius="12" Margin="0,0,10,0">
                                            <TextBlock Text="3" FontWeight="Bold" Foreground="#00D2FF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="Click 'Enter 4-Digit PIN' above and submit the PIN. Your phone pairs permanently." VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <Border Width="24" Height="24" Background="#1C384F" CornerRadius="12" Margin="0,0,10,0" VerticalAlignment="Top">
                                            <TextBlock Text="4" FontWeight="Bold" Foreground="#00D2FF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Tap any synced .lua or Steam game to stream with built-in GameHub HUD!" FontWeight="SemiBold" Foreground="#66D18F" />
                                            <TextBlock Text="Tap the floating [🎮 STEAM] pill anytime to toggle Action Keys (E, F, Space, Shift, Ctrl, Tab, Esc) and Quickslot numbers (1-9) with instant tactile touch feedback!" 
                                                       FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </TabItem>

                    <!-- TAB 2: GAMEHUB & STANDARD CLIENTS -->
                    <TabItem Header="GameHub &amp; Moonlight">
                        <StackPanel Margin="0,12,0,0">
                            <Border Background="#121C26" BorderBrush="#1F3244" BorderThickness="1" CornerRadius="6" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="How to Connect via Standard Moonlight or GameHub:" FontWeight="Bold" FontSize="14" Foreground="#66C0F4" Margin="0,0,0,12" />

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <Border Width="24" Height="24" Background="#1A2D3E" CornerRadius="12" Margin="0,0,10,0">
                                            <TextBlock Text="1" FontWeight="Bold" Foreground="#66C0F4" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="Download official Moonlight Game Streaming from Google Play Store or use GameHub emulator." VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <Border Width="24" Height="24" Background="#1A2D3E" CornerRadius="12" Margin="0,0,10,0">
                                            <TextBlock Text="2" FontWeight="Bold" Foreground="#66C0F4" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="Open Moonlight: your PC will appear automatically with a lock icon. Tap it to see a 4-digit PIN." VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <Border Width="24" Height="24" Background="#1A2D3E" CornerRadius="12" Margin="0,0,10,0">
                                            <TextBlock Text="3" FontWeight="Bold" Foreground="#66C0F4" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="Click 'Enter 4-Digit PIN' above to pair." VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <Border Width="24" Height="24" Background="#1A2D3E" CornerRadius="12" Margin="0,0,10,0" VerticalAlignment="Top">
                                            <TextBlock Text="4" FontWeight="Bold" Foreground="#66C0F4" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Select any game or 'Steam Big Picture' to stream." FontWeight="SemiBold" Foreground="#66D18F" />
                                            <TextBlock Text="In Moonlight Settings -> On-Screen Controls, you can drag, drop, and resize default gamepad controls." 
                                                       FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </TabItem>

                    <!-- TAB 3: 5G & REMOTE NETWORKS -->
                    <TabItem Header="5G &amp; Outside Wi-Fi (WAN)">
                        <StackPanel Margin="0,12,0,0">
                            <Border Background="#121C26" BorderBrush="#1F3244" BorderThickness="1" CornerRadius="6" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="Playing Across Different Networks:" FontWeight="Bold" FontSize="14" Foreground="#E5A823" Margin="0,0,0,12" />

                                    <TextBlock Text="• UPnP Automatic Port Forwarding:" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Text="Sunshine has UPnP enabled by default. If your home router supports UPnP, ports are forwarded automatically so you can connect directly over 4G/5G."
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="12,2,0,10" />

                                    <TextBlock Text="• Connecting over 5G:" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Text="Once paired while at home, your phone remembers the PC. When outside, simply open GameHub or Moonlight and tap your PC to connect."
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="12,2,0,10" />

                                    <TextBlock Text="• CGNAT / Strict Networks (Tailscale):" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Text="If your cellular provider blocks direct connections, install Tailscale on PC and phone. Enter your 100.x.y.z Tailscale IP into Moonlight to bypass all firewalls."
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="12,2,0,4" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </TabItem>

                </TabControl>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer Buttons -->
        <Border Grid.Row="2" Background="#141E28" BorderBrush="#253548" BorderThickness="0,1,0,0" Padding="24,12">
            <DockPanel LastChildFill="False">
                <ui:Button Appearance="Secondary"
                           Content="Open Sunshine Web Dashboard"
                           Icon="{ui:SymbolIcon Globe24}"
                           Click="OpenDashboard_Click"
                           Cursor="Hand" />
                <ui:Button DockPanel.Dock="Right"
                           Appearance="Primary"
                           Content="Close"
                           Click="Close_Click"
                           Cursor="Hand" />
            </DockPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
