<ui:FluentWindow x:Class="CloudRedirect.Dialogs.CloudFolderBrowserDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:res="clr-namespace:CloudRedirect.Resources"
        Title="{res:Loc CloudExplorer_Title}"
        Width="780" Height="530"
        MinWidth="580" MinHeight="400"
        MaxWidth="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Width}"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SteamWindowBackgroundGradient}"
        ExtendsContentIntoTitleBar="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="AppTitleBar" Grid.Row="0" Title="{res:Loc CloudExplorer_Title}" />

        <Grid Grid.Row="1" Margin="24,12,24,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header and Toolbar -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="FolderPathBreadcrumb"
                               Text="{res:Loc CloudExplorer_Breadcrumb_Drive}"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="#66C0F4" Margin="0,0,0,3" />
                    <TextBlock x:Name="GameTitleText"
                               Text="Cloud Save Files"
                               FontSize="18" FontWeight="Bold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock x:Name="FolderSummaryText"
                               Text="{res:Loc CloudExplorer_LoadingFiles}"
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Margin="0,3,0,0" />
                </StackPanel>

                <!-- Actions -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button x:Name="RefreshBtn"
                               Content="{res:Loc CloudExplorer_BtnRefresh}"
                               Icon="{ui:SymbolIcon ArrowClockwise24}"
                               Appearance="Secondary"
                               Click="Refresh_Click"
                               Margin="0,0,8,0" />
                    <ui:Button x:Name="OpenLocalBtn"
                               Content="{res:Loc CloudExplorer_BtnLocalFolder}"
                               Icon="{ui:SymbolIcon FolderOpen24}"
                               Appearance="Secondary"
                               Click="OpenLocal_Click"
                               Margin="0,0,8,0" />
                    <ui:Button x:Name="OpenWebBtn"
                               Content="{res:Loc CloudExplorer_BtnOpenBrowser}"
                               Icon="{ui:SymbolIcon Globe24}"
                               Appearance="Secondary"
                               Click="OpenWeb_Click" />
                </StackPanel>
            </Grid>

            <!-- Content Area -->
            <Grid Grid.Row="1">
                <!-- Loading State -->
                <StackPanel x:Name="LoadingPanel"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="Visible">
                    <ui:ProgressRing IsIndeterminate="True" Width="44" Height="44" Margin="0,0,0,12" />
                    <TextBlock Text="{res:Loc CloudExplorer_Loading}"
                               FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Center" />
                </StackPanel>

                <!-- Error State -->
                <Border x:Name="ErrorPanel"
                        Visibility="Collapsed"
                        Background="#201416"
                        BorderBrush="#4D1F24"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="28,20"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MaxWidth="520">
                    <StackPanel HorizontalAlignment="Center">
                        <ui:SymbolIcon Symbol="Warning24" FontSize="36" Foreground="#FF6B6B" HorizontalAlignment="Center" />
                        <TextBlock x:Name="ErrorTitleText"
                                   Text="{res:Loc CloudExplorer_ErrorTitle}"
                                   FontWeight="SemiBold" FontSize="15"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   HorizontalAlignment="Center" Margin="0,10,0,4" />
                        <TextBlock x:Name="ErrorMessageText"
                                   Text="{res:Loc CloudExplorer_ErrorDesc}"
                                   FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" TextAlignment="Center" />
                        <ui:Button Content="{res:Loc CloudExplorer_Retry}"
                                   Appearance="Primary"
                                   Icon="{ui:SymbolIcon ArrowClockwise24}"
                                   Click="Refresh_Click"
                                   HorizontalAlignment="Center"
                                   Margin="0,14,0,0" />
                    </StackPanel>
                </Border>

                <!-- Empty State -->
                <Border x:Name="EmptyStateBorder"
                        Visibility="Collapsed"
                        Background="#141E28"
                        BorderBrush="#253548"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="32,24"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MaxWidth="520">
                    <StackPanel HorizontalAlignment="Center">
                        <ui:SymbolIcon Symbol="Cloud24" FontSize="36" Foreground="#445870" HorizontalAlignment="Center" />
                        <TextBlock Text="{res:Loc CloudExplorer_NoFilesTitle}"
                                   FontWeight="SemiBold" FontSize="14"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   HorizontalAlignment="Center" Margin="0,10,0,4" />
                        <TextBlock Text="{res:Loc CloudExplorer_NoFilesDesc}"
                                   FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" TextAlignment="Center" MaxWidth="440" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                            <ui:Button Content="{res:Loc CloudExplorer_BtnLocalFolder}"
                                       Appearance="Primary"
                                       Icon="{ui:SymbolIcon FolderOpen24}"
                                       Click="OpenLocal_Click"
                                       Margin="0,0,8,0" />
                            <ui:Button Content="{res:Loc CloudExplorer_BtnRefresh}"
                                       Appearance="Secondary"
                                       Icon="{ui:SymbolIcon ArrowClockwise24}"
                                       Click="Refresh_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Files List -->
                <ListBox x:Name="FilesListBox"
                         Visibility="Collapsed"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,0,6" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#16222F"
                                    BorderBrush="#2A3D52"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="14,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Icon -->
                                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18"
                                            Background="#1C2D3E" Margin="0,0,12,0" VerticalAlignment="Center">
                                        <ui:SymbolIcon Symbol="{Binding IconSymbol}" FontSize="18" Foreground="#66C0F4"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>

                                    <!-- Info -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}"
                                                   FontWeight="SemiBold" FontSize="13"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                            <TextBlock Text="{Binding FormattedSize}"
                                                       FontSize="11" Foreground="#A4D007" FontWeight="SemiBold"
                                                       Margin="0,0,12,0" />
                                            <TextBlock Text="Cloud Modified: "
                                                       FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{Binding FormattedTime}"
                                                       FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Actions -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:Button Appearance="Secondary"
                                                   Click="DownloadFile_Click"
                                                   Tag="{Binding}"
                                                   Padding="12,5">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="14" Margin="0,0,6,0" />
                                                <TextBlock Text="{res:Loc CloudExplorer_BtnDownload}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </ui:Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Grid>

        <!-- Bottom Bar -->
        <Border Grid.Row="2" Background="#141E28" BorderBrush="#253548" BorderThickness="0,1,0,0" Padding="20,12">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                    <ui:SymbolIcon Symbol="CloudCheckmark24" FontSize="16" Foreground="#A4D007" Margin="0,0,6,0" />
                    <TextBlock x:Name="StatusFooterText" Text="{res:Loc CloudExplorer_StatusFooter}" FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <ui:Button Content="{res:Loc CloudExplorer_BtnClose}"
                           Appearance="Secondary"
                           Click="Close_Click"
                           DockPanel.Dock="Right"
                           Padding="24,6" />
            </DockPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
