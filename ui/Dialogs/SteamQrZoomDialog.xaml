<Window x:Class="CloudRedirect.Dialogs.SteamQrZoomDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:res="clr-namespace:CloudRedirect.Resources"
        Title="Scan QR Code"
        Width="440" SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        KeyDown="Window_KeyDown">

    <Border Margin="14"
            Background="#171A21"
            BorderBrush="#2A475E"
            BorderThickness="1"
            CornerRadius="8"
            ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="28" ShadowDepth="4" Opacity="0.85" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Header -->
                <RowDefinition Height="*" />    <!-- Content -->
                <RowDefinition Height="Auto" /> <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- 1. Header Bar -->
            <Border Grid.Row="0"
                    Background="#1B2838"
                    BorderBrush="#253A4E"
                    BorderThickness="0,0,0,1"
                    Padding="14,10"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="QrCode24" FontSize="18" Foreground="#66C0F4" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="{res:Loc QrDialog_Title}"
                                   FontSize="12.5"
                                   FontWeight="Bold"
                                   Foreground="#66C0F4"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Close X Button -->
                    <Button HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Width="26" Height="26"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="#8F98A0"
                            Cursor="Hand"
                            Click="CloseButton_Click"
                            ToolTip="Close">
                        <TextBlock Text="✕" FontSize="12" FontWeight="Bold" />
                    </Button>
                </Grid>
            </Border>

            <!-- 2. Content -->
            <StackPanel Grid.Row="1" Margin="22,18,22,12" HorizontalAlignment="Center">
                <!-- Large High-Res QR Code Card -->
                <Border Background="White"
                        CornerRadius="8"
                        Padding="10"
                        Width="300" Height="300"
                        BorderBrush="#3877A8"
                        BorderThickness="2"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,14">
                    <Border.Effect>
                        <DropShadowEffect Color="#66C0F4" BlurRadius="12" ShadowDepth="0" Opacity="0.3" />
                    </Border.Effect>
                    <Image x:Name="QrCodeImage"
                           Width="280" Height="280"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="NearestNeighbor" />
                </Border>

                <!-- Instructions & Mode Badge -->
                <StackPanel HorizontalAlignment="Center" Margin="0,0,0,10">
                    <Border x:Name="ModeBadgeBorder"
                            Background="#16293A" BorderBrush="#254F70" BorderThickness="1"
                            CornerRadius="4" Padding="10,3" HorizontalAlignment="Center" Margin="0,0,0,8">
                        <TextBlock x:Name="ModeBadgeText"
                                   Text="Direct Google Auth Link"
                                   FontSize="11" FontWeight="SemiBold" Foreground="#66C0F4" />
                    </Border>
                    <TextBlock Text="{res:Loc QrDialog_Instructions}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               FontSize="12"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               MaxWidth="360" />
                </StackPanel>

                <!-- Status indicator -->
                <Border Background="#101822" BorderBrush="#253548" BorderThickness="1"
                        CornerRadius="6" Padding="12,8" MaxWidth="360" HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <ui:ProgressRing x:Name="DialogSpinner" IsIndeterminate="True" Width="14" Height="14" Margin="0,0,8,0" />
                        <ui:SymbolIcon x:Name="DialogStatusIcon" Symbol="CheckmarkCircle24" FontSize="15" Foreground="#A4D007" Margin="0,0,8,0" Visibility="Collapsed" />
                        <TextBlock x:Name="DialogStatusText"
                                   Text="{res:Loc Wizard_Step2_WaitingPhone}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   FontSize="12"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 3. Footer Bar -->
            <Border Grid.Row="2"
                    Background="#141E28"
                    BorderBrush="#253548"
                    BorderThickness="0,1,0,0"
                    Padding="14,10">
                <Grid>
                    <Button x:Name="CopyLinkBtn"
                            Content="{res:Loc QrDialog_CopyLink}"
                            Style="{StaticResource SteamSecondaryButtonStyle}"
                            HorizontalAlignment="Left"
                            Padding="16,6"
                            FontSize="12"
                            Click="CopyLink_Click" />

                    <Button Content="{res:Loc QrDialog_Close}"
                            Style="{StaticResource SteamSecondaryButtonStyle}"
                            HorizontalAlignment="Right"
                            Padding="22,6"
                            FontSize="12"
                            Click="CloseButton_Click" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
