<ui:FluentWindow x:Class="CloudRedirect.Dialogs.InteractiveGuideDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:res="clr-namespace:CloudRedirect.Resources"
        Title="CloudRedirect — Interactive Feature Guide"
        Width="910" Height="620"
        MinWidth="640" MinHeight="460"
        MaxWidth="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Width}"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SteamWindowBackgroundGradient}"
        ExtendsContentIntoTitleBar="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- TitleBar with Language Selector -->
        <DockPanel Grid.Row="0">
            <ui:TitleBar x:Name="AppTitleBar" Title="Interactive Feature Guide" />
        </DockPanel>

        <!-- Main Content Area -->
        <Grid Grid.Row="1" Margin="24,12,24,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="285" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left: Feature Navigation Sidebar -->
            <Border Grid.Column="0"
                    Background="#141E28"
                    BorderBrush="#253548"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="6,8">
                <DockPanel LastChildFill="True">
                    <!-- Language Selector Bar -->
                    <Border DockPanel.Dock="Top"
                            Background="#182533"
                            BorderBrush="#293D54"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="8,2,6,2"
                            Margin="4,2,4,12"
                            MinHeight="36">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Symbol="Globe24" FontSize="16" Foreground="#66C0F4" VerticalAlignment="Center" Margin="2,0,8,0" />
                            <ComboBox x:Name="GuideLanguageComboBox"
                                      Grid.Column="1"
                                      Height="32"
                                      MinHeight="32"
                                      FontSize="12.5"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      Padding="4,2,24,2"
                                      VerticalAlignment="Center"
                                      VerticalContentAlignment="Center"
                                      MaxDropDownHeight="320"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                      SelectionChanged="GuideLanguageComboBox_SelectionChanged" />
                        </Grid>
                    </Border>

                    <!-- Feature Navigation List -->
                    <ListBox x:Name="FeatureTabsListBox"
                             Background="Transparent"
                             BorderThickness="0"
                             SelectionChanged="FeatureTabsListBox_SelectionChanged">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Margin" Value="0,2" />
                                <Setter Property="Padding" Value="10,8" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="border"
                                                    Background="Transparent"
                                                    BorderBrush="Transparent"
                                                    BorderThickness="1"
                                                    CornerRadius="4">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#1F2F40" />
                                                    <Setter TargetName="border" Property="BorderBrush" Value="#385472" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#1C354A" />
                                                    <Setter TargetName="border" Property="BorderBrush" Value="#66C0F4" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="{Binding Symbol}" FontSize="18" Foreground="{Binding IconColor}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12.5" Foreground="#E1E6EB" />
                                        <TextBlock Text="{Binding Subtitle}" FontSize="10.5" Foreground="#8F98A0" Margin="0,1,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Right: Feature Detailed Walkthrough Card -->
            <Border Grid.Column="2"
                    Background="#14212D"
                    BorderBrush="#253E54"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="22,18">
                <DockPanel LastChildFill="True">
                    <!-- Feature Header -->
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,6">
                            <Border x:Name="FeatureBadgeBorder"
                                    Background="#1A344A"
                                    BorderBrush="#2A5173"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="8,3"
                                    Margin="0,0,10,0"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="FeatureBadgeText"
                                           Text="FEATURE"
                                           FontSize="10.5" FontWeight="Bold"
                                           Foreground="#66C0F4" />
                            </Border>
                            <TextBlock x:Name="FeatureHeaderTitle"
                                       Text="Universal Cloud Saves (Safe Mode)"
                                       FontSize="18" FontWeight="Bold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock x:Name="FeatureDescriptionText"
                                   Text="Description of the feature..."
                                   FontSize="12.5"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" LineHeight="18" />
                    </StackPanel>

                    <!-- Bottom Action Controls -->
                    <DockPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                            <ui:Button x:Name="PrevBtn"
                                       Content="Previous"
                                       Appearance="Secondary"
                                       Click="PrevBtn_Click"
                                       Margin="0,0,8,0"
                                       Padding="12,6" />
                            <ui:Button x:Name="NextBtn"
                                       Content="Next Step"
                                       Appearance="Secondary"
                                       Click="NextBtn_Click"
                                       Padding="12,6" />
                        </StackPanel>
                        <ui:Button x:Name="JumpToFeatureBtn"
                                   Content="Jump to Feature 🚀"
                                   Appearance="Primary"
                                   Click="JumpToFeature_Click"
                                   DockPanel.Dock="Right"
                                   HorizontalAlignment="Right"
                                   FontWeight="SemiBold"
                                   Padding="16,6" />
                    </DockPanel>

                    <!-- Scrollable Details & Under-The-Hood Explanations -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Highlights List -->
                            <TextBlock x:Name="KeyHighlightsTitle"
                                       Text="Key Highlights:"
                                       FontWeight="SemiBold" FontSize="13"
                                       Foreground="#66C0F4"
                                       Margin="0,0,0,8" />

                            <StackPanel x:Name="HighlightsPanel" Margin="0,0,0,14" />

                            <!-- Under The Hood Box -->
                            <Border Background="#0F1822"
                                    BorderBrush="#1D2D3E"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    Padding="14,10"
                                    Margin="0,0,0,12">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <ui:SymbolIcon Symbol="Wrench24" FontSize="14" Foreground="#A4D007" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock x:Name="HowItWorksHeader"
                                                   Text="How It Works Behind The Scenes"
                                                   FontWeight="SemiBold" FontSize="12"
                                                   Foreground="#A4D007" />
                                    </StackPanel>
                                    <TextBlock x:Name="HowItWorksBody"
                                               Text="Detailed explanation..."
                                               FontSize="11.5" Foreground="#8F98A0"
                                               TextWrapping="Wrap" LineHeight="17" />
                                </StackPanel>
                            </Border>

                            <!-- Pro Tip Box -->
                            <Border Background="#1A2D22"
                                    BorderBrush="#2F5C20"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    Padding="14,10">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <ui:SymbolIcon Symbol="Lightbulb24" FontSize="14" Foreground="#FFE600" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock x:Name="ProTipHeader"
                                                   Text="Pro Tip"
                                                   FontWeight="SemiBold" FontSize="12"
                                                   Foreground="#FFE600" />
                                    </StackPanel>
                                    <TextBlock x:Name="ProTipBody"
                                               Text="Pro tip advice..."
                                               FontSize="11.5" Foreground="#C6D4DF"
                                               TextWrapping="Wrap" LineHeight="17" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Bottom Dialog Bar -->
        <Border Grid.Row="2" Background="#141E28" BorderBrush="#253548" BorderThickness="0,1,0,0" Padding="20,10">
            <DockPanel>
                <TextBlock x:Name="GuideFooterText"
                           Text="CloudRedirect: Authentic Steam Cloud Redirection &amp; Universal Safe Mode Save Protection"
                           FontSize="11" Foreground="#55697E" VerticalAlignment="Center" />
                <ui:Button x:Name="CloseGuideBtn"
                           Content="Close Guide"
                           Appearance="Secondary"
                           Click="Close_Click"
                           DockPanel.Dock="Right"
                           HorizontalAlignment="Right"
                           Padding="14,5" />
            </DockPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
