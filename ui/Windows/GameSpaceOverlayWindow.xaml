<Window x:Class="CloudRedirect.Windows.GameSpaceOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="CloudRedirect Game Space"
        Width="380"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <Style x:Key="SteamButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#22364B" />
            <Setter Property="Foreground" Value="#C6D4DF" />
            <Setter Property="BorderBrush" Value="#325272" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#2F4C69" />
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="#4C78A4" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#172738" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SteamPlayButtonStyle" TargetType="Button" BasedOn="{StaticResource SteamButtonStyle}">
            <Setter Property="Background" Value="#4C7815" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#70A820" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="playBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="playBorder" Property="Background" Value="#5C9318" />
                                <Setter TargetName="playBorder" Property="BorderBrush" Value="#86C825" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="playBorder" Property="Background" Value="#3D6310" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SteamActiveTabButtonStyle" TargetType="Button" BasedOn="{StaticResource SteamButtonStyle}">
            <Setter Property="Background" Value="#2A475E" />
            <Setter Property="BorderBrush" Value="#66C0F4" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>
    </Window.Resources>

    <Grid x:Name="RootLayout" ClipToBounds="True">
        <!-- Main Drawer Container with slide transform -->
        <Border x:Name="DrawerBorder"
                HorizontalAlignment="Right"
                Width="380"
                Background="#F2131C26"
                BorderBrush="#FF2A475E"
                BorderThickness="1,0,0,0"
                CornerRadius="14,0,0,14">
            <Border.RenderTransform>
                <TranslateTransform x:Name="DrawerTransform" X="0" />
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="28" ShadowDepth="0" Opacity="0.75" Direction="180" />
            </Border.Effect>

            <Grid Margin="18,16,18,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /> <!-- Header -->
                    <RowDefinition Height="*" />    <!-- Scrollable Content -->
                    <RowDefinition Height="Auto" /> <!-- Footer -->
                </Grid.RowDefinitions>

                <!-- 1. Header with Title & Hotkey Badge -->
                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#1C354A" CornerRadius="6" Padding="6,4" Margin="0,0,8,0">
                            <ui:SymbolIcon Symbol="Games24" FontSize="18" Foreground="#66C0F4" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="GAME SPACE" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" />
                                <Border Background="#1B3322" BorderBrush="#3D6D24" BorderThickness="1"
                                        CornerRadius="10" Padding="6,1" Margin="8,0,0,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="6" Height="6" Fill="#A4D007" Margin="0,0,4,0" />
                                        <TextBlock Text="LIVE" FontSize="9" FontWeight="Bold" Foreground="#A4D007" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="CloudRedirect In-Game Companion" FontSize="10" Foreground="#8F98A0" Margin="0,1,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Hotkey Hint Badge -->
                        <Border Background="#1A2735" BorderBrush="#263E56" BorderThickness="1"
                                CornerRadius="5" Padding="7,3" Margin="0,0,8,0" VerticalAlignment="Center">
                            <TextBlock Text="Ctrl + Space" FontSize="10" FontWeight="SemiBold" Foreground="#66C0F4" />
                        </Border>

                        <!-- Close Button -->
                        <Button Click="Close_Click" Width="28" Height="28" Padding="0"
                                Background="Transparent" BorderThickness="0" Foreground="#8F98A0" Cursor="Hand">
                            <ui:SymbolIcon Symbol="Dismiss24" FontSize="14" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- 2. Scrollable Body -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
                    <StackPanel>

                        <!-- Active Game Card with Force Kill option -->
                        <Border x:Name="ActiveGameCard"
                                Background="#1A2938"
                                BorderBrush="#2C4863"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12"
                                Margin="0,0,0,14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Game Poster Capsule -->
                                    <Border Grid.Column="0"
                                            Width="88" Height="44"
                                            CornerRadius="4"
                                            Background="#101922"
                                            BorderBrush="#253A4E"
                                            BorderThickness="1"
                                            ClipToBounds="True"
                                            Margin="0,0,10,0"
                                            VerticalAlignment="Center">
                                        <Grid>
                                            <ui:SymbolIcon x:Name="GamePosterFallback" Symbol="Games24" FontSize="20" Foreground="#66C0F4"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <Image x:Name="GamePosterImage" Stretch="UniformToFill" />
                                        </Grid>
                                    </Border>

                                    <!-- Game Info Details -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:Name="GameTitleText"
                                                   Text="Standby Mode"
                                                   FontSize="13"
                                                   FontWeight="Bold"
                                                   Foreground="#FFFFFF"
                                                   TextTrimming="CharacterEllipsis" />
                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="GameTimerText"
                                                       Text="⏱️ No Active Game"
                                                       FontSize="11"
                                                       Foreground="#8F98A0" />
                                            <TextBlock x:Name="BoostActiveBadge"
                                                       Text="🚀 Boosted"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"
                                                       Foreground="#00D2FF"
                                                       Margin="8,0,0,0"
                                                       Visibility="Collapsed" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>

                                <!-- Emergency Force Kill Game Button (visible when a game is running) -->
                                <Border Grid.Row="1" x:Name="ForceKillContainer" Margin="0,10,0,0" Visibility="Collapsed">
                                    <Button x:Name="ForceKillBtn" Click="ForceKill_Click"
                                            Style="{StaticResource SteamButtonStyle}"
                                            Background="#2B1619" BorderBrush="#5C252B" Foreground="#FF6B72"
                                            HorizontalAlignment="Stretch" Padding="8,5">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <ui:SymbolIcon Symbol="DismissSquare24" FontSize="13" Foreground="#FF6B72" Margin="0,0,6,0" />
                                            <TextBlock x:Name="ForceKillBtnText" Text="⚠️ Force Kill Frozen Game" FontSize="11" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Button>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- System & Performance Telemetry Card with Auto-Fit 3-Column Grid -->
                        <Border Background="#16222F" BorderBrush="#24394E" BorderThickness="1"
                                CornerRadius="8" Padding="12" Margin="0,0,0,14">
                            <StackPanel>
                                <DockPanel LastChildFill="False" Margin="0,0,0,10">
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                        <ui:SymbolIcon Symbol="Flash24" FontSize="14" Foreground="#A4D007" Margin="0,0,6,0" />
                                        <TextBlock Text="SYSTEM &amp; PERFORMANCE" FontSize="11" FontWeight="Bold" Foreground="#66C0F4" />
                                    </StackPanel>
                                    <TextBlock x:Name="PowerPlanText" DockPanel.Dock="Right"
                                               Text="High Perf" FontSize="10" Foreground="#8F98A0" VerticalAlignment="Center" />
                                </DockPanel>

                                <!-- 3-Column Telemetry Tiles: CPU | GPU | RAM (with Viewbox Auto-Fit) -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Column 0: CPU Tile -->
                                    <Border Grid.Column="0" Background="#101922" BorderBrush="#213447" BorderThickness="1" CornerRadius="6" Padding="6,6">
                                        <StackPanel HorizontalAlignment="Stretch">
                                            <TextBlock Text="CPU" FontSize="10" FontWeight="Bold" Foreground="#8F98A0" HorizontalAlignment="Center" />
                                            <!-- Auto-fit Load Percentage (e.g. 38%) -->
                                            <Viewbox Stretch="Uniform" StretchDirection="DownOnly" MaxHeight="24" Margin="0,2,0,2">
                                                <TextBlock x:Name="CpuPercentText" Text="38%" FontSize="18" FontWeight="Bold" Foreground="#66C0F4" HorizontalAlignment="Center" TextWrapping="NoWrap" />
                                            </Viewbox>
                                            <!-- Auto-fit Temperature (e.g. 🌡️ 62°C) -->
                                            <Viewbox Stretch="Uniform" StretchDirection="DownOnly" MaxHeight="16">
                                                <TextBlock x:Name="CpuTempText" Text="🌡️ 62°C" FontSize="11" FontWeight="SemiBold" Foreground="#A4D007" HorizontalAlignment="Center" TextWrapping="NoWrap" />
                                            </Viewbox>
                                        </StackPanel>
                                    </Border>

                                    <!-- Column 2: GPU Tile -->
                                    <Border Grid.Column="2" Background="#101922" BorderBrush="#213447" BorderThickness="1" CornerRadius="6" Padding="6,6">
                                        <StackPanel HorizontalAlignment="Stretch">
                                            <TextBlock Text="GPU" FontSize="10" FontWeight="Bold" Foreground="#8F98A0" HorizontalAlignment="Center" />
                                            <!-- Auto-fit Load Percentage (e.g. 92%) -->
                                            <Viewbox Stretch="Uniform" StretchDirection="DownOnly" MaxHeight="24" Margin="0,2,0,2">
                                                <TextBlock x:Name="GpuPercentText" Text="92%" FontSize="18" FontWeight="Bold" Foreground="#66C0F4" HorizontalAlignment="Center" TextWrapping="NoWrap" />
                                            </Viewbox>
                                            <!-- Auto-fit Temperature (e.g. 🌡️ 68°C) -->
                                            <Viewbox Stretch="Uniform" StretchDirection="DownOnly" MaxHeight="16">
                                                <TextBlock x:Name="GpuTempText" Text="🌡️ 68°C" FontSize="11" FontWeight="SemiBold" Foreground="#A4D007" HorizontalAlignment="Center" TextWrapping="NoWrap" />
                                            </Viewbox>
                                        </StackPanel>
                                    </Border>

                                    <!-- Column 4: RAM Tile -->
                                    <Border Grid.Column="4" Background="#101922" BorderBrush="#213447" BorderThickness="1" CornerRadius="6" Padding="6,6">
                                        <StackPanel HorizontalAlignment="Stretch">
                                            <TextBlock Text="RAM" FontSize="10" FontWeight="Bold" Foreground="#8F98A0" HorizontalAlignment="Center" />
                                            <!-- Auto-fit Load Percentage (e.g. 44%) -->
                                            <Viewbox Stretch="Uniform" StretchDirection="DownOnly" MaxHeight="24" Margin="0,2,0,2">
                                                <TextBlock x:Name="RamPercentValueText" Text="44%" FontSize="18" FontWeight="Bold" Foreground="#66C0F4" HorizontalAlignment="Center" TextWrapping="NoWrap" />
                                            </Viewbox>
                                            <!-- Auto-fit Usage Detail (e.g. 14.1 / 32 GB) -->
                                            <Viewbox Stretch="Uniform" StretchDirection="DownOnly" MaxHeight="16">
                                                <TextBlock x:Name="RamUsageDetailedText" Text="14.1 / 32 GB" FontSize="11" FontWeight="SemiBold" Foreground="#C6D4DF" HorizontalAlignment="Center" TextWrapping="NoWrap" />
                                            </Viewbox>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- RAM Progress Bar -->
                                <Grid Margin="0,0,0,8">
                                    <ProgressBar x:Name="RamProgressBar" Height="8" Minimum="0" Maximum="100" Value="44"
                                                 Foreground="#66C0F4" Background="#0F1720" BorderThickness="0" />
                                </Grid>

                                <!-- Action Buttons: Purge RAM & Freeze Background Apps -->
                                <Grid Margin="0,2,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Purge RAM Button -->
                                    <Button Grid.Column="0" x:Name="PurgeRamBtn" Click="PurgeRam_Click"
                                            Style="{StaticResource SteamPlayButtonStyle}"
                                            HorizontalAlignment="Stretch" Padding="6,6">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="Broom24" FontSize="13" Margin="0,0,4,0" />
                                            <TextBlock Text="⚡ Purge RAM" FontSize="11" />
                                        </StackPanel>
                                    </Button>

                                    <!-- Freeze BG Apps Toggle Button -->
                                    <Button Grid.Column="2" x:Name="FreezeBgAppsBtn" Click="FreezeBgApps_Click"
                                            Style="{StaticResource SteamButtonStyle}"
                                            HorizontalAlignment="Stretch" Padding="6,6">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:SymbolIcon x:Name="FreezeIcon" Symbol="WeatherSnowflake24" FontSize="13" Foreground="#66C0F4" Margin="0,0,4,0" />
                                            <TextBlock x:Name="FreezeBtnText" Text="🧊 Freeze Apps" FontSize="11" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <!-- Reclaim Feedback Pill -->
                                <Border x:Name="RamReclaimedPill" Visibility="Collapsed"
                                        Background="#1F3624" BorderBrush="#3D6D24" BorderThickness="1"
                                        CornerRadius="5" Padding="8,4" Margin="0,8,0,0">
                                    <TextBlock x:Name="RamReclaimedText" Text="✓ Reclaimed +1.2 GB Memory"
                                               FontSize="11" FontWeight="SemiBold" Foreground="#A4D007" HorizontalAlignment="Center" />
                                </Border>

                                <!-- Freeze Feedback Pill -->
                                <Border x:Name="FreezeFeedbackPill" Visibility="Collapsed"
                                        Background="#152738" BorderBrush="#254A6B" BorderThickness="1"
                                        CornerRadius="5" Padding="8,4" Margin="0,8,0,0">
                                    <TextBlock x:Name="FreezeFeedbackText" Text="✓ Frozen 6 background apps"
                                               FontSize="11" FontWeight="SemiBold" Foreground="#66C0F4" HorizontalAlignment="Center" />
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- In-Game Save Checkpoints Section -->
                        <Border Background="#16222F" BorderBrush="#24394E" BorderThickness="1"
                                CornerRadius="8" Padding="12" Margin="0,0,0,14">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="Camera24" FontSize="14" Foreground="#66C0F4" Margin="0,0,6,0" />
                                    <TextBlock Text="IN-GAME SAVE CHECKPOINTS" FontSize="11" FontWeight="Bold" Foreground="#66C0F4" />
                                </StackPanel>
                                <TextBlock Text="Create a named restore point right now without alt-tabbing:"
                                           FontSize="10" Foreground="#8F98A0" Margin="0,0,0,8" TextWrapping="Wrap" />

                                <!-- Input & Snapshot Button Row -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBox x:Name="CheckpointNameInput"
                                             Text="Before Boss Fight"
                                             FontSize="11"
                                             Background="#0F1720"
                                             Foreground="#FFFFFF"
                                             BorderBrush="#253A4E"
                                             BorderThickness="1"
                                             Padding="6,5"
                                             VerticalContentAlignment="Center"
                                             Margin="0,0,6,0" />

                                    <Button Grid.Column="1" Click="CreateCheckpoint_Click"
                                            Style="{StaticResource SteamButtonStyle}"
                                            Padding="10,5">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="Save24" FontSize="13" Foreground="#66C0F4" Margin="0,0,4,0" />
                                            <TextBlock Text="Snapshot" FontSize="11" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <!-- Snapshot Feedback -->
                                <Border x:Name="SnapshotFeedbackPill" Visibility="Collapsed"
                                        Background="#162D38" BorderBrush="#255169" BorderThickness="1"
                                        CornerRadius="5" Padding="8,4" Margin="0,0,0,8">
                                    <TextBlock x:Name="SnapshotFeedbackText" Text="✓ Checkpoint saved successfully!"
                                               FontSize="11" Foreground="#66C0F4" HorizontalAlignment="Center" />
                                </Border>

                                <!-- Recent Snapshots List -->
                                <StackPanel x:Name="RecentSnapshotsPanel">
                                    <TextBlock Text="Recent Checkpoints:" FontSize="10" FontWeight="SemiBold" Foreground="#8F98A0" Margin="0,2,0,4" />
                                    <!-- Items generated dynamically in code-behind -->
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- In-Game Web Guides & Mini Browser Launcher Card -->
                        <Border Background="#16222F" BorderBrush="#24394E" BorderThickness="1"
                                CornerRadius="8" Padding="12" Margin="0,0,0,14">
                            <StackPanel>
                                <DockPanel LastChildFill="False" Margin="0,0,0,6">
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                        <ui:SymbolIcon Symbol="Globe24" FontSize="14" Foreground="#66C0F4" Margin="0,0,6,0" />
                                        <TextBlock Text="WEB GUIDES &amp; MINI BROWSER" FontSize="11" FontWeight="Bold" Foreground="#66C0F4" />
                                    </StackPanel>
                                    <Border Background="#162E1A" BorderBrush="#2C5C26" BorderThickness="1" CornerRadius="4" Padding="5,2" DockPanel.Dock="Right" ToolTip="Built-in Ad &amp; Tracker Blocker active">
                                        <TextBlock Text="🛡️ AdBlock ON" FontSize="9" FontWeight="Bold" Foreground="#A4D007" />
                                    </Border>
                                </DockPanel>
                                <TextBlock Text="Floating, resizable browser overlay over your game:"
                                           FontSize="10" Foreground="#8F98A0" Margin="0,0,0,8" />

                                <!-- Main Button to Open Floating Resizable Browser -->
                                <Button Click="OpenMiniBrowser_Click"
                                        Style="{StaticResource SteamPlayButtonStyle}"
                                        HorizontalAlignment="Stretch" Padding="10,7" Margin="0,0,0,8">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:SymbolIcon Symbol="Globe24" FontSize="14" Margin="0,0,8,0" />
                                        <TextBlock Text="🌐 Open Mini Web Browser ↗" FontSize="11" FontWeight="Bold" />
                                    </StackPanel>
                                </Button>

                                <!-- Direct Bookmark Quick Launchers -->
                                <WrapPanel>
                                    <Button x:Name="TutorialBookmarkBtn" Click="BookmarkPatchWiki_Click" Style="{StaticResource SteamButtonStyle}" Padding="6,3" Margin="0,0,4,4" ToolTip="Open Game Guides &amp; Tutorials" Visibility="Collapsed">
                                        <TextBlock Text="🛠️ Tutorial ↗" FontSize="10" Foreground="#A4D007" FontWeight="Bold" />
                                    </Button>
                                    <Button Click="BookmarkMapGenie_Click" Style="{StaticResource SteamButtonStyle}" Padding="6,3" Margin="0,0,4,4">
                                        <TextBlock Text="🗺️ MapGenie ↗" FontSize="10" />
                                    </Button>
                                    <Button Click="BookmarkSteamGuides_Click" Style="{StaticResource SteamButtonStyle}" Padding="6,3" Margin="0,0,4,4">
                                        <TextBlock Text="📖 Steam Guides ↗" FontSize="10" />
                                    </Button>
                                    <Button Click="BookmarkWiki_Click" Style="{StaticResource SteamButtonStyle}" Padding="6,3" Margin="0,0,4,4">
                                        <TextBlock Text="📚 Game Wiki ↗" FontSize="10" />
                                    </Button>
                                    <Button Click="BookmarkGoogle_Click" Style="{StaticResource SteamButtonStyle}" Padding="6,3" Margin="0,0,4,4">
                                        <TextBlock Text="🔍 Search ↗" FontSize="10" />
                                    </Button>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- Game Scratchpad / Notes Section -->
                        <Border Background="#16222F" BorderBrush="#24394E" BorderThickness="1"
                                CornerRadius="8" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <DockPanel LastChildFill="False" Margin="0,0,0,6">
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                        <ui:SymbolIcon Symbol="Note24" FontSize="14" Foreground="#E5A130" Margin="0,0,6,0" />
                                        <TextBlock Text="GAME SCRATCHPAD / NOTES" FontSize="11" FontWeight="Bold" Foreground="#66C0F4" />
                                    </StackPanel>
                                    <TextBlock x:Name="NotesSavedIndicator" DockPanel.Dock="Right"
                                               Text="Saved" FontSize="10" Foreground="#A4D007" Visibility="Collapsed" VerticalAlignment="Center" />
                                </DockPanel>
                                <TextBlock Text="Codes, puzzle clues, coords (auto-saved per game):"
                                           FontSize="10" Foreground="#8F98A0" Margin="0,0,0,6" />

                                <TextBox x:Name="GameNotesTextBox"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         Height="84"
                                         FontSize="11"
                                         Background="#0F1720"
                                         Foreground="#C6D4DF"
                                         BorderBrush="#253A4E"
                                         BorderThickness="1"
                                         Padding="8,6"
                                         VerticalScrollBarVisibility="Auto"
                                         TextChanged="GameNotesTextBox_TextChanged" />
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                <!-- 3. Footer -->
                <Grid Grid.Row="2" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Click="OpenMainApp_Click" Style="{StaticResource SteamButtonStyle}" HorizontalAlignment="Stretch" Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Home24" FontSize="13" Foreground="#66C0F4" Margin="0,0,6,0" />
                            <TextBlock Text="Open Main Dashboard" FontSize="11" />
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="1" Click="Close_Click" Style="{StaticResource SteamButtonStyle}">
                        <TextBlock Text="Esc to Close" FontSize="10" Foreground="#8F98A0" />
                    </Button>
                </Grid>

            </Grid>
        </Border>
    </Grid>
</Window>
