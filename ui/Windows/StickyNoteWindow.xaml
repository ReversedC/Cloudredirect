<Window x:Class="CloudRedirect.Windows.StickyNoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Game Sticky Note"
        Width="320" Height="240"
        MinWidth="200" MinHeight="100"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <Style x:Key="MiniIconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="#8F98A0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2A3F55" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="QuickChipButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#121D28" />
            <Setter Property="BorderBrush" Value="#21354A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#8F98A0" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="chipBd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="chipBd" Property="Background" Value="#1E334A" />
                                <Setter TargetName="chipBd" Property="BorderBrush" Value="#325A82" />
                                <Setter Property="Foreground" Value="#66C0F4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="6">
        <!-- Main Note Container with Shadow -->
        <Border x:Name="NoteContainerBorder"
                Background="#142232"
                BorderBrush="#254569"
                BorderThickness="1"
                CornerRadius="8"
                ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="3" Opacity="0.75" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="34" /> <!-- Header -->
                    <RowDefinition Height="*" />  <!-- Body & Toolbar -->
                </Grid.RowDefinitions>

                <!-- 1. Header: Draggable Title Bar & Controls -->
                <Border Grid.Row="0"
                        x:Name="HeaderBorder"
                        Background="#0F1A26"
                        BorderBrush="#1C3044"
                        BorderThickness="0,0,0,1"
                        Padding="8,4"
                        MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Color Accent Bar -->
                        <Border Grid.Column="0"
                                x:Name="AccentDot"
                                Width="5" Height="14"
                                Background="#66C0F4"
                                CornerRadius="2"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center" />

                        <!-- Title Input (Editable on click) -->
                        <TextBox Grid.Column="1"
                                 x:Name="TitleInput"
                                 Text="Quick Note"
                                 FontSize="11.5"
                                 FontWeight="Bold"
                                 Foreground="#FFFFFF"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 VerticalAlignment="Center"
                                 Padding="0"
                                 TextChanged="TitleInput_TextChanged" />

                        <!-- Window Header Action Controls -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- New Note Button -->
                            <Button Style="{StaticResource MiniIconButtonStyle}"
                                    ToolTip="New Sticky Note (Alt+N)"
                                    Click="NewNote_Click">
                                <TextBlock Text="+" FontSize="13" FontWeight="Bold" Foreground="#66C0F4" />
                            </Button>

                            <!-- Pin to Game Toggle -->
                            <Button x:Name="PinButton"
                                    Style="{StaticResource MiniIconButtonStyle}"
                                    ToolTip="Pin Always On Top over game (Ctrl+P)"
                                    Click="PinButton_Click">
                                <TextBlock x:Name="PinIconText" Text="📌" FontSize="11" />
                            </Button>

                            <!-- Lock / Read-Only Toggle (prevents accidental typing during intense gameplay) -->
                            <Button x:Name="LockButton"
                                    Style="{StaticResource MiniIconButtonStyle}"
                                    ToolTip="Lock Note / Read-Only mode (Ctrl+L)"
                                    Click="LockButton_Click">
                                <TextBlock x:Name="LockIconText" Text="🔓" FontSize="11" />
                            </Button>

                            <!-- Transparency Popout Toggle -->
                            <Button x:Name="OpacityButton"
                                    Style="{StaticResource MiniIconButtonStyle}"
                                    ToolTip="Adjust Note Transparency"
                                    Click="OpacityButton_Click">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🌓" FontSize="10" Margin="0,0,3,0" />
                                    <TextBlock x:Name="OpacityPercentText" Text="90%" FontSize="9.5" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>

                            <!-- Theme Color Palette Toggle -->
                            <Button x:Name="ColorButton"
                                    Style="{StaticResource MiniIconButtonStyle}"
                                    ToolTip="Change Theme Color"
                                    Click="ColorButton_Click">
                                <TextBlock Text="🎨" FontSize="11" />
                            </Button>

                            <!-- Collapse/Expand Toggle -->
                            <Button x:Name="CollapseButton"
                                    Style="{StaticResource MiniIconButtonStyle}"
                                    ToolTip="Collapse/Expand Note"
                                    Click="CollapseButton_Click">
                                <TextBlock x:Name="CollapseIconText" Text="▲" FontSize="9" />
                            </Button>

                            <!-- Delete Note -->
                            <Button Style="{StaticResource MiniIconButtonStyle}"
                                    ToolTip="Delete Note"
                                    Click="DeleteNote_Click">
                                <TextBlock Text="🗑️" FontSize="10" />
                            </Button>

                            <!-- Hide / Close Window -->
                            <Button Style="{StaticResource MiniIconButtonStyle}"
                                    ToolTip="Close (Accessible in Game Space)"
                                    Click="CloseWindow_Click">
                                <TextBlock Text="✕" FontSize="11" FontWeight="Bold" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 2. Body Area (Collapsible) -->
                <Grid Grid.Row="1" x:Name="BodyContainer">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /> <!-- Quick Tools -->
                        <RowDefinition Height="*" />    <!-- Text Editor -->
                        <RowDefinition Height="Auto" /> <!-- Footer bar & Resize Grip -->
                    </Grid.RowDefinitions>

                    <!-- Quick Tools (Checklist, Bullets, Timestamp) -->
                    <Border Grid.Row="0" Background="#0C141E" Padding="6,4" BorderBrush="#162738" BorderThickness="0,0,0,1">
                        <DockPanel LastChildFill="False">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                <Button Content="☑ Todo" Style="{StaticResource QuickChipButtonStyle}" Click="InsertTodo_Click" ToolTip="Insert checklist checkbox" />
                                <Button Content="• Bullet" Style="{StaticResource QuickChipButtonStyle}" Click="InsertBullet_Click" ToolTip="Insert bullet item" />
                                <Button Content="⏱ Time" Style="{StaticResource QuickChipButtonStyle}" Click="InsertTimestamp_Click" ToolTip="Insert current timestamp" />
                            </StackPanel>

                            <TextBlock x:Name="SaveStatusText" DockPanel.Dock="Right"
                                       Text="Saved" FontSize="9.5"
                                       Foreground="#A4D007"
                                       VerticalAlignment="Center"
                                       Visibility="Collapsed" />
                        </DockPanel>
                    </Border>

                    <!-- Main Text Editor -->
                    <TextBox Grid.Row="1"
                             x:Name="NoteContentInput"
                             AcceptsReturn="True"
                             AcceptsTab="True"
                             TextWrapping="Wrap"
                             FontSize="11.5"
                             Background="Transparent"
                             Foreground="#C6D4DF"
                             CaretBrush="#66C0F4"
                             BorderThickness="0"
                             Padding="10,8"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Disabled"
                             TextChanged="NoteContentInput_TextChanged" />

                    <!-- Bottom Bar with Resize Handle -->
                    <Grid Grid.Row="2" Background="#0B131C" Height="16">
                        <TextBlock x:Name="GameTagText" Text="Global"
                                   FontSize="9" Foreground="#556778"
                                   Margin="8,0,0,0" VerticalAlignment="Center" />

                        <!-- Draggable Resize Grip at Bottom-Right -->
                        <Thumb x:Name="WindowResizeGrip"
                               Width="16" Height="16"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Bottom"
                               Cursor="SizeNWSE"
                               DragDelta="WindowResizeGrip_DragDelta">
                            <Thumb.Template>
                                <ControlTemplate TargetType="Thumb">
                                    <Grid Background="Transparent" VerticalAlignment="Bottom" HorizontalAlignment="Right" Width="14" Height="14" Margin="0,0,2,2">
                                        <Path Data="M 12,2 L 14,0 L 14,14 L 0,14 L 2,12 L 12,12 Z M 8,6 L 10,4 L 10,10 L 4,10 L 6,8 L 8,8 Z"
                                              Fill="#4A6178"
                                              Opacity="0.75" />
                                    </Grid>
                                </ControlTemplate>
                            </Thumb.Template>
                        </Thumb>
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <!-- Transparency Popover Popup -->
        <Popup x:Name="OpacityPopup"
               PlacementTarget="{Binding ElementName=OpacityButton}"
               Placement="Bottom"
               StaysOpen="False"
               AllowsTransparency="True">
            <Border Background="#101C28" BorderBrush="#25425F" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="4">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="8" ShadowDepth="2" Opacity="0.8" />
                </Border.Effect>
                <StackPanel Width="150">
                    <DockPanel Margin="0,0,0,6">
                        <TextBlock Text="Note Transparency" FontSize="10.5" FontWeight="SemiBold" Foreground="#66C0F4" DockPanel.Dock="Left" />
                        <TextBlock x:Name="PopupOpacityValueText" Text="90%" FontSize="10.5" Foreground="#A4D007" DockPanel.Dock="Right" />
                    </DockPanel>
                    <Slider x:Name="OpacitySlider"
                            Minimum="20" Maximum="100" Value="90"
                            TickFrequency="5" IsSnapToTickEnabled="True"
                            ValueChanged="OpacitySlider_ValueChanged"
                            Margin="0,0,0,8" />
                    <!-- Quick Presets -->
                    <UniformGrid Columns="4">
                        <Button Content="100%" Style="{StaticResource QuickChipButtonStyle}" Click="OpacityPreset_Click" Tag="100" />
                        <Button Content="80%" Style="{StaticResource QuickChipButtonStyle}" Click="OpacityPreset_Click" Tag="80" />
                        <Button Content="50%" Style="{StaticResource QuickChipButtonStyle}" Click="OpacityPreset_Click" Tag="50" />
                        <Button Content="30%" Style="{StaticResource QuickChipButtonStyle}" Click="OpacityPreset_Click" Tag="30" />
                    </UniformGrid>
                </StackPanel>
            </Border>
        </Popup>

        <!-- Color Palette Popover Popup -->
        <Popup x:Name="ColorPopup"
               PlacementTarget="{Binding ElementName=ColorButton}"
               Placement="Bottom"
               StaysOpen="False"
               AllowsTransparency="True">
            <Border Background="#101C28" BorderBrush="#25425F" BorderThickness="1" CornerRadius="6" Padding="10" Margin="4">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="8" ShadowDepth="2" Opacity="0.8" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Choose Note Theme" FontSize="10.5" FontWeight="SemiBold" Foreground="#66C0F4" Margin="0,0,0,6" />
                    <StackPanel Orientation="Horizontal">
                        <!-- Slate Navy -->
                        <Button Width="22" Height="22" Margin="0,0,5,0" Background="#142232" BorderBrush="#66C0F4" BorderThickness="1.5" Cursor="Hand" Click="ColorPreset_Click" Tag="#142232|#66C0F4" ToolTip="Steam Slate Navy" />
                        <!-- Amber Gold -->
                        <Button Width="22" Height="22" Margin="0,0,5,0" Background="#2B1E08" BorderBrush="#E5A130" BorderThickness="1.5" Cursor="Hand" Click="ColorPreset_Click" Tag="#2B1E08|#E5A130" ToolTip="Amber Quest Gold" />
                        <!-- Cyber Cyan -->
                        <Button Width="22" Height="22" Margin="0,0,5,0" Background="#0B232E" BorderBrush="#00D2FF" BorderThickness="1.5" Cursor="Hand" Click="ColorPreset_Click" Tag="#0B232E|#00D2FF" ToolTip="Cyber Cyan" />
                        <!-- Gamer Green -->
                        <Button Width="22" Height="22" Margin="0,0,5,0" Background="#102717" BorderBrush="#A4D007" BorderThickness="1.5" Cursor="Hand" Click="ColorPreset_Click" Tag="#102717|#A4D007" ToolTip="Gamer Green" />
                        <!-- Crimson Hazard -->
                        <Button Width="22" Height="22" Margin="0,0,5,0" Background="#2B1218" BorderBrush="#FF6B72" BorderThickness="1.5" Cursor="Hand" Click="ColorPreset_Click" Tag="#2B1218|#FF6B72" ToolTip="Crimson Hazard" />
                        <!-- Royal Violet -->
                        <Button Width="22" Height="22" Margin="0,0,0,0" Background="#21122B" BorderBrush="#B466F4" BorderThickness="1.5" Cursor="Hand" Click="ColorPreset_Click" Tag="#21122B|#B466F4" ToolTip="Royal Violet" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
