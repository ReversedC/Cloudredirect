<Window x:Class="CloudRedirect.Windows.MiniBrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="CloudRedirect Mini Browser"
        Width="860" Height="560"
        MinWidth="480" MinHeight="360"
        WindowStartupLocation="CenterScreen"
        Background="#171A21"
        Foreground="#C6D4DF"
        Topmost="True"
        KeyDown="Window_KeyDown">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="42"
                      ResizeBorderThickness="6"
                      CornerRadius="0"
                      GlassFrameThickness="0" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Steam Button Style -->
        <Style x:Key="SteamButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#22364B" />
            <Setter Property="Foreground" Value="#C6D4DF" />
            <Setter Property="BorderBrush" Value="#325272" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#2F4C69" />
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="#4C78A4" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#172738" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Steam Caption Window Controls (Min, Max, Close) -->
        <Style x:Key="CaptionControlButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#8F98A0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#2A3F5A" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#1A2B3D" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseCaptionControlButtonStyle" TargetType="Button" BasedOn="{StaticResource CaptionControlButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#E81123" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#A00D19" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Outer Window Frame Border -->
    <Border BorderBrush="#2A475E" BorderThickness="1" Background="#171A21">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- 1. Custom Draggable Title Bar -->
                <RowDefinition Height="Auto" /> <!-- 2. Navigation & Bookmarks Toolbar -->
                <RowDefinition Height="*" />    <!-- 3. WebView2 Browser Surface -->
            </Grid.RowDefinitions>

            <!-- 1. Custom Draggable Steam Title Bar -->
            <Border Grid.Row="0"
                    Background="#1B2838"
                    BorderBrush="#253A4E"
                    BorderThickness="0,0,0,1"
                    Height="42"
                    Padding="12,0,8,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Title & Brand -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/steam_logo3.ico" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="WEB GUIDE &amp; MAPS" FontSize="12" FontWeight="Bold" Foreground="#66C0F4" VerticalAlignment="Center" />

                        <!-- Active Game Badge -->
                        <Border x:Name="ActiveGameBadge" Background="#142433" BorderBrush="#294560" BorderThickness="1"
                                CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="ActiveGameNameText" Text="Standalone" FontSize="10" FontWeight="SemiBold" Foreground="#C6D4DF" />
                        </Border>
                    </StackPanel>

                    <!-- Center Area (Empty, allows dragging the window) -->
                    <Rectangle Grid.Column="1" Fill="Transparent" />

                    <!-- Title Bar Actions (Right-aligned) -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Always-On-Top Pin Toggle -->
                        <Button x:Name="PinButton" Click="PinButton_Click"
                                Style="{StaticResource SteamButtonStyle}"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                Padding="8,4" Margin="0,0,8,0"
                                ToolTip="Pin floating browser always on top of games">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="PinIconText" Text="📌" FontSize="11" Margin="0,0,4,0" />
                                <TextBlock x:Name="PinLabelText" Text="Pinned" FontSize="10" FontWeight="Bold" Foreground="#A4D007" />
                            </StackPanel>
                        </Button>

                        <!-- Built-in AdBlock Status Badge -->
                        <Border Background="#162E1A" BorderBrush="#2C5C26" BorderThickness="1"
                                CornerRadius="4" Padding="6,3" Margin="0,0,12,0" VerticalAlignment="Center"
                                ToolTip="Built-in Ad &amp; Tracker Blocker active">
                            <TextBlock Text="🛡️ AdBlock ON" FontSize="9" FontWeight="Bold" Foreground="#A4D007" />
                        </Border>

                        <!-- Window Controls -->
                        <Button Click="Minimize_Click" Style="{StaticResource CaptionControlButtonStyle}" ToolTip="Minimize">
                            <TextBlock Text="🗕" FontSize="10" />
                        </Button>
                        <Button Click="Maximize_Click" Style="{StaticResource CaptionControlButtonStyle}" ToolTip="Maximize / Restore">
                            <TextBlock x:Name="MaximizeButtonGlyph" Text="🗖" FontSize="10" />
                        </Button>
                        <Button Click="Close_Click" Style="{StaticResource CloseCaptionControlButtonStyle}" ToolTip="Close">
                            <TextBlock Text="✕" FontSize="11" FontWeight="Bold" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. Navigation & Bookmarks Toolbar -->
            <Border Grid.Row="1"
                    Background="#131C26"
                    BorderBrush="#253A4E"
                    BorderThickness="0,0,0,1"
                    Padding="10,8">
                <StackPanel>
                    <!-- Nav Bar: Back, Forward, Reload, Address Bar, Go -->
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Back -->
                        <Button Grid.Column="0" Click="BrowserBack_Click" Style="{StaticResource SteamButtonStyle}" Padding="8,4" Margin="0,0,4,0" ToolTip="Back">
                            <TextBlock Text="◀" FontSize="11" />
                        </Button>

                        <!-- Forward -->
                        <Button Grid.Column="1" Click="BrowserForward_Click" Style="{StaticResource SteamButtonStyle}" Padding="8,4" Margin="0,0,4,0" ToolTip="Forward">
                            <TextBlock Text="▶" FontSize="11" />
                        </Button>

                        <!-- Reload -->
                        <Button Grid.Column="2" Click="BrowserReload_Click" Style="{StaticResource SteamButtonStyle}" Padding="8,4" Margin="0,0,6,0" ToolTip="Reload">
                            <TextBlock Text="🔄" FontSize="11" />
                        </Button>

                        <!-- URL / Search Input -->
                        <TextBox Grid.Column="3" x:Name="BrowserUrlInput"
                                 Text="https://mapgenie.io"
                                 FontSize="12"
                                 Background="#0F1720"
                                 Foreground="#FFFFFF"
                                 BorderBrush="#253A4E"
                                 BorderThickness="1"
                                 Padding="8,5"
                                 VerticalContentAlignment="Center"
                                 KeyDown="BrowserUrlInput_KeyDown" />

                        <!-- Go -->
                        <Button Grid.Column="4" Click="BrowserGo_Click" Style="{StaticResource SteamButtonStyle}" Padding="12,5" Margin="6,0,0,0">
                            <TextBlock Text="Go" FontSize="11" FontWeight="Bold" Foreground="#66C0F4" />
                        </Button>
                    </Grid>

                    <!-- Quick Bookmarks Row -->
                    <WrapPanel Margin="0,2,0,0">
                        <Button Click="BookmarkPatchWiki_Click" Style="{StaticResource SteamButtonStyle}" Padding="8,3" Margin="0,0,5,4" ToolTip="Open Tutorial Game Guides">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🛠️" FontSize="10" Margin="0,0,4,0" />
                                <TextBlock Text="Tutorial" FontSize="10" Foreground="#A4D007" FontWeight="Bold" />
                            </StackPanel>
                        </Button>
                        <Button Click="BookmarkMapGenie_Click" Style="{StaticResource SteamButtonStyle}" Padding="8,3" Margin="0,0,5,4">
                            <TextBlock Text="🗺️ MapGenie" FontSize="10" />
                        </Button>
                        <Button Click="BookmarkSteamGuides_Click" Style="{StaticResource SteamButtonStyle}" Padding="8,3" Margin="0,0,5,4">
                            <TextBlock Text="📖 Steam Guides" FontSize="10" />
                        </Button>
                        <Button Click="BookmarkWiki_Click" Style="{StaticResource SteamButtonStyle}" Padding="8,3" Margin="0,0,5,4">
                            <TextBlock Text="📚 Game Wiki" FontSize="10" />
                        </Button>
                        <Button Click="BookmarkGoogle_Click" Style="{StaticResource SteamButtonStyle}" Padding="8,3" Margin="0,0,5,4">
                            <TextBlock Text="🔍 Google Search" FontSize="10" />
                        </Button>
                        <Button Click="BookmarkIgnGuides_Click" Style="{StaticResource SteamButtonStyle}" Padding="8,3" Margin="0,0,5,4">
                            <TextBlock Text="⚡ IGN Walkthroughs" FontSize="10" />
                        </Button>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- 3. Embedded WebView2 Surface -->
            <Grid Grid.Row="2" Background="#0C1219">
                <wv2:WebView2 x:Name="BrowserWebView" />

                <!-- Loading / AdBlock Overlay -->
                <Border x:Name="BrowserLoadingIndicator" Background="#E60E1620" Visibility="Collapsed" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ProgressBar IsIndeterminate="True" Width="140" Height="4" Foreground="#66C0F4" Background="#1B2838" BorderThickness="0" Margin="0,0,0,10" />
                        <TextBlock Text="Loading guide..." FontSize="12" FontWeight="SemiBold" Foreground="#66C0F4" HorizontalAlignment="Center" />
                        <TextBlock Text="🛡️ Blocking trackers &amp; ads in real-time" FontSize="10" Foreground="#A4D007" HorizontalAlignment="Center" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
