<ui:FluentWindow x:Class="CloudRedirect.Windows.SunshineMiniWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Sunshine Streaming Manager"
        Width="980"
        Height="660"
        MinWidth="760"
        MinHeight="480"
        MaxWidth="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Width}"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        WindowStartupLocation="CenterScreen"
        WindowBackdropType="None"
        Background="{DynamicResource SteamWindowBackgroundGradient}"
        ExtendsContentIntoTitleBar="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- TitleBar -->
        <ui:TitleBar Grid.Row="0" x:Name="AppTitleBar" Title="Sunshine Streaming Manager">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/steam_logo3.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- Steam Mini-Browser Toolbar -->
        <Border Grid.Row="1" Background="#141E28" BorderBrush="#253A4E" BorderThickness="0,0,0,1" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Navigation Controls -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button x:Name="NavBackBtn" Icon="{ui:SymbolIcon ArrowLeft24}" ToolTip="Back"
                               Padding="8,6" Margin="0,0,4,0" Click="NavBackBtn_Click" />
                    <ui:Button x:Name="NavForwardBtn" Icon="{ui:SymbolIcon ArrowRight24}" ToolTip="Forward"
                               Padding="8,6" Margin="0,0,4,0" Click="NavForwardBtn_Click" />
                    <ui:Button x:Name="NavRefreshBtn" Icon="{ui:SymbolIcon ArrowClockwise24}" ToolTip="Refresh Page"
                               Padding="8,6" Margin="0,0,8,0" Click="NavRefreshBtn_Click" />

                    <!-- Quick Shortcuts -->
                    <ui:Button x:Name="GoDashboardBtn" Icon="{ui:SymbolIcon Home24}" Content="Dashboard"
                               Appearance="Secondary" Padding="10,6" Margin="0,0,6,0" Click="GoDashboardBtn_Click" />
                    <ui:Button x:Name="GoPinBtn" Icon="{ui:SymbolIcon Key24}" Content="PIN Pairing"
                               Appearance="Secondary" Padding="10,6" Margin="0,0,8,0" Click="GoPinBtn_Click" />
                </StackPanel>

                <!-- Address / Status Pill -->
                <Border Grid.Column="1" Background="#0E161F" BorderBrush="#1F3243" BorderThickness="1"
                        CornerRadius="4" Padding="10,5" Margin="8,0" VerticalAlignment="Center">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Grid.Column="0" Symbol="LockClosed20" Foreground="#5C7E10" Margin="0,0,8,0" />
                        <TextBlock Grid.Column="1" x:Name="UrlDisplayBlock" Text="https://localhost:47990"
                                   Foreground="#C5C3C0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="12" />
                        <TextBlock Grid.Column="2" x:Name="StatusBadge" Text="SSL Auto-Trusted"
                                   Foreground="#66C0F4" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- Right Actions: Auto-Fit Zoom, Credentials & External Browser -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Auto-Fit Zoom Pill -->
                    <Border Background="#0E161F" BorderBrush="#1F3243" BorderThickness="1" CornerRadius="13" Padding="4,2" Margin="0,0,8,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:Button x:Name="ZoomOutBtn" ToolTip="Zoom Out" Width="22" Height="22" Padding="0" Margin="0" Appearance="Transparent" Click="ZoomOutBtn_Click">
                                <ui:SymbolIcon Symbol="SubtractCircle20" FontSize="13" Foreground="#8F98A0" />
                            </ui:Button>
                            <TextBlock x:Name="ZoomPercentText" Text="Auto Fit" FontSize="11" FontWeight="SemiBold" Foreground="#66C0F4" VerticalAlignment="Center" Margin="5,0" ToolTip="Click to Reset or Toggle Auto-Fit" Cursor="Hand" MouseDown="ZoomPercent_MouseDown" />
                            <ui:Button x:Name="ZoomInBtn" ToolTip="Zoom In" Width="22" Height="22" Padding="0" Margin="0" Appearance="Transparent" Click="ZoomInBtn_Click">
                                <ui:SymbolIcon Symbol="AddCircle20" FontSize="13" Foreground="#8F98A0" />
                            </ui:Button>
                            <ui:Button x:Name="AutoFitBtn" ToolTip="Auto-Fit Dashboard to Window" Width="22" Height="22" Padding="0" Margin="2,0,0,0" Appearance="Transparent" Click="AutoFitBtn_Click">
                                <ui:SymbolIcon Symbol="FullScreenMaximize24" FontSize="13" Foreground="#66D18F" />
                            </ui:Button>
                        </StackPanel>
                    </Border>

                    <ui:Button x:Name="CopyCredsBtn" Icon="{ui:SymbolIcon Copy24}" Content="Copy Password"
                               Appearance="Secondary" Padding="10,6" Margin="0,0,6,0" ToolTip="Copy Sunshine Admin Password" Click="CopyCredsBtn_Click" />
                    <ui:Button x:Name="OpenExternalBtn" Icon="{ui:SymbolIcon Open24}" ToolTip="Open in External Default Browser"
                               Appearance="Transparent" Padding="8,6" Click="OpenExternalBtn_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- WebView2 Body / Fallback View -->
        <Grid Grid.Row="2" Background="#171A21">
            <wv2:WebView2 x:Name="SunshineWebView" DefaultBackgroundColor="#171a21" />

            <!-- Fallback Screen in case WebView2 Runtime is missing -->
            <Border x:Name="FallbackPanel" Background="#171A21" Visibility="Collapsed" Padding="32">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="500">
                    <ui:SymbolIcon Symbol="Warning28" Foreground="#E5C158" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,16" />
                    <TextBlock Text="Embedded Browser Runtime Required"
                               FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" Margin="0,0,0,10" />
                    <TextBlock Text="To view the Sunshine Dashboard inside CloudRedirect without opening your external browser, the Microsoft Edge WebView2 runtime is needed."
                               Foreground="#8F98A0" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,20" LineHeight="20" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <ui:Button Content="Open in Default Browser" Appearance="Primary" Padding="14,8" Margin="0,0,10,0" Click="OpenExternalBtn_Click" />
                        <ui:Button Content="Download WebView2" Appearance="Secondary" Padding="14,8" Click="DownloadWebView2_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Loading Indicator -->
            <Border x:Name="LoadingOverlay" Background="#E6171A21" Visibility="Visible">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ui:ProgressRing IsIndeterminate="True" Width="48" Height="48" Margin="0,0,0,14" />
                    <TextBlock Text="Connecting to Sunshine..." Foreground="#66C0F4" FontSize="14" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
