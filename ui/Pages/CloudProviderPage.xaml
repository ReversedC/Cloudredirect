<Page x:Class="CloudRedirect.Pages.CloudProviderPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:res="clr-namespace:CloudRedirect.Resources"
      ScrollViewer.CanContentScroll="False">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,16">
        <StackPanel>
            <TextBlock Text="{res:Loc CloudProvider_Title}"
                       FontSize="26" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                       Margin="0,0,0,6" />

            <TextBlock Text="{res:Loc CloudProvider_Description}"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,16" />

            <TextBlock Text="{res:Loc CloudProvider_Provider}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                       Margin="0,0,0,6" />

            <!-- Google Drive Active Badge + Wizard Button -->
            <Border Background="#16293A" BorderBrush="#254F70" BorderThickness="1"
                    CornerRadius="8" Padding="16,12" HorizontalAlignment="Left" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="CloudSync24" FontSize="24" Foreground="#66C0F4" Margin="0,0,12,0" VerticalAlignment="Center" />
                    <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                        <TextBlock Text="Google Drive" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="Primary cloud save storage for all Steam games" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <ui:Button Content="Open Setup Wizard" Appearance="Primary" Icon="{ui:SymbolIcon Sparkle24}" Click="OpenWizard_Click" VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- Hidden ProviderCombo with single gdrive item for backward compatibility -->
            <ComboBox x:Name="ProviderCombo" Visibility="Collapsed">
                <ComboBoxItem Content="Google Drive" Tag="gdrive" IsSelected="True" />
            </ComboBox>

            <TextBlock x:Name="PathLabel"
                       Text="{res:Loc CloudProvider_TokenFilePath}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                       Margin="0,0,0,6" />

            <Grid x:Name="TokenPathGrid" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBox x:Name="TokenPathBox"
                            Grid.Column="0"
                            PlaceholderText="{res:Loc CloudProvider_TokenPlaceholder}"
                            LostFocus="TokenPathBox_LostFocus" />
                <ui:Button x:Name="BrowseButton"
                           Grid.Column="1"
                           Content="{res:Loc CloudProvider_Browse}"
                           Margin="8,0,0,0"
                           Click="BrowseToken_Click" />
            </Grid>

            <TextBlock x:Name="PathHint"
                       Text=""
                       FontSize="11"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                       TextWrapping="Wrap"
                       Visibility="Collapsed"
                       Margin="0,-16,0,24" />

            <TextBlock Text="{res:Loc CloudProvider_Authentication}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                       Margin="0,0,0,6" />

            <ui:CardControl Margin="0,0,0,12">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="{res:Loc CloudProvider_AuthenticationStatus}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock x:Name="AuthStatus"
                                   Text="{res:Loc CloudProvider_NoTokensLoaded}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:SymbolIcon x:Name="AuthIcon" Symbol="ShieldKeyhole24" FontSize="24" />
            </ui:CardControl>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <ui:Button x:Name="SignInButton"
                           Content="{res:Loc CloudProvider_SignIn}"
                           Appearance="Primary"
                           Icon="{ui:SymbolIcon PersonKey20}"
                           Click="SignIn_Click"
                           Margin="0,0,8,0" />
                <ui:Button x:Name="CopyAuthUrlButton"
                           Content="{res:Loc CloudProvider_CopyLink}"
                           Icon="{ui:SymbolIcon Copy24}"
                           Click="CopyAuthUrl_Click"
                           Margin="0,0,8,0"
                           Visibility="Collapsed" />
                <ui:Button x:Name="OpenBrowserButton"
                           Content="{res:Loc CloudProvider_OpenBrowser}"
                           Icon="{ui:SymbolIcon ArrowUpRight24}"
                           Click="OpenBrowser_Click"
                           Margin="0,0,8,0"
                           Visibility="Collapsed" />
                <ui:Button x:Name="CancelAuthButton"
                           Content="{res:Loc CloudProvider_Cancel}"
                           Icon="{ui:SymbolIcon Dismiss24}"
                           Click="CancelAuth_Click"
                           Visibility="Collapsed" />
            </StackPanel>

            <!-- OAuth Assist & Cross-Device / Manual Fallback Card -->
            <Border x:Name="AuthAssistCard"
                    Background="{StaticResource SteamCardGradient}"
                    BorderBrush="{StaticResource SteamBorderHighlightBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="16,14"
                    Margin="0,0,0,16"
                    Visibility="Collapsed">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Symbol="Globe24" FontSize="20" Foreground="{StaticResource SteamAccentCyanBrush}" Margin="0,1,10,0" VerticalAlignment="Top" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{res:Loc CloudProvider_AuthAssistTitle}"
                                       FontWeight="SemiBold"
                                       FontSize="13"
                                       Foreground="{StaticResource SteamTextPrimaryBrush}" />
                            <TextBlock Text="{res:Loc CloudProvider_AuthAssistHint}"
                                       FontSize="12"
                                       Foreground="{StaticResource SteamTextSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                    </Grid>

                    <!-- Security Warning Banner -->
                    <Border Background="#22F5A623"
                            BorderBrush="#66F5A623"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10,8"
                            Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Symbol="Warning24"
                                           FontSize="16"
                                           Foreground="#FFF5A623"
                                           Margin="0,1,8,0"
                                           VerticalAlignment="Top" />
                            <TextBlock Grid.Column="1"
                                       Text="{res:Loc CloudProvider_SecurityWarning}"
                                       FontSize="11.5"
                                       Foreground="#FFF5A623"
                                       TextWrapping="Wrap"
                                       LineHeight="16" />
                        </Grid>
                    </Border>

                    <!-- QR Code / Smartphone Assist Section -->
                    <Border Background="{DynamicResource SteamBgDarkestBrush}"
                            BorderBrush="{StaticResource SteamBorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="14"
                            Margin="0,4,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- QR Code Frame -->
                            <StackPanel Grid.Column="0" VerticalAlignment="Top" Margin="0,0,16,0" HorizontalAlignment="Center">
                                <Border Background="White"
                                        CornerRadius="6"
                                        Padding="6"
                                        Width="134"
                                        Height="134"
                                        BorderBrush="#3877A8"
                                        BorderThickness="1.5"
                                        Cursor="Hand"
                                        ToolTip="{res:Loc Wizard_Step2_QrClickToEnlarge}"
                                        MouseLeftButtonDown="QrImage_MouseLeftButtonDown">
                                    <Image x:Name="QrCodeImage"
                                           Width="122"
                                           Height="122"
                                           Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                </Border>
                                <Button Style="{StaticResource SteamSecondaryButtonStyle}"
                                        FontSize="11"
                                        Padding="10,3"
                                        Margin="0,6,0,0"
                                        HorizontalAlignment="Center"
                                        ToolTip="{res:Loc Wizard_Step2_QrClickToEnlarge}"
                                        Click="EnlargeQr_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="ZoomIn24" FontSize="13" Foreground="#66C0F4" Margin="0,0,4,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{res:Loc Wizard_Step2_EnlargeQr}" FontSize="11" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <!-- QR Description & Mode Selector -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <ui:SymbolIcon Symbol="QrCode24" FontSize="16" Foreground="{StaticResource SteamAccentLightBlueBrush}" Margin="0,0,6,0" />
                                    <TextBlock Text="{res:Loc CloudProvider_QrTitle}"
                                               FontWeight="SemiBold"
                                               FontSize="13"
                                               Foreground="{StaticResource SteamTextPrimaryBrush}" />
                                </StackPanel>

                                <TextBlock x:Name="QrDescriptionText"
                                           Text="{res:Loc CloudProvider_QrDescription}"
                                           FontSize="12"
                                           Foreground="{StaticResource SteamTextSecondaryBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,10" />

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <RadioButton x:Name="QrModeWifiRadio"
                                                 Content="{res:Loc CloudProvider_QrModeWifi}"
                                                 IsChecked="True"
                                                 GroupName="QrMode"
                                                 FontSize="12"
                                                 Checked="QrMode_Checked"
                                                 Margin="0,0,14,0" />
                                    <RadioButton x:Name="QrModeDirectRadio"
                                                 Content="{res:Loc CloudProvider_QrModeDirect}"
                                                 GroupName="QrMode"
                                                 FontSize="12"
                                                 Checked="QrMode_Checked" />
                                </StackPanel>

                                <TextBlock x:Name="QrModeHintText"
                                           Text="{res:Loc CloudProvider_QrModeWifiHint}"
                                           FontSize="11"
                                           Foreground="{StaticResource SteamTextTertiaryBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox x:Name="ManualCodeInput"
                                    Grid.Column="0"
                                    PlaceholderText="{res:Loc CloudProvider_ManualCodePlaceholder}"
                                    FontSize="12"
                                    KeyDown="ManualCodeInput_KeyDown" />
                        <ui:Button x:Name="SubmitManualCodeButton"
                                   Grid.Column="1"
                                   Content="{res:Loc CloudProvider_CompleteSignIn}"
                                   Appearance="Primary"
                                   Icon="{ui:SymbolIcon Checkmark24}"
                                   Margin="8,0,0,0"
                                   Click="SubmitManualCode_Click" />
                    </Grid>

                    <TextBlock x:Name="ManualCodeError"
                               FontSize="12"
                               Foreground="#FFE06C75"
                               TextWrapping="Wrap"
                               Margin="0,6,0,0"
                               Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <Border x:Name="LogBorder"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    CornerRadius="4"
                    Padding="12"
                    Margin="0,0,0,24"
                    Visibility="Collapsed"
                    MaxHeight="200">
                <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto">
                    <TextBox x:Name="LogOutput"
                             FontFamily="Cascadia Mono,Consolas,monospace"
                             FontSize="12"
                             Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                             Background="Transparent"
                             BorderThickness="0"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             AcceptsReturn="True" />
                </ScrollViewer>
            </Border>

            <StackPanel x:Name="UploadInFlightSection" Margin="0,0,0,24" Visibility="Collapsed">
                <TextBlock Text="{res:Loc CloudProvider_UploadInFlight}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           Margin="0,0,0,8" />
                <TextBlock Text="{res:Loc CloudProvider_UploadInFlightHint}"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,12" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Slider + its tick labels share column 0 so the labels
                         track the slider width exactly. Ticks every 5 MB
                         (24..64); 24/44/64 fall on ticks at 0% / 50% / 100%.
                         Two equal label columns split at 50%; Safe
                         left-anchored, Balanced straddles the centre,
                         Aggressive right-anchored. -->
                    <StackPanel Grid.Column="0">
                        <Slider x:Name="UploadInFlightSlider"
                                Minimum="24" Maximum="64"
                                TickFrequency="5" IsSnapToTickEnabled="True"
                                TickPlacement="BottomRight"
                                ValueChanged="UploadInFlightSlider_Changed" />
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       HorizontalAlignment="Left"
                                       Text="{res:Loc CloudProvider_UploadInFlightConservative}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            <TextBlock Grid.Column="0" Grid.ColumnSpan="2"
                                       HorizontalAlignment="Center"
                                       Text="{res:Loc CloudProvider_UploadInFlightBalanced}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            <TextBlock Grid.Column="1"
                                       HorizontalAlignment="Right"
                                       Text="{res:Loc CloudProvider_UploadInFlightAggressive}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        </Grid>
                    </StackPanel>

                    <TextBlock x:Name="UploadInFlightValue"
                               Grid.Column="1"
                               MinWidth="64"
                               TextAlignment="Right"
                               VerticalAlignment="Top"
                               Margin="12,0,0,0"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                </Grid>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
