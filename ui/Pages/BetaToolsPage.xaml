<Page x:Class="CloudRedirect.Pages.BetaToolsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:res="clr-namespace:CloudRedirect.Resources"
      ScrollViewer.CanContentScroll="False">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,14">
        <StackPanel MaxWidth="1320" HorizontalAlignment="Stretch">

            <!-- Page Header -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Beta Power Tools"
                                   FontSize="24" FontWeight="Bold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <Border Background="#2D1F08" BorderBrush="#D18911" BorderThickness="1"
                                CornerRadius="4" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="BETA CHANNEL EXCLUSIVE" FontSize="11" FontWeight="Bold" Foreground="#E5A130" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Experimental power tools, LAN sync, multi-slot character manager, and performance suite."
                               FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" />
                </StackPanel>
            </Grid>

            <!-- Navigation Tabs / Mode Selector -->
            <Border Background="#101923" BorderBrush="#1E2F40" BorderThickness="1" CornerRadius="8" Padding="6" Margin="0,0,0,16">
                <UniformGrid Columns="5">
                    <RadioButton x:Name="TabArchivesBtn" GroupName="BetaTabs" IsChecked="True" Checked="Tab_Checked"
                                 Style="{StaticResource {x:Type ToggleButton}}" Background="Transparent" BorderThickness="0"
                                 Cursor="Hand" Padding="8,8">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <ui:SymbolIcon Symbol="Archive24" FontSize="16" Foreground="#66C0F4" Margin="0,0,8,0" />
                            <TextBlock Text="Archives &amp; Snapshots" FontWeight="SemiBold" FontSize="12" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="TabSlotsBtn" GroupName="BetaTabs" Checked="Tab_Checked"
                                 Style="{StaticResource {x:Type ToggleButton}}" Background="Transparent" BorderThickness="0"
                                 Cursor="Hand" Padding="8,8">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <ui:SymbolIcon Symbol="People24" FontSize="16" Foreground="#A4D007" Margin="0,0,8,0" />
                            <TextBlock Text="Character Slots &amp; Mods" FontWeight="SemiBold" FontSize="12" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="TabStorageBtn" GroupName="BetaTabs" Checked="Tab_Checked"
                                 Style="{StaticResource {x:Type ToggleButton}}" Background="Transparent" BorderThickness="0"
                                 Cursor="Hand" Padding="8,8">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <ui:SymbolIcon Symbol="Storage24" FontSize="16" Foreground="#E5A130" Margin="0,0,8,0" />
                            <TextBlock Text="Storage &amp; Shaders" FontWeight="SemiBold" FontSize="12" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="TabLanBtn" GroupName="BetaTabs" Checked="Tab_Checked"
                                 Style="{StaticResource {x:Type ToggleButton}}" Background="Transparent" BorderThickness="0"
                                 Cursor="Hand" Padding="8,8">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <ui:SymbolIcon Symbol="Wifi224" FontSize="16" Foreground="#00D2FF" Margin="0,0,8,0" />
                            <TextBlock Text="Mobile &amp; LAN P2P" FontWeight="SemiBold" FontSize="12" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="TabPerformanceBtn" GroupName="BetaTabs" Checked="Tab_Checked"
                                 Style="{StaticResource {x:Type ToggleButton}}" Background="Transparent" BorderThickness="0"
                                 Cursor="Hand" Padding="8,8">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <ui:SymbolIcon Symbol="Flash24" FontSize="16" Foreground="#BD3944" Margin="0,0,8,0" />
                            <TextBlock Text="Booster &amp; Presence" FontWeight="SemiBold" FontSize="12" />
                        </StackPanel>
                    </RadioButton>
                </UniformGrid>
            </Border>

            <!-- ========================================== -->
            <!-- TAB 1: ARCHIVES, SNAPSHOTS & RE-SIGNER     -->
            <!-- ========================================== -->
            <StackPanel x:Name="SectionArchives" Visibility="Visible">
                <!-- 1-Click Save Export & Import Card -->
                <ui:CardControl Margin="0,0,0,14">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="18" Foreground="#66C0F4" Margin="0,0,8,0" />
                                <TextBlock Text="1-Click Save Export &amp; Import (.zip Archive / Backup / Sharing)" FontWeight="Bold" FontSize="14" />
                            </StackPanel>
                            <TextBlock Text="Pack your saves into a portable, standard .zip file for offline backups or sharing. Importing automatically takes a pre-import safety snapshot."
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                    </ui:CardControl.Header>

                    <StackPanel Margin="0,8,0,0">
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Game / Save Folder:" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="#8F98A0" />
                            <ui:TextBox Grid.Column="1" x:Name="ExportSavePathBox" Height="34" Margin="0,0,8,0"
                                        PlaceholderText="Choose a save directory or select from active game..." />
                            <ui:Button Grid.Column="2" Content="Browse..." Appearance="Secondary" Click="BrowseSaveExport_Click" />
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <ui:Button Content="Export to .ZIP Archive" Icon="{ui:SymbolIcon ArrowUpload24}" Appearance="Primary"
                                       Margin="0,0,10,0" Click="ExportZip_Click" />
                            <ui:Button Content="Import from .ZIP Archive..." Icon="{ui:SymbolIcon ArrowDownload24}" Appearance="Secondary"
                                       Click="ImportZip_Click" />
                        </StackPanel>
                        <TextBlock x:Name="ExportImportStatusText" Text="" Margin="0,8,0,0" FontWeight="SemiBold" Visibility="Collapsed" />
                    </StackPanel>
                </ui:CardControl>

                <!-- Save Snapshot Vault & Pinning (Auto-Purge Immunity) -->
                <ui:CardControl Margin="0,0,0,14">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Pin24" FontSize="18" Foreground="#00D2FF" Margin="0,0,8,0" />
                                <TextBlock Text="Save Snapshot Vault &amp; Pinning (Auto-Purge Immunity)" FontWeight="Bold" FontSize="14" />
                            </StackPanel>
                            <TextBlock Text="Inspect local point-in-time save backups. Pinned snapshots are permanently immune to auto-purge and disk cleanups."
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                    </ui:CardControl.Header>

                    <StackPanel Margin="0,8,0,0">
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Select Game:" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="#8F98A0" />
                            <ComboBox Grid.Column="1" x:Name="SnapshotGamesCombo" Height="34" Margin="0,0,8,0" SelectionChanged="SnapshotGamesCombo_SelectionChanged" />
                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <ui:Button Content="+ Instant Snapshot" Appearance="Primary" Margin="0,0,6,0" Click="TakeInstantSnapshot_Click" />
                                <ui:Button Content="Refresh" Appearance="Secondary" Icon="{ui:SymbolIcon ArrowSync24}" Click="RefreshSnapshots_Click" />
                            </StackPanel>
                        </Grid>

                        <Border Background="#101822" BorderBrush="#1E2C3B" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,4,0,0">
                            <StackPanel>
                                <TextBlock Text="Available Snapshots" FontWeight="SemiBold" FontSize="13" Foreground="#66C0F4" Margin="0,0,0,8" />
                                <ListBox x:Name="SnapshotsListBox" MaxHeight="240" Background="Transparent" BorderThickness="0">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#162332" BorderBrush="#253D56" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF" />
                                                            <Border Visibility="{Binding IsPinned, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                    Background="#1A2D3A" BorderBrush="#00D2FF" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="8,0,0,0">
                                                                <TextBlock Text="📌 PINNED (Protected)" FontSize="10" FontWeight="Bold" Foreground="#00D2FF" />
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding TriggerReason}" FontSize="12" Foreground="#8F98A0" Margin="0,2,0,0" />
                                                        <TextBlock Text="{Binding FormattedDetails}" FontSize="11" Foreground="#66C0F4" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <ui:Button Content="{Binding PinButtonText}" Appearance="{Binding PinButtonAppearance}" Margin="0,0,6,0" Tag="{Binding}" Click="TogglePinSnapshot_Click" />
                                                        <ui:Button Content="⏪ Restore" Appearance="Caution" Margin="0,0,6,0" Tag="{Binding}" Click="RestoreSnapshot_Click" />
                                                        <ui:Button Content="Delete" Appearance="Danger" Tag="{Binding}" Click="DeleteSnapshot_Click" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock x:Name="NoSnapshotsNotice" Text="No snapshots found for this game. Click '+ Instant Snapshot' to create a backup." FontSize="12" Foreground="#8F98A0" Margin="4,4,0,0" Visibility="Collapsed" />
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="SnapshotStatusText" Text="" Margin="0,8,0,0" FontWeight="SemiBold" Visibility="Collapsed" />
                    </StackPanel>
                </ui:CardControl>

                <!-- SteamID64 Re-signer / Account Transfer Tool -->
                <ui:CardControl Margin="0,0,0,14">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="PersonSwap24" FontSize="18" Foreground="#A4D007" Margin="0,0,8,0" />
                                <TextBlock Text="SteamID64 Re-signer &amp; Account Transfer Tool" FontWeight="Bold" FontSize="14" />
                            </StackPanel>
                            <TextBlock Text="Transfer save files between different Steam accounts or emulators (e.g. Goldberg/CODEX to genuine Steam). Recursively patches 64-bit/32-bit IDs and renames user folders."
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                    </ui:CardControl.Header>

                    <StackPanel Margin="0,8,0,0">
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Source SteamID64:" VerticalAlignment="Center" Foreground="#8F98A0" />
                            <ui:TextBox Grid.Column="1" x:Name="OldSteamIdBox" Text="76561197960287930" Height="32" Margin="0,0,8,0" />
                            <ui:Button Grid.Column="2" Content="Preset: Emulator" Appearance="Secondary" Click="PresetEmulatorId_Click" />
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Target SteamID64:" VerticalAlignment="Center" Foreground="#8F98A0" />
                            <ui:TextBox Grid.Column="1" x:Name="NewSteamIdBox" Height="32" Margin="0,0,8,0" PlaceholderText="Enter destination SteamID64 (17 digits)..." />
                            <ui:Button Grid.Column="2" Content="Detect My SteamID" Appearance="Secondary" Click="DetectMySteamId_Click" />
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Save Folder to Re-sign:" VerticalAlignment="Center" Foreground="#8F98A0" />
                            <ui:TextBox Grid.Column="1" x:Name="ResignFolderBox" Height="32" Margin="0,0,8,0" PlaceholderText="Path to save directory containing old account files..." />
                            <ui:Button Grid.Column="2" Content="Browse Folder..." Appearance="Secondary" Click="BrowseResignFolder_Click" />
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <ui:Button Content="Re-sign &amp; Transfer Save" Icon="{ui:SymbolIcon Checkmark24}" Appearance="Success" Click="RunResign_Click" />
                        </StackPanel>
                        <TextBlock x:Name="ResignStatusText" Text="" Margin="0,8,0,0" FontWeight="SemiBold" Visibility="Collapsed" />
                    </StackPanel>
                </ui:CardControl>
            </StackPanel>

            <!-- ========================================== -->
            <!-- TAB 2: CHARACTER SWITCHER & MOD SNAPSHOT   -->
            <!-- ========================================== -->
            <StackPanel x:Name="SectionSlots" Visibility="Collapsed">
                <ui:CardControl Margin="0,0,0,14">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="PeopleTeam24" FontSize="18" Foreground="#A4D007" Margin="0,0,8,0" />
                                <TextBlock Text="Character Switcher (Multi-Slot Manager)" FontWeight="Bold" FontSize="14" />
                            </StackPanel>
                            <TextBlock Text="Manage multiple isolated character builds or separate playthrough slots for any game. Switching automatically saves and preserves active progress."
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                    </ui:CardControl.Header>

                    <StackPanel Margin="0,8,0,0">
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Target Game:" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="#8F98A0" />
                            <ComboBox Grid.Column="1" x:Name="SlotsGameCombo" Height="34" Margin="0,0,8,0" SelectionChanged="SlotsGameCombo_SelectionChanged" />
                            <ui:Button Grid.Column="2" Content="+ New Character Slot" Appearance="Primary" Click="CreateSlotDialog_Click" />
                        </Grid>

                        <!-- Slot List -->
                        <Border Background="#101822" BorderBrush="#1E2C3B" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,4,0,0">
                            <StackPanel>
                                <TextBlock Text="Configured Character Slots" FontWeight="SemiBold" FontSize="13" Foreground="#66C0F4" Margin="0,0,0,8" />
                                <ListBox x:Name="CharacterSlotsList" Background="Transparent" BorderThickness="0">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#162332" BorderBrush="#253D56" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" Foreground="#FFFFFF" />
                                                            <Border Visibility="{Binding IsActive, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                    Background="#1A2D22" BorderBrush="#4C7515" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="8,0,0,0">
                                                                <TextBlock Text="ACTIVE SLOT 🟢" FontSize="10" FontWeight="Bold" Foreground="#A4D007" />
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Notes}" FontSize="12" Foreground="#8F98A0" Margin="0,2,0,0" />
                                                        <TextBlock Text="{Binding FormattedSize, StringFormat='Size: {0}'}" FontSize="11" Foreground="#66C0F4" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <ui:Button Content="Switch to Slot" Appearance="Success" Margin="0,0,6,0" Tag="{Binding Name}" Click="SwitchSlot_Click" />
                                                        <ui:Button Content="Delete" Appearance="Danger" Tag="{Binding Name}" Click="DeleteSlot_Click" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ui:CardControl>

                <!-- Game Mod & Load-Order Snapshot Card -->
                <ui:CardControl Margin="0,0,0,14">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Code24" FontSize="18" Foreground="#00D2FF" Margin="0,0,8,0" />
                                <TextBlock Text="Game Mod &amp; Load-Order Snapshot" FontWeight="Bold" FontSize="14" />
                            </StackPanel>
                            <TextBlock Text="Catalogs active mods, plugins, and load-order files alongside save snapshots to detect missing or conflicting mods when loading saves."
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <StackPanel Margin="0,8,0,0">
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Game Install Directory:" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="#8F98A0" />
                            <ui:TextBox Grid.Column="1" x:Name="ModGameDirBox" Height="32" Margin="0,0,8,0" PlaceholderText="Path to game root folder containing mods/plugins..." />
                            <ui:Button Grid.Column="2" Content="Browse..." Appearance="Secondary" Click="BrowseModGameDir_Click" />
                        </Grid>
                        <StackPanel Orientation="Horizontal">
                            <ui:Button Content="Capture Mod Snapshot" Icon="{ui:SymbolIcon Camera24}" Appearance="Primary" Click="CaptureModSnapshot_Click" Margin="0,0,8,0" />
                            <ui:Button Content="Compare with Current State" Icon="{ui:SymbolIcon ArrowSync24}" Appearance="Secondary" Click="CompareModSnapshot_Click" />
                        </StackPanel>
                        <TextBlock x:Name="ModSnapshotStatusText" Text="" Margin="0,8,0,0" FontWeight="SemiBold" Visibility="Collapsed" />
                    </StackPanel>
                </ui:CardControl>
            </StackPanel>

            <!-- ========================================== -->
            <!-- TAB 3: STORAGE BREAKDOWN & SHADER CLEANER  -->
            <!-- ========================================== -->
            <StackPanel x:Name="SectionStorage" Visibility="Collapsed">
                <!-- Visual Storage Breakdown Card -->
                <ui:CardControl Margin="0,0,0,14">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="DataPie24" FontSize="18" Foreground="#E5A130" Margin="0,0,8,0" />
                                <TextBlock Text="Cloud Storage Quota &amp; Breakdown Visualizer" FontWeight="Bold" FontSize="14" />
                            </StackPanel>
                            <TextBlock Text="Detailed disk breakdown across cloud storage, snapshot vaults, character slots, and top consuming games."
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" />
                        </StackPanel>
                    </ui:CardControl.Header>

                    <StackPanel Margin="0,8,0,0">
                        <!-- Metrics Cards -->
                        <UniformGrid Columns="4" Margin="0,0,0,12">
                            <Border Background="#121D28" BorderBrush="#1E2F40" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="Cloud Saves" FontSize="11" Foreground="#8F98A0" />
                                    <TextBlock x:Name="MetricCloudSavesText" Text="Calculating..." FontSize="16" FontWeight="Bold" Foreground="#66C0F4" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Background="#121D28" BorderBrush="#1E2F40" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="Snapshot Vaults" FontSize="11" Foreground="#8F98A0" />
                                    <TextBlock x:Name="MetricSnapshotsText" Text="Calculating..." FontSize="16" FontWeight="Bold" Foreground="#E5A130" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Background="#121D28" BorderBrush="#1E2F40" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="Character Slots" FontSize="11" Foreground="#8F98A0" />
                                    <TextBlock x:Name="MetricSlotsText" Text="Calculating..." FontSize="16" FontWeight="Bold" Foreground="#A4D007" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Background="#121D28" BorderBrush="#1E2F40" BorderThickness="1" CornerRadius="6" Padding="12,8">
                                <StackPanel>
                                    <TextBlock Text="Free Disk Space" FontSize="11" Foreground="#8F98A0" />
                                    <TextBlock x:Name="MetricDiskFreeText" Text="Calculating..." FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <ui:Button Content="Refresh Storage Metrics" Icon="{ui:SymbolIcon ArrowSync24}" Appearance="Secondary" Click="RefreshStorage_Click" HorizontalAlignment="Left" />
                    </StackPanel>
                </ui:CardControl>

                <!-- Orphan Steam Shader Cache Cleaner -->
                <ui:CardControl Margin="0,0,0,14">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Broom24" FontSize="18" Foreground="#FF4C4C" Margin="0,0,8,0" />
                                <TextBlock Text="Orphan Steam Shader Cache Cleaner" FontWeight="Bold" FontSize="14" />
                            </StackPanel>
                            <TextBlock Text="Scans steamapps/shadercache across all Steam library folders to find left-behind pipeline shaders for uninstalled games."
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                    </ui:CardControl.Header>

                    <StackPanel Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <ui:Button Content="Scan for Orphan Shaders" Icon="{ui:SymbolIcon Search24}" Appearance="Primary" Click="ScanShaders_Click" Margin="0,0,8,0" />
                            <ui:Button x:Name="CleanShadersBtn" Content="Clean Orphan Shaders" Icon="{ui:SymbolIcon Delete24}" Appearance="Danger" Click="CleanShaders_Click" IsEnabled="False" />
                        </StackPanel>

                        <TextBlock x:Name="ShaderScanSummaryText" Text="Click Scan to detect orphaned Steam shader caches." FontSize="13" Foreground="#8F98A0" Margin="0,0,0,8" />

                        <ListBox x:Name="ShaderCachesListBox" MaxHeight="220" Background="#101822" BorderBrush="#1E2C3B" BorderThickness="1">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel LastChildFill="True" Margin="8,4">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding FormattedSize}" FontWeight="Bold" Foreground="#E5A130" Margin="12,0,0,0" VerticalAlignment="Center" />
                                        <StackPanel>
                                            <TextBlock Text="{Binding GameName}" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                            <TextBlock Text="{Binding DirectoryPath}" FontSize="11" Foreground="#8F98A0" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </ui:CardControl>
            </StackPanel>

            <!-- ========================================== -->
            <!-- TAB 4: MOBILE & LOCAL LAN P2P             -->
            <!-- ========================================== -->
            <StackPanel x:Name="SectionLan" Visibility="Collapsed">
                <!-- Mobile Phone LAN Dashboard Card -->
                <ui:CardControl Margin="0,0,0,14">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Phone24" FontSize="18" Foreground="#00D2FF" Margin="0,0,8,0" />
                                <TextBlock Text="Mobile Phone LAN Dashboard" FontWeight="Bold" FontSize="14" />
                            </StackPanel>
                            <TextBlock Text="Host an interactive Steam-styled web dashboard on your local Wi-Fi. Monitor active games and trigger snapshots directly from your smartphone or tablet."
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                    </ui:CardControl.Header>

                    <StackPanel Margin="0,8,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- QR Code Preview -->
                            <Border Grid.Column="0" Background="#FFFFFF" Padding="8" CornerRadius="8" Width="140" Height="140" Margin="0,0,16,0" VerticalAlignment="Top">
                                <Image x:Name="MobileQrImage" Stretch="Uniform" />
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                                    <ui:ToggleSwitch x:Name="MobileServerToggle" Checked="MobileServerToggle_Changed" Unchecked="MobileServerToggle_Changed" />
                                    <TextBlock x:Name="MobileServerStatusText" Text="Dashboard Active" FontWeight="SemiBold" Foreground="#A4D007" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>

                                <TextBlock Text="Scan the QR Code with your phone camera or visit:" FontSize="12" Foreground="#8F98A0" />
                                <ui:TextBox x:Name="MobileUrlBox" IsReadOnly="True" Height="32" Margin="0,4,0,10" Foreground="#66C0F4" FontWeight="Bold" />
                                <ui:Button Content="Open in Browser" Appearance="Secondary" Icon="{ui:SymbolIcon Globe24}" Click="OpenMobileDashboardBrowser_Click" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ui:CardControl>

                <!-- Local LAN P2P Quick-Sync (Direct PC ↔ Steam Deck) -->
                <ui:CardControl Margin="0,0,0,14">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Tv24" FontSize="18" Foreground="#A4D007" Margin="0,0,8,0" />
                                <TextBlock Text="Local LAN P2P Quick-Sync (Direct PC ↔️ Steam Deck / Handheld)" FontWeight="Bold" FontSize="14" />
                            </StackPanel>
                            <TextBlock Text="Direct zero-configuration UDP discovery and gigabit transfer between PC, Steam Deck, ROG Ally, and gaming laptops on the same Wi-Fi."
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                    </ui:CardControl.Header>

                    <StackPanel Margin="0,8,0,0">
                        <TextBlock Text="Discovered Devices on Local Network:" FontWeight="SemiBold" FontSize="13" Foreground="#66C0F4" Margin="0,0,0,8" />
                        <ListBox x:Name="LanPeersListBox" MaxHeight="180" Background="#101822" BorderBrush="#1E2C3B" BorderThickness="1" Margin="0,0,0,10">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#162332" BorderBrush="#253D56" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,4">
                                        <DockPanel LastChildFill="True">
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                <ui:Button Content="Push Save ➔" Appearance="Primary" Margin="0,0,6,0" Tag="{Binding}" Click="P2PPush_Click" />
                                                <ui:Button Content="Pull Save ⬅" Appearance="Secondary" Tag="{Binding}" Click="P2PPull_Click" />
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock Text="{Binding DisplayTitle}" FontWeight="Bold" Foreground="#FFFFFF" />
                                                <TextBlock Text="{Binding IpAddress, StringFormat='IP: {0}'}" FontSize="11" Foreground="#8F98A0" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="NoPeersNotice" Text="Searching for local Steam Decks and PCs via UDP beacon (port 38401)..." FontSize="12" Foreground="#8F98A0" />
                    </StackPanel>
                </ui:CardControl>
            </StackPanel>

            <!-- ========================================== -->
            <!-- TAB 5: BOOSTER, PRESENCE & SHELL MENU      -->
            <!-- ========================================== -->
            <StackPanel x:Name="SectionPerformance" Visibility="Collapsed">
                <!-- Active Game Priority & Performance Auto-Booster -->
                <ui:CardControl Margin="0,0,0,14">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="Active Game Priority &amp; Performance Auto-Booster" FontWeight="Bold" FontSize="14" />
                            <TextBlock Text="Elevates running game process priority to AboveNormal/High while throttling CloudRedirect's background CPU/IO priority during gameplay to eliminate any frame drops."
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:ToggleSwitch x:Name="BoosterToggle" Checked="BoosterToggle_Changed" Unchecked="BoosterToggle_Changed" />
                </ui:CardControl>

                <!-- Spoof Spacewar broadcast into use real game name -->
                <ui:CardControl Margin="0,0,0,14">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="Spoof Spacewar Broadcast into Real Game Name" FontWeight="Bold" FontSize="14" />
                            <TextBlock Text="Intercepts games launching under AppID 480 (Spacewar) or generic wrappers, extracts the true game title, and broadcasts the real title to CloudRedirect, System Tray, and Rich Presence."
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:ToggleSwitch x:Name="SpacewarSpooferToggle" Checked="SpacewarSpooferToggle_Changed" Unchecked="SpacewarSpooferToggle_Changed" />
                </ui:CardControl>

                <!-- Steam & Windows Explorer Right-Click Context Menu -->
                <ui:CardControl Margin="0,0,0,14">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="Steam Library &amp; File Explorer Right-Click Menu" FontWeight="Bold" FontSize="14" />
                            <TextBlock Text="Integrate right-click actions into Windows File Explorer and Steam client for 1-Click Save Export (.zip), SteamID64 Re-signing, and Instant Save Snapshots."
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:ToggleSwitch x:Name="ContextMenuToggle" Checked="ContextMenuToggle_Changed" Unchecked="ContextMenuToggle_Changed" />
                </ui:CardControl>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
