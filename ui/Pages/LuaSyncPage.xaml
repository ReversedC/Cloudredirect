<Page x:Class="CloudRedirect.Pages.LuaSyncPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:res="clr-namespace:CloudRedirect.Resources"
      xmlns:conv="clr-namespace:CloudRedirect.Converters"
      ScrollViewer.CanContentScroll="False">

    <Page.Resources>
        <conv:UrlToImageSourceConverter x:Key="UrlToImageSource" />
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel MaxWidth="860">
            <!-- Header Title -->
            <TextBlock Text="{res:Loc LuaSync_Title}"
                       FontSize="26" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                       Margin="0,0,0,4" />

            <TextBlock Text="{res:Loc LuaSync_Subtitle}"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,16" />

            <!-- Progress Bar (Visible during sync operations) -->
            <Border x:Name="ProgressCard"
                    Visibility="Collapsed"
                    Background="#16222F"
                    BorderBrush="#253A4E"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="14"
                    Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock x:Name="ProgressStatusText"
                               Text="Processing..."
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               Margin="0,0,0,8" />
                    <ProgressBar x:Name="SyncProgressBar"
                                 Height="4"
                                 Minimum="0" Maximum="100" Value="0"
                                 IsIndeterminate="False"
                                 Foreground="#00D2FF" />
                </StackPanel>
            </Border>

            <!-- Action Toolbar -->
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="14"
                    Margin="0,0,0,16">
                <StackPanel>
                    <!-- Row 1: Actions -->
                    <WrapPanel Margin="0,0,0,10">
                        <ui:Button x:Name="SelectAllBtn"
                                   Content="{res:Loc LuaSync_SelectAll}"
                                   Icon="{ui:SymbolIcon CheckmarkSquare24}"
                                   Appearance="Secondary"
                                   Margin="0,0,8,6"
                                   Cursor="Hand"
                                   Click="SelectAll_Click" />

                        <ui:Button x:Name="BackupBtn"
                                   Content="{res:Loc LuaSync_BackupSelected}"
                                   Icon="{ui:SymbolIcon CloudArrowUp24}"
                                   Background="#162B3D"
                                   BorderBrush="#00D2FF"
                                   Foreground="#00D2FF"
                                   FontWeight="SemiBold"
                                   Margin="0,0,8,6"
                                   Cursor="Hand"
                                   Click="BackupSelected_Click" />

                        <ui:Button x:Name="RestoreSelectedBtn"
                                   Content="{res:Loc LuaSync_RestoreSelected}"
                                   Icon="{ui:SymbolIcon ArrowDownload24}"
                                   Appearance="Success"
                                   Background="#FF5C7E10"
                                   BorderBrush="#FF75B022"
                                   Foreground="#FFFFFFFF"
                                   FontWeight="SemiBold"
                                   Margin="0,0,8,6"
                                   Cursor="Hand"
                                   Click="RestoreSelected_Click" />

                        <ui:Button x:Name="RestoreAllBtn"
                                   Content="{res:Loc LuaSync_RestoreAll}"
                                   Icon="{ui:SymbolIcon ArrowDownload24}"
                                   Appearance="Secondary"
                                   Margin="0,0,8,6"
                                   Cursor="Hand"
                                   Click="RestoreAll_Click" />

                        <ui:Button x:Name="DeleteCloudBtn"
                                   Content="{res:Loc LuaSync_DeleteCloud}"
                                   Icon="{ui:SymbolIcon Delete24}"
                                   Appearance="Danger"
                                   Margin="0,0,8,6"
                                   Cursor="Hand"
                                   Click="DeleteCloud_Click" />

                        <ui:Button x:Name="RefreshBtn"
                                   Icon="{ui:SymbolIcon ArrowSync24}"
                                   ToolTip="{res:Loc LuaSync_Refresh}"
                                   Appearance="Secondary"
                                   Margin="0,0,0,6"
                                   Cursor="Hand"
                                   Click="Refresh_Click" />
                    </WrapPanel>

                    <!-- Row 2: Search + Filter Chips -->
                    <DockPanel>
                        <!-- Search Box -->
                        <ui:TextBox x:Name="SearchBox"
                                    PlaceholderText="{res:Loc LuaSync_SearchPlaceholder}"
                                    Width="260"
                                    HorizontalAlignment="Left"
                                    TextChanged="SearchBox_TextChanged"
                                    Margin="0,0,16,0" />

                        <!-- Filter Chips -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <RadioButton x:Name="FilterAllRadio"
                                         Content="{res:Loc LuaSync_FilterAll}"
                                         IsChecked="True"
                                         GroupName="FilterGroup"
                                         Checked="Filter_Checked"
                                         Margin="0,0,12,0" />
                            <RadioButton x:Name="FilterLocalRadio"
                                         Content="{res:Loc LuaSync_FilterLocal}"
                                         GroupName="FilterGroup"
                                         Checked="Filter_Checked"
                                         Margin="0,0,12,0" />
                            <RadioButton x:Name="FilterCloudRadio"
                                         Content="{res:Loc LuaSync_FilterCloud}"
                                         GroupName="FilterGroup"
                                         Checked="Filter_Checked"
                                         Margin="0,0,12,0" />
                            <RadioButton x:Name="FilterSyncedRadio"
                                         Content="{res:Loc LuaSync_FilterSynced}"
                                         GroupName="FilterGroup"
                                         Checked="Filter_Checked" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- Loading Spinner -->
            <StackPanel x:Name="LoadingPanel" Margin="0,32,0,32" HorizontalAlignment="Center">
                <ui:ProgressRing IsIndeterminate="True" Width="40" Height="40" />
                <TextBlock Text="{res:Loc LuaSync_LoadingGames}"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           HorizontalAlignment="Center" Margin="0,12,0,0" />
            </StackPanel>

            <!-- Empty State -->
            <Border x:Name="EmptyStateBorder"
                    Visibility="Collapsed"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="32"
                    Margin="0,0,0,16">
                <StackPanel HorizontalAlignment="Center">
                    <ui:SymbolIcon Symbol="Code24" FontSize="36"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   HorizontalAlignment="Center" Margin="0,0,0,12" />
                    <TextBlock Text="{res:Loc LuaSync_NoItemsFound}"
                               FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               HorizontalAlignment="Center" Margin="0,0,0,4" />
                    <TextBlock Text="{res:Loc LuaSync_NoItemsHint}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- Games List -->
            <ItemsControl x:Name="GamesList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="5"
                                Padding="12,10"
                                Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Selection Checkbox -->
                                <CheckBox Grid.Column="0"
                                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                          VerticalAlignment="Center"
                                          Margin="0,0,12,0" />

                                <!-- Game Poster Capsule -->
                                <Border Grid.Column="1"
                                        Width="105" Height="49"
                                        CornerRadius="4"
                                        Margin="0,0,14,0"
                                        VerticalAlignment="Center"
                                        ClipToBounds="True">
                                    <Border.Background>
                                        <ImageBrush ImageSource="{Binding HeaderUrl, Converter={StaticResource UrlToImageSource}}"
                                                    Stretch="UniformToFill"
                                                    RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Border.Background>
                                </Border>

                                <!-- Game Details (Name + AppID + Size/Date) -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding GameName}"
                                               FontSize="15" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis" />

                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                        <!-- App ID Badge -->
                                        <Border Background="#16222F" BorderBrush="#253A4E" BorderThickness="1"
                                                CornerRadius="3" Padding="5,1" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding AppId, StringFormat='AppID: {0}'}"
                                                       FontSize="11" FontWeight="SemiBold"
                                                       Foreground="#8F98A0" />
                                        </Border>

                                        <!-- Encryption tag -->
                                        <Border Background="#122332" BorderBrush="#0080A8" BorderThickness="1"
                                                CornerRadius="3" Padding="5,1" Margin="0,0,8,0">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="LockClosed16" FontSize="11" Foreground="#00D2FF" Margin="0,0,4,0" />
                                                <TextBlock Text="AES-256" FontSize="11" Foreground="#00D2FF" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Status Badge Pill -->
                                <Border Grid.Column="3"
                                        VerticalAlignment="Center"
                                        Padding="10,4"
                                        CornerRadius="12"
                                        Background="{Binding StatusBadgeBg}">
                                    <TextBlock Text="{Binding StatusText}"
                                               FontSize="12" FontWeight="SemiBold"
                                               Foreground="{Binding StatusBadgeColor}" />
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
