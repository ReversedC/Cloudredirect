<Page x:Class="CloudRedirect.Pages.RemotePlayPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:res="clr-namespace:CloudRedirect.Resources"
      ScrollViewer.CanContentScroll="False">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,14">
        <StackPanel MaxWidth="920" HorizontalAlignment="Stretch">

            <!-- Hero Header -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="SUO LINK"
                                   FontSize="24" FontWeight="Bold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <Border Background="#1C354A" BorderBrush="#2563EB" BorderThickness="1"
                                CornerRadius="12" Padding="10,2" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="GAMEHUB REMOTE PLAY" FontSize="10" FontWeight="Bold" Foreground="#66C0F4" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Stream your PC games to your phone with unrestricted GameHub virtual controls and zero setup."
                               FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" />
                </StackPanel>

                <!-- Server Toggle & Live Status Badge -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="ServerStatusPill"
                            Background="#183321" BorderBrush="#3B6B22" BorderThickness="1"
                            CornerRadius="16" Padding="12,6" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="ServerStatusDot" Width="8" Height="8" Fill="#A4D007" Margin="0,0,6,0" />
                            <TextBlock x:Name="ServerStatusText" Text="SERVER ONLINE" FontSize="11" FontWeight="Bold" Foreground="#A4D007" />
                        </StackPanel>
                    </Border>

                    <ui:Button x:Name="ToggleServerBtn"
                               Content="Stop Host"
                               Appearance="Secondary"
                               Icon="{ui:SymbolIcon Power24}"
                               Click="ToggleServer_Click"
                               Padding="14,6"
                               Cursor="Hand" />
                </StackPanel>
            </Grid>

            <!-- MAIN CONNECTION CARD -->
            <Border Background="#121A24" BorderBrush="#22364A" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: QR Code Canvas with Mode Label -->
                    <Border Grid.Column="0" Background="#0B0E14" BorderBrush="#1E2E3E" BorderThickness="1" CornerRadius="10" Padding="14" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel HorizontalAlignment="Center">
                            <Image x:Name="QrCodeImage" Width="180" Height="180" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                            <Border Background="#132338" BorderBrush="#24374A" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,8,0,0">
                                <TextBlock x:Name="QrBadgeText" Text="📶 WI-FI (LOCAL LAN)" FontSize="10" FontWeight="Bold" Foreground="#66C0F4" HorizontalAlignment="Center" />
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Right: Network Mode Selector, Quick Steps, Full-Width URL & Actions -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <!-- Mode Tabs (Wi-Fi vs Remote Internet) -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Instant Connect (Auto-Setup)" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock x:Name="ModeHintText" Text="Scan QR with your phone camera or the SUO Link app to connect instantly:" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" />
                            </StackPanel>

                            <!-- Network Mode Switcher -->
                            <Border Grid.Column="1" Background="#0E1620" BorderBrush="#1E2E3E" BorderThickness="1" CornerRadius="8" Padding="2">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="WifiModeRadio" Content="📶 Local Wi-Fi (Home LAN)" Style="{DynamicResource DefaultRadioButtonStyle}" IsChecked="True" Checked="NetworkMode_Checked" Margin="2,0" Padding="10,4" FontSize="11" FontWeight="SemiBold" Cursor="Hand" />
                                    <RadioButton x:Name="SmartModeRadio" Content="⚡ Smart Auto (All Networks)" Style="{DynamicResource DefaultRadioButtonStyle}" Checked="NetworkMode_Checked" Margin="2,0" Padding="10,4" FontSize="11" FontWeight="SemiBold" Cursor="Hand" />
                                    <RadioButton x:Name="RemoteModeRadio" Content="🌐 Remote (4G/5G Away)" Style="{DynamicResource DefaultRadioButtonStyle}" Checked="NetworkMode_Checked" Margin="2,0" Padding="10,4" FontSize="11" FontWeight="SemiBold" Cursor="Hand" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Multi-Network Guidance Explainer Banner -->
                        <Border Background="#162230" BorderBrush="#263A4E" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="💡" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" x:Name="ModeExplainerText"
                                           Text="⚡ Smart Auto: Scan from phone on ANY network. Auto-connects via Wi-Fi (&lt;1ms) or Cloudflare Tunnel (4G/5G)!"
                                           FontSize="11" Foreground="#00D2FF" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
                            </Grid>
                        </Border>

                        <!-- Quick 2-Step Compact Banner -->
                        <Border Background="#162230" BorderBrush="#263A4E" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="20" Height="20" CornerRadius="10" Background="#1C354A" Margin="0,0,8,0">
                                        <TextBlock Text="1" FontWeight="Bold" FontSize="11" Foreground="#66C0F4" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="Open SUO Link on phone" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="➔" FontSize="12" Foreground="#4A657D" VerticalAlignment="Center" Margin="8,0" />
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="20" Height="20" CornerRadius="10" Background="#1C354A" Margin="0,0,8,0">
                                        <TextBlock Text="2" FontWeight="Bold" FontSize="11" Foreground="#66C0F4" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="Scan QR code on screen" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Full-Width URL Box & Action Buttons -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ServerUrlBox"
                                     IsReadOnly="True"
                                     Height="36"
                                     VerticalContentAlignment="Center"
                                     Background="#0E1620"
                                     Foreground="#66C0F4"
                                     BorderBrush="#253A4E"
                                     FontFamily="Consolas, monospace"
                                     FontSize="12"
                                     Padding="8,0" />

                            <ui:Button Grid.Column="1"
                                       Content="Copy Link"
                                       Icon="{ui:SymbolIcon Copy24}"
                                       Appearance="Secondary"
                                       Click="CopyUrl_Click"
                                       Height="36"
                                       Margin="8,0,0,0" />

                            <ui:Button Grid.Column="2"
                                       Content="Open Browser"
                                       Icon="{ui:SymbolIcon Globe24}"
                                       Appearance="Secondary"
                                       Click="OpenBrowser_Click"
                                       Height="36"
                                       Margin="8,0,0,0" />
                        </Grid>

                        <!-- APK Download & Mobile Install Info -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:Button x:Name="DownloadApkBtn"
                                       Content="Get SUO-Link.apk (For Android)"
                                       Icon="{ui:SymbolIcon ArrowDownload24}"
                                       Background="#FF5C7E10"
                                       BorderBrush="#FF75B022"
                                       Foreground="#FFFFFFFF"
                                       FontWeight="SemiBold"
                                       Click="DownloadApk_Click"
                                       Height="34"
                                       Margin="0,0,12,0" />

                            <TextBlock x:Name="ApkStatusText"
                                       Text="APK ready (72 KB) • Also downloadable on phone by scanning QR"
                                       FontSize="11"
                                       Foreground="#A4D007"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2-COLUMN SETTINGS: Quality & Live Network Engine -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left Column: Stream Quality & Performance -->
                <Border Grid.Column="0" Background="#141E2B" BorderBrush="#24374A" BorderThickness="1" CornerRadius="10" Padding="16">
                    <StackPanel>
                        <TextBlock Text="STREAM QUALITY &amp; PERFORMANCE"
                                   FontSize="12" FontWeight="Bold"
                                   Foreground="#8F98A0"
                                   Margin="0,0,0,12" />

                        <!-- Target FPS -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Target Framerate" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="Higher framerates provide smoother motion on fast Wi-Fi" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <ComboBox x:Name="FpsComboBox" Grid.Column="1" Width="100" SelectionChanged="Fps_SelectionChanged">
                                <ComboBoxItem Content="30 FPS" Tag="30" IsSelected="True" />
                                <ComboBoxItem Content="60 FPS" Tag="60" />
                            </ComboBox>
                        </Grid>

                        <!-- Target Resolution -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Resolution Scale" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="720p is optimized for low latency and smooth mobile streaming" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <ComboBox x:Name="ResolutionComboBox" Grid.Column="1" Width="100" SelectionChanged="Resolution_SelectionChanged">
                                <ComboBoxItem Content="720p HD" Tag="720" IsSelected="True" />
                                <ComboBoxItem Content="1080p FHD" Tag="1080" />
                            </ComboBox>
                        </Grid>

                        <!-- Image Quality Slider -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="JPEG Stream Quality" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock x:Name="QualityPercentText" Grid.Column="1" Text="65%" FontSize="12" FontWeight="Bold" Foreground="#66C0F4" />
                        </Grid>
                        <Slider x:Name="QualitySlider" Minimum="30" Maximum="90" Value="65" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="QualitySlider_ValueChanged" />
                    </StackPanel>
                </Border>

                <!-- Right Column: Live Multi-Network Engine & Sessions -->
                <Border Grid.Column="2" Background="#141E2B" BorderBrush="#24374A" BorderThickness="1" CornerRadius="10" Padding="16">
                    <StackPanel>
                        <TextBlock Text="MULTI-NETWORK &amp; REMOTE SESSIONS"
                                   FontSize="12" FontWeight="Bold"
                                   Foreground="#8F98A0"
                                   Margin="0,0,0,12" />

                        <!-- Connected Clients Count -->
                        <Border Background="#162230" BorderBrush="#263A4E" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Active Mobile Sessions" FontSize="11" Foreground="#8F98A0" />
                                    <TextBlock x:Name="ConnectedDevicesText" Text="0 Devices Connected" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,2,0,0" />
                                </StackPanel>
                                <Border Grid.Column="1" Width="36" Height="36" CornerRadius="18" Background="#1C354A" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="PhoneLaptop24" FontSize="18" Foreground="#66C0F4" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Live Status Items -->
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="Wi-Fi Discovery (UDP 8586):" FontSize="11" Foreground="#8F98A0" />
                            <TextBlock x:Name="WifiStatusLabel" Text="Active (Broadcasting)" FontSize="11" FontWeight="SemiBold" Foreground="#A4D007" HorizontalAlignment="Right" />
                        </Grid>

                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="UPnP NAT Port Mapping:" FontSize="11" Foreground="#8F98A0" />
                            <TextBlock x:Name="UpnpStatusLabel" Text="Mapped (Port 8585)" FontSize="11" FontWeight="SemiBold" Foreground="#A4D007" HorizontalAlignment="Right" />
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="Cloudflare Remote Tunnel:" FontSize="11" Foreground="#8F98A0" />
                            <TextBlock x:Name="TunnelStatusLabel" Text="Online (4G/5G Ready)" FontSize="11" FontWeight="SemiBold" Foreground="#66C0F4" HorizontalAlignment="Right" />
                        </Grid>

                        <TextBlock Text="Zero Setup: SUO Link automatically switches between local Wi-Fi and remote tunnel based on your phone network."
                                   FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</Page>
