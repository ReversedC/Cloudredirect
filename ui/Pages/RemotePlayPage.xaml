<Page x:Class="CloudRedirect.Pages.RemotePlayPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:res="clr-namespace:CloudRedirect.Resources"
      ScrollViewer.CanContentScroll="False">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,12">
        <StackPanel MaxWidth="880" HorizontalAlignment="Stretch">

            <!-- Hero Header -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="SUO LINK"
                                   FontSize="24" FontWeight="Bold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <Border Background="#1C354A" BorderBrush="#2563EB" BorderThickness="1"
                                CornerRadius="12" Padding="10,2" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="GAMEHUB REMOTE PLAY" FontSize="10" FontWeight="Bold" Foreground="#66C0F4" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Stream your PC games to your phone with unrestricted GameHub virtual controls and zero setup."
                               FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" />
                </StackPanel>

                <!-- Server Toggle & Live Status Badge -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="ServerStatusPill"
                            Background="#183321" BorderBrush="#3B6B22" BorderThickness="1"
                            CornerRadius="16" Padding="12,6" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="ServerStatusDot" Width="8" Height="8" Fill="#A4D007" Margin="0,0,6,0" />
                            <TextBlock x:Name="ServerStatusText" Text="SERVER ONLINE" FontSize="11" FontWeight="Bold" Foreground="#A4D007" />
                        </StackPanel>
                    </Border>

                    <ui:Button x:Name="ToggleServerBtn"
                               Content="Stop Host"
                               Appearance="Secondary"
                               Icon="{ui:SymbolIcon Power24}"
                               Click="ToggleServer_Click"
                               Padding="14,6"
                               Cursor="Hand" />
                </StackPanel>
            </Grid>

            <!-- MAIN FEATURE CARD: 1-Scan QR Setup (Centerpiece) -->
            <Border Background="#121A24" BorderBrush="#22364A" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- QR Code Canvas -->
                    <Border Grid.Column="0" Background="#0B0E14" BorderBrush="#1E2E3E" BorderThickness="1" CornerRadius="10" Padding="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel HorizontalAlignment="Center">
                            <Image x:Name="QrCodeImage" Width="180" Height="180" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                            <TextBlock Text="SCAN WITH PHONE CAMERA"
                                       FontSize="9" FontWeight="Bold"
                                       Foreground="#8F98A0"
                                       HorizontalAlignment="Center" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Instructions & Connection Info -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="1-Scan Instant Connect (Zero Setup)"
                                   FontSize="17" FontWeight="Bold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                        <TextBlock Text="Connect your phone or tablet in seconds over Wi-Fi without manual IP or port configuration:"
                                   FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,12" />

                        <!-- Step 1 -->
                        <Border Background="#162230" BorderBrush="#263A4E" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="24" Height="24" CornerRadius="12" Background="#1C354A" Margin="0,0,10,0" VerticalAlignment="Center">
                                    <TextBlock Text="1" FontWeight="Bold" FontSize="12" Foreground="#66C0F4" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="12" TextWrapping="Wrap"
                                           Text="Open SUO Link on your phone. It auto-discovers this PC over local Wi-Fi automatically." />
                            </Grid>
                        </Border>

                        <!-- Step 2 -->
                        <Border Background="#162230" BorderBrush="#263A4E" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="24" Height="24" CornerRadius="12" Background="#1C354A" Margin="0,0,10,0" VerticalAlignment="Center">
                                    <TextBlock Text="2" FontWeight="Bold" FontSize="12" Foreground="#66C0F4" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="12" TextWrapping="Wrap"
                                           Text="Scan QR with SUO Link app. It automatically auto-configures whether you are on local Wi-Fi, 4G/5G, or a different network!" />
                            </Grid>
                        </Border>

                        <!-- Network Endpoints Badges -->
                        <WrapPanel Margin="0,0,0,8">
                            <Border Background="#10251B" BorderBrush="#2B5B3E" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,6,4">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7" Fill="#A4D007" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock x:Name="LanEndpointText" Text="Wi-Fi: 192.168.1.xxx:8585" FontSize="11" Foreground="#A4D007" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                            <Border Background="#132338" BorderBrush="#1F4770" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,6,4">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="TunnelDot" Width="7" Height="7" Fill="#66C0F4" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock x:Name="TunnelEndpointText" Text="Remote Tunnel: Initializing..." FontSize="11" Foreground="#66C0F4" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                        </WrapPanel>

                        <!-- URL & Action Buttons -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBox x:Name="ServerUrlBox"
                                     IsReadOnly="True"
                                     Width="320"
                                     Height="34"
                                     VerticalContentAlignment="Center"
                                     Background="#0E1620"
                                     Foreground="#66C0F4"
                                     BorderBrush="#253A4E"
                                     Margin="0,0,8,0" />

                            <ui:Button Content="Copy Link"
                                       Icon="{ui:SymbolIcon Copy24}"
                                       Appearance="Secondary"
                                       Click="CopyUrl_Click"
                                       Margin="0,0,8,0" />

                            <ui:Button Content="Open Browser"
                                       Icon="{ui:SymbolIcon Globe24}"
                                       Appearance="Secondary"
                                       Click="OpenBrowser_Click"
                                       Margin="0,0,8,0" />
                        </StackPanel>

                        <!-- APK Download Button -->
                        <StackPanel Orientation="Horizontal">
                            <ui:Button x:Name="DownloadApkBtn"
                                       Content="Get SUO-Link.apk (For Android)"
                                       Icon="{ui:SymbolIcon ArrowDownload24}"
                                       Background="#FF5C7E10"
                                       BorderBrush="#FF75B022"
                                       Foreground="#FFFFFFFF"
                                       FontWeight="SemiBold"
                                       Click="DownloadApk_Click"
                                       Margin="0,0,8,0" />

                            <TextBlock x:Name="ApkStatusText"
                                       Text="APK ready to install"
                                       FontSize="11"
                                       Foreground="#A4D007"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2-COLUMN SETTINGS: Quality & Telemetry -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Quality & Performance Panel -->
                <Border Grid.Column="0" Background="#141E2B" BorderBrush="#24374A" BorderThickness="1" CornerRadius="10" Padding="16">
                    <StackPanel>
                        <TextBlock Text="STREAM QUALITY &amp; PERFORMANCE"
                                   FontSize="12" FontWeight="Bold"
                                   Foreground="#8F98A0"
                                   Margin="0,0,0,12" />

                        <!-- Target FPS -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Target Framerate" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="Higher framerates provide smoother motion on fast Wi-Fi" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <ComboBox x:Name="FpsComboBox" Grid.Column="1" Width="100" SelectionChanged="Fps_SelectionChanged">
                                <ComboBoxItem Content="30 FPS" Tag="30" IsSelected="True" />
                                <ComboBoxItem Content="60 FPS" Tag="60" />
                            </ComboBox>
                        </Grid>

                        <!-- Target Resolution -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Resolution Scale" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="720p is optimized for low latency and smooth mobile streaming" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <ComboBox x:Name="ResolutionComboBox" Grid.Column="1" Width="100" SelectionChanged="Resolution_SelectionChanged">
                                <ComboBoxItem Content="720p HD" Tag="720" IsSelected="True" />
                                <ComboBoxItem Content="1080p FHD" Tag="1080" />
                            </ComboBox>
                        </Grid>

                        <!-- Image Quality Slider -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="JPEG Stream Quality" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock x:Name="QualityPercentText" Grid.Column="1" Text="65%" FontSize="12" FontWeight="Bold" Foreground="#66C0F4" />
                        </Grid>
                        <Slider x:Name="QualitySlider" Minimum="30" Maximum="90" Value="65" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="QualitySlider_ValueChanged" />
                    </StackPanel>
                </Border>

                <!-- Multi-Network / Outside Wi-Fi (WAN) Panel -->
                <Border Grid.Column="2" Background="#141E2B" BorderBrush="#24374A" BorderThickness="1" CornerRadius="10" Padding="16">
                    <StackPanel>
                        <TextBlock Text="MULTI-NETWORK &amp; REMOTE SESSIONS"
                                   FontSize="12" FontWeight="Bold"
                                   Foreground="#8F98A0"
                                   Margin="0,0,0,12" />

                        <!-- Connected Clients Count -->
                        <Border Background="#162230" BorderBrush="#263A4E" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Active Mobile Sessions" FontSize="11" Foreground="#8F98A0" />
                                    <TextBlock x:Name="ConnectedDevicesText" Text="0 Devices Connected" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,2,0,0" />
                                </StackPanel>
                                <Border Grid.Column="1" Width="36" Height="36" CornerRadius="18" Background="#1C354A" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="PhoneLaptop24" FontSize="18" Foreground="#66C0F4" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                        </Border>

                        <!-- UDP Discovery Beacon Info -->
                        <TextBlock Text="Wi-Fi Auto-Discovery: Active (UDP port 8586)"
                                   FontSize="11" Foreground="#A4D007" Margin="0,0,0,6" />
                        <TextBlock Text="Your phone app detects this PC automatically when connected to the same home Wi-Fi network."
                                   FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,12" />

                        <!-- WAN / Tailscale Info -->
                        <TextBlock Text="Playing Outside Home (4G/5G or Remote Wi-Fi):"
                                   FontSize="11" FontWeight="SemiBold" Foreground="#8F98A0" Margin="0,0,0,4" />
                        <TextBlock Text="If using Tailscale or VPN mesh, enter your Tailscale IP into the SUO Link mobile app to connect securely across any network without port forwarding."
                                   FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</Page>
