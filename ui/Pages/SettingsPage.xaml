<Page x:Class="CloudRedirect.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:res="clr-namespace:CloudRedirect.Resources"
      ScrollViewer.CanContentScroll="False">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,16">
        <DockPanel LastChildFill="True">
            <TextBlock DockPanel.Dock="Top"
                       Text="{res:Loc Settings_Title}"
                       FontSize="26" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                       Margin="0,0,0,16" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left Column: Quality of Life, Danger Zone -->
                <StackPanel Grid.Column="0">

                    <!-- Quality of Life Section -->
                    <StackPanel x:Name="ExtraSection" Margin="0,0,0,16">
                        <TextBlock Text="{res:Loc Settings_Extra}"
                                   FontSize="17" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   Margin="0,0,0,8" />
                        <StackPanel>
                            <!-- Platform & Integration Status Card (Steam, Beta/Stable, SUO, Online/Offline) -->
                            <ui:CardControl x:Name="PlatformStatusCard" Margin="0,0,0,8">
                                <ui:CardControl.Header>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="1" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- Steam Client Status -->
                                        <Grid Grid.Row="0" Margin="0,2,0,10">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ui:SymbolIcon Grid.Row="0" Grid.Column="0" Symbol="Games24" FontSize="20"
                                                           Foreground="{StaticResource SteamAccentCyanBrush}"
                                                           Margin="0,0,12,0" VerticalAlignment="Top" />
                                            <StackPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="Steam Client" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                <TextBlock x:Name="SteamVersionText" Text="Detecting Steam..."
                                                           FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                            <Border Grid.Row="0" Grid.Column="2" x:Name="SteamBranchBadge"
                                                    Background="#162B3D" BorderBrush="#00D2FF" BorderThickness="1"
                                                    CornerRadius="4" Padding="8,2" VerticalAlignment="Top">
                                                <TextBlock x:Name="SteamBranchText" Text="Stable Client"
                                                           FontSize="11" FontWeight="Bold" Foreground="#00D2FF" />
                                            </Border>

                                            <!-- Detailed About Steam Metadata -->
                                            <Border Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                                    Background="#0D1622" BorderBrush="#1B2838" BorderThickness="1"
                                                    CornerRadius="4" Padding="10,6" Margin="0,8,0,0">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Steam Version:" FontSize="11" Foreground="#8F98A0" Margin="0,1,12,1" />
                                                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="SteamManifestVersionText" Text="--" FontSize="11" Foreground="#C7D5E0" FontWeight="SemiBold" />

                                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Client Build Date:" FontSize="11" Foreground="#8F98A0" Margin="0,1,12,1" />
                                                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="SteamClientBuildDateText" Text="--" FontSize="11" Foreground="#C7D5E0" />

                                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Web Build Date:" FontSize="11" Foreground="#8F98A0" Margin="0,1,12,1" />
                                                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="SteamWebBuildDateText" Text="--" FontSize="11" Foreground="#C7D5E0" />

                                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Steam API Version:" FontSize="11" Foreground="#8F98A0" Margin="0,1,12,1" />
                                                    <TextBlock Grid.Row="3" Grid.Column="1" x:Name="SteamApiVersionText" Text="--" FontSize="11" Foreground="#00D2FF" FontWeight="SemiBold" />
                                                </Grid>
                                            </Border>
                                        </Grid>

                                        <!-- Subtle Separator -->
                                        <Border Grid.Row="1" Height="1" Background="#1D2A3A" Margin="0,0,0,10" />

                                        <!-- Steam Unlock ONENNABE (SUO) Status -->
                                        <Grid Grid.Row="2" Margin="0,0,0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ui:SymbolIcon Grid.Column="0" Symbol="ShieldKeyhole24" FontSize="20"
                                                           Foreground="#A4D007"
                                                           Margin="0,0,12,0" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="Steam Unlock ONENNABE (SUO)" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                <TextBlock x:Name="SuoVersionText" Text="Detecting SUO..."
                                                           FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border x:Name="SuoStatusBadge"
                                                        Background="#143224" BorderBrush="#5BA32B" BorderThickness="1"
                                                        CornerRadius="4" Padding="8,2" VerticalAlignment="Center" Margin="0,0,8,0">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Ellipse x:Name="SuoStatusDot" Width="6" Height="6" Fill="#A4D007" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                        <TextBlock x:Name="SuoStatusText" Text="Online"
                                                                   FontSize="11" FontWeight="Bold" Foreground="#A4D007" />
                                                    </StackPanel>
                                                </Border>
                                                <ui:Button x:Name="OpenSuoRemoteSettingsBtn"
                                                           Appearance="Secondary"
                                                           Content="Open Remote"
                                                           Icon="{ui:SymbolIcon Globe24}"
                                                           Click="OpenSuoRemote_Click"
                                                           Visibility="Collapsed"
                                                           Padding="10,4"
                                                           Cursor="Hand" />
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </ui:CardControl.Header>
                            </ui:CardControl>

                            <ui:CardControl Margin="0,0,0,8">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="{res:Loc Settings_AutoUpdate}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <TextBlock Text="{res:Loc Settings_AutoUpdate_Description}"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ui:ToggleSwitch x:Name="AutoUpdateDllToggle"
                                                 Checked="SyncToggle_Changed"
                                                 Unchecked="SyncToggle_Changed" />
                            </ui:CardControl>

                            <!-- cloud_redirect-only QoL card. -->
                            <ui:CardControl x:Name="ShowNonSteamGameCard" Margin="0,0,0,0">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="{res:Loc Settings_ShowNonSteamGame}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <TextBlock Text="{res:Loc Settings_ShowNonSteamGameHint}"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ui:ToggleSwitch x:Name="ShowNonSteamGameToggle"
                                                 Checked="SyncToggle_Changed"
                                                 Unchecked="SyncToggle_Changed" />
                            </ui:CardControl>

                            <!-- Start with Windows -->
                            <ui:CardControl Margin="0,8,0,0">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="Start with Windows"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <TextBlock Text="Launch CloudRedirect automatically on Windows startup (minimized to system tray)."
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ui:ToggleSwitch x:Name="StartWithWindowsToggle"
                                                 Checked="AppSettingsToggle_Changed"
                                                 Unchecked="AppSettingsToggle_Changed" />
                            </ui:CardControl>

                            <!-- Minimize to Tray on Close -->
                            <ui:CardControl Margin="0,8,0,0">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="Minimize to Tray on Close"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <TextBlock Text="Closing the window keeps CloudRedirect running in the background system tray."
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ui:ToggleSwitch x:Name="MinimizeToTrayToggle"
                                                 Checked="AppSettingsToggle_Changed"
                                                 Unchecked="AppSettingsToggle_Changed" />
                            </ui:CardControl>

                            <!-- Sync Notifications -->
                            <ui:CardControl Margin="0,8,0,0">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="Save Sync Desktop Notifications"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <TextBlock Text="Show custom Steam-styled animated notifications with mini symbols when backups, restores, or cloud sync events occur."
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:Button x:Name="NotificationTestButton"
                                               Content="Test Toast"
                                               Appearance="Secondary"
                                               Margin="0,0,10,0"
                                               Click="NotificationTestButton_Click"
                                               ToolTip="Preview animated Steam sync toast" />
                                    <ui:ToggleSwitch x:Name="ShowNotificationsToggle"
                                                     Checked="AppSettingsToggle_Changed"
                                                     Unchecked="AppSettingsToggle_Changed" />
                                </StackPanel>
                            </ui:CardControl>

                            <!-- Global Keyboard Shortcut (Summon / Toggle CloudRedirect) -->
                            <ui:CardControl Margin="0,8,0,0">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{res:Loc Settings_GlobalHotkey}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                            <Border Background="#162332" BorderBrush="#25425F" BorderThickness="1"
                                                    CornerRadius="4" Padding="6,2" Margin="8,0,0,0">
                                                <TextBlock x:Name="HotkeyBadgeText" Text="Ctrl+Shift+C" FontSize="11" FontWeight="Bold" Foreground="#66C0F4" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{res:Loc Settings_GlobalHotkeyHint}"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <ComboBox x:Name="HotkeyPresetCombo"
                                              Width="140" Height="32"
                                              VerticalAlignment="Center"
                                              Margin="0,0,10,0"
                                              SelectionChanged="HotkeyPresetCombo_SelectionChanged" />
                                    <ui:ToggleSwitch x:Name="GlobalHotkeyToggle"
                                                     Checked="GlobalHotkeyToggle_Changed"
                                                     Unchecked="GlobalHotkeyToggle_Changed" />
                                </StackPanel>
                            </ui:CardControl>

                            <!-- Game Boost (Performance & Power Optimization) -->
                            <ui:CardControl Margin="0,8,0,0">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="🚀 Game Boost"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                            <Border Background="#162B3D" BorderBrush="#00D2FF" BorderThickness="1"
                                                    CornerRadius="4" Padding="6,2" Margin="8,0,0,0">
                                                <TextBlock Text="HIGH PERFORMANCE" FontSize="11" FontWeight="Bold" Foreground="#00D2FF" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="Automatically optimize CPU and I/O priority, switch Windows to High Performance power plan, and trim background standby RAM when a game launches."
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:Button x:Name="GameBoostTestButton"
                                               Content="Test Overlay"
                                               Appearance="Secondary"
                                               Margin="0,0,10,0"
                                               Click="GameBoostTestButton_Click"
                                               ToolTip="Preview the animated Game Boost toast overlay" />
                                    <ui:ToggleSwitch x:Name="GameBoostToggle"
                                                     Checked="AppSettingsToggle_Changed"
                                                     Unchecked="AppSettingsToggle_Changed" />
                                </StackPanel>
                            </ui:CardControl>

                            <!-- Game Boost Sub-Options (Dedicated GPU, Background Freeze, Smart RAM Purge) -->
                            <StackPanel Margin="16,4,0,0" x:Name="GameBoostSubOptionsPanel">
                                <!-- Auto-Assign High-Performance Dedicated GPU -->
                                <ui:CardControl Margin="0,4,0,0">
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="⚡ Auto-Assign High-Performance Dedicated GPU"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                <Border Background="#1A2D1B" BorderBrush="#5BA32B" BorderThickness="1"
                                                        CornerRadius="4" Padding="6,1" Margin="8,0,0,0">
                                                    <TextBlock Text="TOP PICK FOR LAPTOPS" FontSize="10" FontWeight="Bold" Foreground="#A4D007" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="Forces Windows DirectX graphics settings to run games on the discrete high-performance GPU, preventing accidental lag on integrated graphics."
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       FontSize="12"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <ui:ToggleSwitch x:Name="GameBoostGpuToggle"
                                                     Checked="AppSettingsToggle_Changed"
                                                     Unchecked="AppSettingsToggle_Changed" />
                                </ui:CardControl>

                                <!-- Auto-Freeze Background Apps on Launch -->
                                <ui:CardControl Margin="0,4,0,0">
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="❄️ Auto-Freeze Background Apps on Launch"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                <Border Background="#162B3D" BorderBrush="#00D2FF" BorderThickness="1"
                                                        CornerRadius="4" Padding="6,1" Margin="8,0,0,0">
                                                    <TextBlock Text="AUTOMATIC MODE" FontSize="10" FontWeight="Bold" Foreground="#66C0F4" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="Silences background browsers (Chrome, Edge), Discord, and game launchers to Idle priority and flushes their RAM while in-game, automatically restoring them on exit."
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       FontSize="12"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <ui:ToggleSwitch x:Name="GameBoostAutoFreezeToggle"
                                                     Checked="AppSettingsToggle_Changed"
                                                     Unchecked="AppSettingsToggle_Changed" />
                                </ui:CardControl>

                                <!-- Periodic Smart RAM Auto-Purge -->
                                <ui:CardControl Margin="0,4,0,0">
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="🧹 Periodic Smart RAM Auto-Purge"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                <Border Background="#2B2114" BorderBrush="#D1892B" BorderThickness="1"
                                                        CornerRadius="4" Padding="6,1" Margin="8,0,0,0">
                                                    <TextBlock Text="FOR LONG GAMING SESSIONS" FontSize="10" FontWeight="Bold" Foreground="#FFA500" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="Monitors memory load during long sessions; automatically flushes background standby RAM if total system memory usage exceeds 80% to eliminate micro-stutters."
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       FontSize="12"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <ui:ToggleSwitch x:Name="GameBoostPeriodicRamToggle"
                                                     Checked="AppSettingsToggle_Changed"
                                                     Unchecked="AppSettingsToggle_Changed" />
                                </ui:CardControl>
                            </StackPanel>

                            <!-- Game Space In-Game Overlay (Android-Style Companion) -->
                            <ui:CardControl Margin="0,8,0,0">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="🎮 Game Space"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                            <Border Background="#1C354A" BorderBrush="#25425F" BorderThickness="1"
                                                    CornerRadius="4" Padding="6,2" Margin="8,0,0,0">
                                                <TextBlock Text="IN-GAME OVERLAY • CTRL+SPACE" FontSize="11" FontWeight="Bold" Foreground="#66C0F4" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="In-game slide-out drawer with live telemetry, on-demand RAM purge, named save checkpoints, and scratchpad notes. (Auto-disabled on owned, free, or anti-cheat games)."
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:Button x:Name="GameSpaceTestButton"
                                               Content="Preview Game Space"
                                               Appearance="Secondary"
                                               Margin="0,0,10,0"
                                               Click="GameSpaceTestButton_Click"
                                               ToolTip="Toggle and preview the in-game Game Space overlay (Ctrl+Space)" />
                                    <ui:ToggleSwitch x:Name="GameSpaceToggle"
                                                     Checked="AppSettingsToggle_Changed"
                                                     Unchecked="AppSettingsToggle_Changed" />
                                </StackPanel>
                            </ui:CardControl>

                            <!-- Auto-Protect Intercepted Games Without Cloud Saves -->
                            <ui:CardControl Margin="0,8,0,0">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="Auto-Protect Intercepted Games Without Cloud Saves"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <TextBlock Text="Automatically protect non-genuine and intercepted Steam games lacking cloud saves with Universal Cloud Saves."
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ui:ToggleSwitch x:Name="AutoProtectNonCloudToggle"
                                                 Checked="AppSettingsToggle_Changed"
                                                 Unchecked="AppSettingsToggle_Changed" />
                            </ui:CardControl>

                            <!-- Steam Millennium Native Plugin -->
                            <ui:CardControl Margin="0,8,0,0">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{res:Loc Settings_MillenniumPluginTitle}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                            <Border x:Name="MillenniumStatusBorder" Background="#162332" BorderBrush="#25425F" BorderThickness="1"
                                                    CornerRadius="4" Padding="6,2" Margin="8,0,0,0">
                                                <TextBlock x:Name="MillenniumStatusText" Text="Millennium Active" FontSize="11" FontWeight="Bold" Foreground="#66C0F4" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{res:Loc Settings_MillenniumPluginDescription}"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ui:ToggleSwitch x:Name="MillenniumPluginToggle"
                                                 Checked="AppSettingsToggle_Changed"
                                                 Unchecked="AppSettingsToggle_Changed" />
                            </ui:CardControl>

                            <!-- Auto-Restart Steam on Launch (to load plugins) -->
                            <ui:CardControl Margin="0,8,0,0">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="{res:Loc Settings_AutoRestartSteamOnLaunchTitle}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <TextBlock Text="{res:Loc Settings_AutoRestartSteamOnLaunchDescription}"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ui:ToggleSwitch x:Name="AutoRestartSteamOnLaunchToggle"
                                                 Checked="AppSettingsToggle_Changed"
                                                 Unchecked="AppSettingsToggle_Changed" />
                            </ui:CardControl>

                            <!-- Auto-Fit Window (No Scrolling) -->
                            <ui:CardControl Margin="0,8,0,0">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="Auto-Fit Window (Single Interface / No Scrolling)"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <TextBlock Text="Automatically scale the interface so all cards and controls fit without requiring vertical scrolling."
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ui:ToggleSwitch x:Name="AutoFitZoomToggle"
                                                 Checked="AutoFitZoomToggle_Changed"
                                                 Unchecked="AutoFitZoomToggle_Changed" />
                            </ui:CardControl>
                        </StackPanel>
                    </StackPanel>

                    <!-- Danger Zone Section -->
                    <TextBlock Text="{res:Loc Settings_DangerZone}"
                               FontSize="17" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               Margin="0,0,0,8" />

                    <ui:CardControl Margin="0,0,0,0">
                        <ui:CardControl.Header>
                            <StackPanel>
                                <TextBlock Text="{res:Loc Settings_ResetCacheTitle}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="{res:Loc Settings_ResetCacheDescription}"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </ui:CardControl.Header>
                        <ui:Button Content="{res:Loc Settings_Reset}"
                                   Appearance="Danger"
                                   Click="ResetData_Click" />
                    </ui:CardControl>
                </StackPanel>

                <!-- Right Column: Auto-Everything & Experimental -->
                <StackPanel Grid.Column="2">
                    <!-- Auto-Everything Cloud Save System -->
                    <StackPanel x:Name="AutoEverythingSection" Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <ui:SymbolIcon Symbol="Flash24" FontSize="18" Foreground="{StaticResource SteamAccentCyanBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="{res:Loc Settings_AutoEverything_Title}"
                                       FontSize="17" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </StackPanel>

                        <!-- Auto-Sync on Game Exit -->
                        <ui:CardControl Margin="0,0,0,8">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="{res:Loc Settings_AutoSyncExit}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Text="{res:Loc Settings_AutoSyncExitHint}"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch x:Name="AutoSyncExitToggle"
                                             Checked="AppSettingsToggle_Changed"
                                             Unchecked="AppSettingsToggle_Changed" />
                        </ui:CardControl>

                        <!-- Auto-Checkpoint Mid-Game -->
                        <ui:CardControl Margin="0,0,0,8">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="{res:Loc Settings_AutoCheckpoint}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Text="{res:Loc Settings_AutoCheckpointHint}"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch x:Name="AutoCheckpointToggle"
                                             Checked="AppSettingsToggle_Changed"
                                             Unchecked="AppSettingsToggle_Changed" />
                        </ui:CardControl>

                        <!-- Auto-Conflict Resolution & Auto-Healing -->
                        <ui:CardControl Margin="0,0,0,8">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="{res:Loc Settings_AutoConflictHealing}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Text="{res:Loc Settings_AutoConflictHealingHint}"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch x:Name="AutoConflictHealingToggle"
                                             Checked="AppSettingsToggle_Changed"
                                             Unchecked="AppSettingsToggle_Changed" />
                        </ui:CardControl>

                        <!-- Auto-Storage Compression & Pruning -->
                        <ui:CardControl Margin="0,0,0,8">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="{res:Loc Settings_AutoCompression}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Text="{res:Loc Settings_AutoCompressionHint}"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch x:Name="AutoCompressionToggle"
                                             Checked="AppSettingsToggle_Changed"
                                             Unchecked="AppSettingsToggle_Changed" />
                        </ui:CardControl>

                        <!-- Community Database Sync -->
                        <ui:CardControl Margin="0,0,0,8">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="{res:Loc Settings_AutoCommunityDb}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Text="{res:Loc Settings_AutoCommunityDbHint}"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch x:Name="AutoCommunityDbToggle"
                                             Checked="AppSettingsToggle_Changed"
                                             Unchecked="AppSettingsToggle_Changed" />
                        </ui:CardControl>
                    </StackPanel>

                    <!-- Experimental Features -->
                    <StackPanel x:Name="ExperimentalSection">
                        <TextBlock Text="{res:Loc Settings_Experimental}"
                                   FontSize="17" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   Margin="0,0,0,8" />
                        <ui:CardControl Margin="0,0,0,8">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="{res:Loc Settings_SyncAchievements}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Text="{res:Loc Settings_SyncAchievementsHint}"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch x:Name="SyncAchievementsToggle"
                                             Checked="SyncToggle_Changed"
                                             Unchecked="SyncToggle_Changed" />
                        </ui:CardControl>

                        <ui:CardControl Margin="0,0,0,0">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="{res:Loc Settings_SyncPlaytime}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Text="{res:Loc Settings_SyncPlaytimeHint}"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch x:Name="SyncPlaytimeToggle"
                                             Checked="SyncToggle_Changed"
                                             Unchecked="SyncToggle_Changed" />
                        </ui:CardControl>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </DockPanel>
    </ScrollViewer>
</Page>
