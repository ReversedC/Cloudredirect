<Page x:Class="CloudRedirect.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:res="clr-namespace:CloudRedirect.Resources"
      ScrollViewer.CanContentScroll="False">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="28,16">
        <DockPanel LastChildFill="True">

            <!-- 1. Clean Steam Settings Hero Header (No Colliding Badges) -->
            <Border DockPanel.Dock="Top"
                    Background="#101923"
                    BorderBrush="#1F3347"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16,12"
                    Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Settings Icon -->
                    <Border Grid.Column="0"
                            Background="#182E42"
                            BorderBrush="#254A6B"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="8,8"
                            Margin="0,0,14,0"
                            VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Settings24" FontSize="20" Foreground="#66C0F4" />
                    </Border>

                    <!-- Title & Subtitle (Auto-Wrapping) -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="{res:Loc Settings_Title}"
                                   FontSize="18" FontWeight="Bold"
                                   Foreground="#FFFFFF"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{res:Loc Settings_HeroSubtitle}"
                                   FontSize="11" Foreground="#8F98A0" Margin="0,3,0,0" TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- Live Language Switcher Dock (Full Height & Auto-Fit) -->
                    <Border Grid.Column="2"
                            Background="#142230"
                            BorderBrush="#233A52"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="8,0,6,0"
                            MinHeight="34"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Globe24" FontSize="15" Foreground="#66C0F4" Margin="4,0,8,0" VerticalAlignment="Center" />
                            <ComboBox x:Name="SettingsLanguageComboBox"
                                      MinWidth="160"
                                      Height="32"
                                      MinHeight="32"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      Padding="4,2,24,2"
                                      VerticalAlignment="Center"
                                      VerticalContentAlignment="Center"
                                      SelectionChanged="SettingsLanguageComboBox_SelectionChanged"
                                      FontSize="12"
                                      MaxDropDownHeight="320"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                      ToolTip="Change application language on the fly" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- 2. Balanced Two-Column Operational Layout -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- ══════════════════════════════════════════════════════════════ -->
                <!-- LEFT COLUMN: Cloud Saves & Steam Platform Integrations        -->
                <!-- ══════════════════════════════════════════════════════════════ -->
                <StackPanel Grid.Column="0">

                    <!-- SECTION 1: Cloud Saves & Automation -->
                    <StackPanel x:Name="AutoEverythingSection" Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <ui:SymbolIcon Symbol="CloudSync24" FontSize="16" Foreground="#66C0F4" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="{res:Loc Settings_CategoryCloud}"
                                       FontSize="15" FontWeight="Bold"
                                       Foreground="#66C0F4" />
                        </StackPanel>

                        <!-- Auto-Sync on Game Exit -->
                        <ui:CardControl Margin="0,0,0,8">
                            <ui:CardControl.Header>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="{res:Loc Settings_AutoSyncExit}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{res:Loc Settings_AutoSyncExitHint}"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch x:Name="AutoSyncExitToggle"
                                             Checked="AppSettingsToggle_Changed"
                                             Unchecked="AppSettingsToggle_Changed" />
                        </ui:CardControl>

                        <!-- Auto-Checkpoint Mid-Game -->
                        <ui:CardControl Margin="0,0,0,8">
                            <ui:CardControl.Header>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="{res:Loc Settings_AutoCheckpoint}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{res:Loc Settings_AutoCheckpointHint}"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch x:Name="AutoCheckpointToggle"
                                             Checked="AppSettingsToggle_Changed"
                                             Unchecked="AppSettingsToggle_Changed" />
                        </ui:CardControl>

                        <!-- Auto-Conflict Resolution & Auto-Healing -->
                        <ui:CardControl Margin="0,0,0,8">
                            <ui:CardControl.Header>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="{res:Loc Settings_AutoConflictHealing}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{res:Loc Settings_AutoConflictHealingHint}"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch x:Name="AutoConflictHealingToggle"
                                             Checked="AppSettingsToggle_Changed"
                                             Unchecked="AppSettingsToggle_Changed" />
                        </ui:CardControl>

                        <!-- Auto-Storage Compression & Pruning -->
                        <ui:CardControl Margin="0,0,0,8">
                            <ui:CardControl.Header>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="{res:Loc Settings_AutoCompression}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{res:Loc Settings_AutoCompressionHint}"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch x:Name="AutoCompressionToggle"
                                             Checked="AppSettingsToggle_Changed"
                                             Unchecked="AppSettingsToggle_Changed" />
                        </ui:CardControl>

                        <!-- Community Save Database Sync -->
                        <ui:CardControl Margin="0,0,0,8">
                            <ui:CardControl.Header>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="{res:Loc Settings_AutoCommunityDb}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{res:Loc Settings_AutoCommunityDbHint}"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch x:Name="AutoCommunityDbToggle"
                                             Checked="AppSettingsToggle_Changed"
                                             Unchecked="AppSettingsToggle_Changed" />
                        </ui:CardControl>

                        <!-- Community Database Remote Feed & Sync -->
                        <Border x:Name="CommunityDbFeedPanel"
                                Background="#121D28"
                                BorderBrush="#1F3246"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12,10"
                                Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="Community Save Database Feed (Raw JSON / GitHub Gist)"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="Automatically fetches the latest game save signatures without rebuilding the app."
                                           FontSize="11"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Margin="0,2,0,8" />

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <ui:TextBox x:Name="CommunityDbUrlTextBox"
                                                Grid.Column="0"
                                                Height="32"
                                                VerticalContentAlignment="Center"
                                                Padding="8,4"
                                                FontSize="12"
                                                PlaceholderText="https://gist.githubusercontent.com/.../raw/saves.json"
                                                TextChanged="CommunityDbUrlTextBox_TextChanged" />

                                    <ui:Button x:Name="CommunityDbSyncButton"
                                               Grid.Column="2"
                                               Appearance="Primary"
                                               Content="Update Now"
                                               Icon="{ui:SymbolIcon ArrowSync24}"
                                               Padding="10,4"
                                               Height="32"
                                               FontSize="12"
                                               Click="CommunityDbSyncButton_Click" />

                                    <ui:Button x:Name="CommunityDbCopyTemplateButton"
                                               Grid.Column="4"
                                               Appearance="Secondary"
                                               Content="Copy Template"
                                               Icon="{ui:SymbolIcon Copy24}"
                                               Padding="10,4"
                                               Height="32"
                                               FontSize="12"
                                               Click="CommunityDbCopyTemplateButton_Click" />
                                </Grid>

                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="CommunityDbStatusText"
                                               Text="Status: Up to date"
                                               FontSize="11"
                                               Foreground="#A4D007" />
                                    <TextBlock x:Name="CommunityDbStatsText"
                                               Text="• 48 built-in game signatures"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Margin="6,0,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Universal Saves Safe Mode for Intercepted Games -->
                        <ui:CardControl Margin="0,0,0,8">
                            <ui:CardControl.Header>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="{res:Loc Settings_AutoProtectIntercepted}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{res:Loc Settings_AutoProtectIntercepted_Desc}"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch x:Name="AutoProtectNonCloudToggle"
                                             Checked="AppSettingsToggle_Changed"
                                             Unchecked="AppSettingsToggle_Changed" />
                        </ui:CardControl>

                        <!-- Experimental: Achievements & Playtime Sync -->
                        <StackPanel x:Name="ExperimentalSection" Margin="0,4,0,0">
                            <ui:CardControl Margin="0,0,0,8">
                                <ui:CardControl.Header>
                                    <StackPanel Margin="0,0,16,0">
                                        <TextBlock Text="{res:Loc Settings_SyncAchievements}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="{res:Loc Settings_SyncAchievementsHint}"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ui:ToggleSwitch x:Name="SyncAchievementsToggle"
                                                 Checked="SyncToggle_Changed"
                                                 Unchecked="SyncToggle_Changed" />
                            </ui:CardControl>

                            <ui:CardControl Margin="0,0,0,0">
                                <ui:CardControl.Header>
                                    <StackPanel Margin="0,0,16,0">
                                        <TextBlock Text="{res:Loc Settings_SyncPlaytime}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="{res:Loc Settings_SyncPlaytimeHint}"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ui:ToggleSwitch x:Name="SyncPlaytimeToggle"
                                                 Checked="SyncToggle_Changed"
                                                 Unchecked="SyncToggle_Changed" />
                            </ui:CardControl>
                        </StackPanel>
                    </StackPanel>

                    <!-- SECTION 2: Steam & Platform Integrations -->
                    <StackPanel x:Name="ExtraSection" Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <ui:SymbolIcon Symbol="Games24" FontSize="16" Foreground="#66C0F4" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="{res:Loc Settings_CategorySteam}"
                                       FontSize="15" FontWeight="Bold"
                                       Foreground="#66C0F4" />
                        </StackPanel>

                        <!-- Platform & Integration Status Card (Steam Client & SUO) -->
                        <ui:CardControl x:Name="PlatformStatusCard" Margin="0,0,0,8">
                            <ui:CardControl.Header>
                                <Grid Margin="0,0,8,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="1" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Steam Client Status -->
                                    <Grid Grid.Row="0" Margin="0,2,0,10">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ui:SymbolIcon Grid.Row="0" Grid.Column="0" Symbol="Games24" FontSize="20"
                                                       Foreground="{StaticResource SteamAccentCyanBrush}"
                                                       Margin="0,0,12,0" VerticalAlignment="Top" />
                                        <StackPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                            <TextBlock Text="Steam Client" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock x:Name="SteamVersionText" Text="Detecting Steam..."
                                                       FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Border Grid.Row="0" Grid.Column="2" x:Name="SteamBranchBadge"
                                                Background="#162B3D" BorderBrush="#00D2FF" BorderThickness="1"
                                                CornerRadius="4" Padding="8,2" VerticalAlignment="Top">
                                            <TextBlock x:Name="SteamBranchText" Text="Stable Client"
                                                       FontSize="10" FontWeight="Bold" Foreground="#00D2FF" />
                                        </Border>

                                        <!-- Detailed About Steam Metadata -->
                                        <Border Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                                Background="#0D1622" BorderBrush="#1B2838" BorderThickness="1"
                                                CornerRadius="4" Padding="10,6" Margin="0,8,0,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Steam Version:" FontSize="10" Foreground="#8F98A0" Margin="0,1,12,1" />
                                                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="SteamManifestVersionText" Text="--" FontSize="10" Foreground="#C7D5E0" FontWeight="SemiBold" />

                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Client Build Date:" FontSize="10" Foreground="#8F98A0" Margin="0,1,12,1" />
                                                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="SteamClientBuildDateText" Text="--" FontSize="10" Foreground="#C7D5E0" />

                                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Web Build Date:" FontSize="10" Foreground="#8F98A0" Margin="0,1,12,1" />
                                                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="SteamWebBuildDateText" Text="--" FontSize="10" Foreground="#C7D5E0" />

                                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Steam API Version:" FontSize="10" Foreground="#8F98A0" Margin="0,1,12,1" />
                                                <TextBlock Grid.Row="3" Grid.Column="1" x:Name="SteamApiVersionText" Text="--" FontSize="10" Foreground="#00D2FF" FontWeight="SemiBold" />
                                            </Grid>
                                        </Border>
                                    </Grid>

                                    <!-- Subtle Separator -->
                                    <Border Grid.Row="1" Height="1" Background="#1D2A3A" Margin="0,0,0,10" />

                                    <!-- Steam Unlock ONENNABE (SUO) Status -->
                                    <Grid Grid.Row="2" Margin="0,0,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ui:SymbolIcon Grid.Column="0" Symbol="ShieldKeyhole24" FontSize="20"
                                                       Foreground="#A4D007"
                                                       Margin="0,0,12,0" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                            <TextBlock Text="Steam Unlock ONENNABE (SUO)" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock x:Name="SuoVersionText" Text="Detecting SUO..."
                                                       FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border x:Name="SuoStatusBadge"
                                                    Background="#143224" BorderBrush="#5BA32B" BorderThickness="1"
                                                    CornerRadius="4" Padding="8,2" VerticalAlignment="Center" Margin="0,0,8,0">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Ellipse x:Name="SuoStatusDot" Width="6" Height="6" Fill="#A4D007" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                    <TextBlock x:Name="SuoStatusText" Text="Online"
                                                               FontSize="10" FontWeight="Bold" Foreground="#A4D007" />
                                                </StackPanel>
                                            </Border>
                                            <ui:Button x:Name="OpenSuoRemoteSettingsBtn"
                                                       Appearance="Secondary"
                                                       Content="Open Remote"
                                                       Icon="{ui:SymbolIcon Globe24}"
                                                       Click="OpenSuoRemote_Click"
                                                       Visibility="Collapsed"
                                                       Padding="8,3"
                                                       FontSize="11"
                                                       Cursor="Hand" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </ui:CardControl.Header>
                        </ui:CardControl>

                        <!-- Steam Millennium Native Plugin -->
                        <ui:CardControl Margin="0,0,0,8">
                            <ui:CardControl.Header>
                                <StackPanel Margin="0,0,16,0">
                                    <WrapPanel Margin="0,0,0,2" VerticalAlignment="Center">
                                        <TextBlock Text="{res:Loc Settings_MillenniumPluginTitle}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,8,0"
                                                   VerticalAlignment="Center" />
                                        <Border x:Name="MillenniumStatusBorder" Background="#162332" BorderBrush="#25425F" BorderThickness="1"
                                                CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                                            <TextBlock x:Name="MillenniumStatusText" Text="Millennium Active" FontSize="9" FontWeight="Bold" Foreground="#66C0F4" />
                                        </Border>
                                    </WrapPanel>
                                    <TextBlock Text="{res:Loc Settings_MillenniumPluginDescription}"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               FontSize="11" TextWrapping="Wrap" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch x:Name="MillenniumPluginToggle"
                                             Checked="AppSettingsToggle_Changed"
                                             Unchecked="AppSettingsToggle_Changed" />
                        </ui:CardControl>

                        <!-- Auto-Restart Steam on Launch -->
                        <ui:CardControl Margin="0,0,0,8">
                            <ui:CardControl.Header>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="{res:Loc Settings_AutoRestartSteamOnLaunchTitle}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{res:Loc Settings_AutoRestartSteamOnLaunchDescription}"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch x:Name="AutoRestartSteamOnLaunchToggle"
                                             Checked="AppSettingsToggle_Changed"
                                             Unchecked="AppSettingsToggle_Changed" />
                        </ui:CardControl>

                        <!-- Show Non-Steam Games Toggle -->
                        <ui:CardControl x:Name="ShowNonSteamGameCard" Margin="0,0,0,0" Visibility="Collapsed">
                            <ui:CardControl.Header>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="{res:Loc Settings_ShowNonSteamGame}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{res:Loc Settings_ShowNonSteamGameHint}"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch x:Name="ShowNonSteamGameToggle"
                                             Checked="SyncToggle_Changed"
                                             Unchecked="SyncToggle_Changed" />
                        </ui:CardControl>
                    </StackPanel>
                </StackPanel>

                <!-- ══════════════════════════════════════════════════════════════ -->
                <!-- RIGHT COLUMN: Gaming Boost Suite, System, & Maintenance        -->
                <!-- ══════════════════════════════════════════════════════════════ -->
                <StackPanel Grid.Column="2">

                    <!-- SECTION 3: Gaming & Performance Boost Suite -->
                    <StackPanel Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <ui:SymbolIcon Symbol="Flash24" FontSize="16" Foreground="#A4D007" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="{res:Loc Settings_CategoryBoost}"
                                       FontSize="15" FontWeight="Bold"
                                       Foreground="#A4D007" />
                        </StackPanel>

                        <!-- Master Game Boost Card (Clean Header, No Badge Collision) -->
                        <ui:CardControl Margin="0,0,0,8">
                            <ui:CardControl.Header>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="{res:Loc Settings_GameBoost}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{res:Loc Settings_GameBoost_Desc}"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:Button x:Name="GameBoostTestButton"
                                           Content="Test Toast"
                                           Appearance="Secondary"
                                           Margin="0,0,8,0"
                                           FontSize="11" Padding="8,4"
                                           Click="GameBoostTestButton_Click"
                                           ToolTip="Preview the animated Game Boost toast overlay" />
                                <ui:ToggleSwitch x:Name="GameBoostToggle"
                                                 Checked="AppSettingsToggle_Changed"
                                                 Unchecked="AppSettingsToggle_Changed" />
                            </StackPanel>
                        </ui:CardControl>

                        <!-- Game Boost Sub-Options Panel (Clean Headers, No Colliding Badges) -->
                        <StackPanel Margin="12,0,0,0" x:Name="GameBoostSubOptionsPanel">

                            <!-- Network Boost (Anti-Lag & 0ms Packet Throttling) -->
                            <ui:CardControl Margin="0,0,0,6">
                                <ui:CardControl.Header>
                                    <StackPanel Margin="0,0,16,0">
                                        <TextBlock Text="{res:Loc Settings_GameBoost_Network}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="{res:Loc Settings_GameBoost_Network_Desc}"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ui:ToggleSwitch x:Name="GameBoostNetworkBoostToggle"
                                                 Checked="AppSettingsToggle_Changed"
                                                 Unchecked="AppSettingsToggle_Changed" />
                            </ui:CardControl>

                            <!-- Bluetooth Low-Latency Boost -->
                            <ui:CardControl Margin="0,0,0,6">
                                <ui:CardControl.Header>
                                    <StackPanel Margin="0,0,16,0">
                                        <TextBlock Text="{res:Loc Settings_GameBoost_Bluetooth}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="{res:Loc Settings_GameBoost_Bluetooth_Desc}"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ui:ToggleSwitch x:Name="GameBoostBluetoothBoostToggle"
                                                 Checked="AppSettingsToggle_Changed"
                                                 Unchecked="AppSettingsToggle_Changed" />
                            </ui:CardControl>

                            <!-- Auto-Assign High-Performance Dedicated GPU -->
                            <ui:CardControl Margin="0,0,0,6">
                                <ui:CardControl.Header>
                                    <StackPanel Margin="0,0,16,0">
                                        <TextBlock Text="{res:Loc Settings_GameBoost_Gpu}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="{res:Loc Settings_GameBoost_Gpu_Desc}"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ui:ToggleSwitch x:Name="GameBoostGpuToggle"
                                                 Checked="AppSettingsToggle_Changed"
                                                 Unchecked="AppSettingsToggle_Changed" />
                            </ui:CardControl>

                            <!-- Auto-Freeze Background Apps on Launch -->
                            <ui:CardControl Margin="0,0,0,6">
                                <ui:CardControl.Header>
                                    <StackPanel Margin="0,0,16,0">
                                        <TextBlock Text="{res:Loc Settings_GameBoost_Freeze}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="{res:Loc Settings_GameBoost_Freeze_Desc}"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ui:ToggleSwitch x:Name="GameBoostAutoFreezeToggle"
                                                 Checked="AppSettingsToggle_Changed"
                                                 Unchecked="AppSettingsToggle_Changed" />
                            </ui:CardControl>

                            <!-- Periodic Smart RAM Auto-Purge -->
                            <ui:CardControl Margin="0,0,0,6">
                                <ui:CardControl.Header>
                                    <StackPanel Margin="0,0,16,0">
                                        <TextBlock Text="{res:Loc Settings_GameBoost_RamPurge}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="{res:Loc Settings_GameBoost_RamPurge_Desc}"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ui:ToggleSwitch x:Name="GameBoostPeriodicRamToggle"
                                                 Checked="AppSettingsToggle_Changed"
                                                 Unchecked="AppSettingsToggle_Changed" />
                            </ui:CardControl>
                        </StackPanel>

                        <!-- Game Space In-Game Overlay -->
                        <ui:CardControl Margin="0,4,0,8">
                            <ui:CardControl.Header>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="{res:Loc Settings_GameSpace}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{res:Loc Settings_GameSpace_Desc}"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:Button x:Name="GameSpaceTestButton"
                                           Content="Preview"
                                           Appearance="Secondary"
                                           Margin="0,0,8,0"
                                           FontSize="11" Padding="8,4"
                                           Click="GameSpaceTestButton_Click"
                                           ToolTip="Toggle and preview the in-game Game Space overlay (Ctrl+Space)" />
                                <ui:ToggleSwitch x:Name="GameSpaceToggle"
                                                 Checked="AppSettingsToggle_Changed"
                                                 Unchecked="AppSettingsToggle_Changed" />
                            </StackPanel>
                        </ui:CardControl>

                        <!-- Sticky Notes In-Game Hotkey -->
                        <ui:CardControl Margin="0,4,0,8">
                            <ui:CardControl.Header>
                                <StackPanel Margin="0,0,16,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="In-Game Sticky Notes Hotkey"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                   TextWrapping="Wrap" />
                                        <Border Background="#162D38" BorderBrush="#255169" BorderThickness="1" CornerRadius="3" Padding="5,1" Margin="8,0,0,0">
                                            <TextBlock Text="Alt + N" FontSize="9.5" FontWeight="Bold" Foreground="#66C0F4" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="Summon a new floating translucent sticky note anywhere while in-game or on desktop without alt-tabbing."
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:Button x:Name="StickyNoteTestButton"
                                           Content="Test Note"
                                           Appearance="Secondary"
                                           Margin="0,0,8,0"
                                           FontSize="11" Padding="8,4"
                                           Click="StickyNoteTestButton_Click"
                                           ToolTip="Create and test a floating sticky note (Alt+N)" />
                                <ui:ToggleSwitch x:Name="StickyNoteHotkeyToggle"
                                                 Checked="AppSettingsToggle_Changed"
                                                 Unchecked="AppSettingsToggle_Changed" />
                            </StackPanel>
                        </ui:CardControl>
                    </StackPanel>

                    <!-- SECTION 4: System & Preferences -->
                    <StackPanel Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <ui:SymbolIcon Symbol="Desktop24" FontSize="16" Foreground="#66C0F4" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="{res:Loc Settings_CategorySystem}"
                                       FontSize="15" FontWeight="Bold"
                                       Foreground="#66C0F4" />
                        </StackPanel>

                        <!-- Auto-Update DLL -->
                        <ui:CardControl Margin="0,0,0,8">
                            <ui:CardControl.Header>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="{res:Loc Settings_AutoUpdate}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{res:Loc Settings_AutoUpdate_Description}"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch x:Name="AutoUpdateDllToggle"
                                             Checked="SyncToggle_Changed"
                                             Unchecked="SyncToggle_Changed" />
                        </ui:CardControl>

                        <!-- View Release Changelog -->
                        <ui:CardControl Margin="0,0,0,8">
                            <ui:CardControl.Header>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="{res:Loc Nav_Changelog}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="View release notes, highlights, and history of updates across all versions."
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:Button Content="View Changelog"
                                       Icon="{ui:SymbolIcon History24}"
                                       Appearance="Secondary"
                                       FontSize="11" Padding="12,5"
                                       Click="ViewChangelog_Click" />
                        </ui:CardControl>

                        <!-- Start with Windows -->
                        <ui:CardControl Margin="0,0,0,8">
                            <ui:CardControl.Header>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="{res:Loc Settings_StartWithWindows}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{res:Loc Settings_StartWithWindows_Desc}"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch x:Name="StartWithWindowsToggle"
                                             Checked="AppSettingsToggle_Changed"
                                             Unchecked="AppSettingsToggle_Changed" />
                        </ui:CardControl>

                        <!-- Minimize to Tray on Close -->
                        <ui:CardControl Margin="0,0,0,8">
                            <ui:CardControl.Header>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="{res:Loc Settings_MinimizeToTray}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{res:Loc Settings_MinimizeToTray_Desc}"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch x:Name="MinimizeToTrayToggle"
                                             Checked="AppSettingsToggle_Changed"
                                             Unchecked="AppSettingsToggle_Changed" />
                        </ui:CardControl>

                        <!-- Sync Desktop Notifications -->
                        <ui:CardControl Margin="0,0,0,8">
                            <ui:CardControl.Header>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="{res:Loc Settings_SyncNotifications}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{res:Loc Settings_SyncNotifications_Desc}"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:Button x:Name="NotificationTestButton"
                                           Content="Test Toast"
                                           Appearance="Secondary"
                                           Margin="0,0,8,0"
                                           FontSize="11" Padding="8,4"
                                           Click="NotificationTestButton_Click"
                                           ToolTip="Preview animated Steam sync toast" />
                                <ui:ToggleSwitch x:Name="ShowNotificationsToggle"
                                                 Checked="AppSettingsToggle_Changed"
                                                 Unchecked="AppSettingsToggle_Changed" />
                            </StackPanel>
                        </ui:CardControl>

                        <!-- Global Keyboard Shortcut -->
                        <ui:CardControl Margin="0,0,0,8">
                            <ui:CardControl.Header>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="{res:Loc Settings_GlobalHotkey}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                               TextWrapping="Wrap" />
                                    <!-- Hidden dummy textblock to preserve code-behind reference without visual clutter -->
                                    <TextBlock x:Name="HotkeyBadgeText" Visibility="Collapsed" />
                                    <TextBlock Text="{res:Loc Settings_GlobalHotkeyHint}"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ComboBox x:Name="HotkeyPresetCombo"
                                          Width="130" MinHeight="30"
                                          VerticalAlignment="Center"
                                          VerticalContentAlignment="Center"
                                          FontSize="11"
                                          Margin="0,0,8,0"
                                          SelectionChanged="HotkeyPresetCombo_SelectionChanged" />
                                <ui:ToggleSwitch x:Name="GlobalHotkeyToggle"
                                                 Checked="GlobalHotkeyToggle_Changed"
                                                 Unchecked="GlobalHotkeyToggle_Changed" />
                            </StackPanel>
                        </ui:CardControl>

                        <!-- Auto-Fit Window Scale -->
                        <ui:CardControl Margin="0,0,0,8">
                            <ui:CardControl.Header>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="{res:Loc Settings_AutoFitWindow}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{res:Loc Settings_AutoFitWindow_Desc}"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch x:Name="AutoFitZoomToggle"
                                             Checked="AutoFitZoomToggle_Changed"
                                             Unchecked="AutoFitZoomToggle_Changed" />
                        </ui:CardControl>
                    </StackPanel>

                    <!-- SECTION 5: Maintenance & Danger Zone -->
                    <StackPanel Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <ui:SymbolIcon Symbol="Warning24" FontSize="16" Foreground="#FF6B72" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="{res:Loc Settings_DangerZone}"
                                       FontSize="15" FontWeight="Bold"
                                       Foreground="#FF6B72" />
                        </StackPanel>

                        <ui:CardControl Margin="0,0,0,0">
                            <ui:CardControl.Header>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="{res:Loc Settings_ResetCacheTitle}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{res:Loc Settings_ResetCacheDescription}"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:Button Content="{res:Loc Settings_Reset}"
                                       Appearance="Danger"
                                       FontSize="11" Padding="12,5"
                                       Click="ResetData_Click" />
                        </ui:CardControl>
                    </StackPanel>

                </StackPanel>
            </Grid>
        </DockPanel>
    </ScrollViewer>
</Page>
