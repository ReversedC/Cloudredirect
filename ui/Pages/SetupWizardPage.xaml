<Page x:Class="CloudRedirect.Pages.SetupWizardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:res="clr-namespace:CloudRedirect.Resources"
      ScrollViewer.CanContentScroll="False">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,12">
        <StackPanel MaxWidth="820" HorizontalAlignment="Center">

            <!-- Wizard Header Banner -->
            <Border Background="{DynamicResource SteamBgCardBrush}"
                    BorderBrush="{DynamicResource SteamBorderDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20,12"
                    Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="46" Height="46"
                            CornerRadius="23"
                            Background="#16293A"
                            BorderBrush="#254F70"
                            BorderThickness="2"
                            Margin="0,0,16,0"
                            VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="CloudSync24" FontSize="24" Foreground="#66C0F4" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,14,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                            <TextBlock Text="{res:Loc Wizard_Title}"
                                       FontSize="20" FontWeight="Bold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       VerticalAlignment="Center" />
                            <Border Background="#1A3828" BorderBrush="#3D7D4F" BorderThickness="1"
                                    CornerRadius="10" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{res:Loc Wizard_Badge}" FontSize="11" FontWeight="SemiBold" Foreground="#A4D007" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{res:Loc Wizard_Subtitle}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" FontSize="12.5" />
                    </StackPanel>

                    <!-- Header Language Selector -->
                    <Border Grid.Column="2"
                            Background="#16202D"
                            BorderBrush="#2A3F5A"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="8,0,6,0"
                            MinHeight="34"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Globe24"
                                           FontSize="15"
                                           Foreground="#66C0F4"
                                           VerticalAlignment="Center"
                                           Margin="4,0,8,0" />
                            <ComboBox x:Name="LanguageComboBox"
                                      Width="145"
                                      Height="32"
                                      MinHeight="32"
                                      VerticalAlignment="Center"
                                      VerticalContentAlignment="Center"
                                      SelectionChanged="LanguageComboBox_SelectionChanged"
                                      BorderThickness="0"
                                      Background="Transparent"
                                      Padding="4,2,24,2"
                                      FontSize="12"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                      MaxDropDownHeight="320" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Step Progress Indicators -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Step 1 Pill -->
                <Border x:Name="Step1Pill" Grid.Column="0"
                        Background="#192A3A" BorderBrush="#3877A8" BorderThickness="1"
                        CornerRadius="6" Padding="12,7" Margin="0,0,6,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock x:Name="Step1Num" Text="1" FontWeight="Bold" Foreground="#66C0F4" Margin="0,0,8,0" />
                        <TextBlock x:Name="Step1Text" Text="{res:Loc Wizard_Step1_Pill}" FontWeight="SemiBold" Foreground="#66C0F4" FontSize="12" />
                    </StackPanel>
                </Border>

                <!-- Step 2 Pill -->
                <Border x:Name="Step2Pill" Grid.Column="1"
                        Background="#141E28" BorderBrush="#253548" BorderThickness="1"
                        CornerRadius="6" Padding="12,7" Margin="3,0,3,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock x:Name="Step2Num" Text="2" FontWeight="Bold" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,8,0" />
                        <TextBlock x:Name="Step2Text" Text="{res:Loc Wizard_Step2_Pill}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="12" />
                    </StackPanel>
                </Border>

                <!-- Step 3 Pill -->
                <Border x:Name="Step3Pill" Grid.Column="2"
                        Background="#141E28" BorderBrush="#253548" BorderThickness="1"
                        CornerRadius="6" Padding="12,7" Margin="6,0,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock x:Name="Step3Num" Text="3" FontWeight="Bold" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,8,0" />
                        <TextBlock x:Name="Step3Text" Text="{res:Loc Wizard_Step3_Pill}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="12" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ════════════════════════════════════════════════════════════════ -->
            <!-- STEP 1 PANEL: Prerequisites & Environment Check                -->
            <!-- ════════════════════════════════════════════════════════════════ -->
            <StackPanel x:Name="Step1Panel" Visibility="Visible">
                <TextBlock Text="{res:Loc Wizard_Step1_Title}" FontSize="17" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,4" />
                <TextBlock Text="{res:Loc Wizard_Step1_Desc}"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,12" TextWrapping="Wrap" FontSize="12.5" />

                <!-- Steam Installation Card -->
                <ui:CardControl Margin="0,0,0,8">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="{res:Loc Wizard_Step1_SteamHeader}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock x:Name="WizardSteamPathText" Text="{res:Loc Wizard_Step1_Detecting}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:SymbolIcon x:Name="WizardSteamIcon" Symbol="CheckmarkCircle24" FontSize="22" Foreground="#A4D007" />
                </ui:CardControl>

                <!-- Core Engine DLL Card -->
                <ui:CardControl Margin="0,0,0,8">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="{res:Loc Wizard_Step1_CoreDllHeader}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock x:Name="WizardDllText" Text="{res:Loc Wizard_Step1_DllCurrent}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="22" Foreground="#A4D007" />
                </ui:CardControl>

                <!-- Community Database Card -->
                <ui:CardControl Margin="0,0,0,16">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="{res:Loc Wizard_Step1_DbHeader}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock x:Name="WizardDbText" Text="{res:Loc Wizard_Step1_DbDesc}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:SymbolIcon Symbol="Database24" FontSize="22" Foreground="#66C0F4" />
                </ui:CardControl>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="Step1NextBtn"
                            Content="{res:Loc Wizard_Step1_Continue}"
                            Style="{StaticResource SteamPlayButtonStyle}"
                            FontSize="13.5"
                            Padding="24,9"
                            Click="Step1Next_Click" />
                </StackPanel>
            </StackPanel>

            <!-- ════════════════════════════════════════════════════════════════ -->
            <!-- STEP 2 PANEL: Google Drive Authorization                       -->
            <!-- ════════════════════════════════════════════════════════════════ -->
            <StackPanel x:Name="Step2Panel" Visibility="Collapsed">
                <TextBlock Text="{res:Loc Wizard_Step2_Title}" FontSize="18" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,6" />
                <TextBlock Text="{res:Loc Wizard_Step2_Desc}"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,20" TextWrapping="Wrap" />

                <!-- Primary Auth Card -->
                <Border Background="{DynamicResource SteamBgCardBrush}"
                        BorderBrush="{DynamicResource SteamBorderDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="18,14"
                        Margin="0,0,0,12">
                    <StackPanel HorizontalAlignment="Center" MaxWidth="680">
                        <ui:SymbolIcon Symbol="ShieldKeyhole24" FontSize="36" Foreground="#66C0F4" HorizontalAlignment="Center" Margin="0,0,0,8" />

                        <TextBlock Text="{res:Loc Wizard_Step2_AuthCardTitle}"
                                   FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   HorizontalAlignment="Center" Margin="0,0,0,4" />
                        <TextBlock Text="{res:Loc Wizard_Step2_AuthCardDesc}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,14" FontSize="12.5" />

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                            <Button x:Name="WizardSignInBtn"
                                     Content="{res:Loc Wizard_Step2_SignInBrowser}"
                                     Style="{StaticResource SteamPlayButtonStyle}"
                                     FontSize="13.5" FontWeight="SemiBold"
                                     Padding="20,9"
                                     Margin="0,0,10,0"
                                     Click="WizardSignIn_Click" />
                            <Button x:Name="WizardPhoneSignInBtn"
                                     Content="{res:Loc Wizard_Step2_SignInPhone}"
                                     Style="{StaticResource SteamBlueButtonStyle}"
                                     FontSize="13.5" FontWeight="SemiBold"
                                     Padding="18,9"
                                     Click="WizardPhoneSignIn_Click" />
                        </StackPanel>

                        <!-- QR Code Frame (Visible during sign-in) -->
                        <Border x:Name="WizardQrCard"
                                Background="#101822" BorderBrush="#253548" BorderThickness="1"
                                CornerRadius="6" Padding="14,12" Margin="0,0,0,10"
                                Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- QR Image Container & Quick Actions -->
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,18,0" HorizontalAlignment="Center">
                                    <Border x:Name="WizardQrContainer"
                                            Background="White"
                                            CornerRadius="6"
                                            Padding="6"
                                            Width="140" Height="140"
                                            BorderBrush="#3877A8"
                                            BorderThickness="1.5"
                                            Cursor="Hand"
                                            ToolTip="{res:Loc Wizard_Step2_QrClickToEnlarge}"
                                            MouseLeftButtonDown="WizardQrContainer_MouseLeftButtonDown">
                                        <Image x:Name="WizardQrCodeImage"
                                               Width="128" Height="128"
                                               Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                    </Border>
                                    <Button x:Name="WizardEnlargeQrBtn"
                                            Style="{StaticResource SteamSecondaryButtonStyle}"
                                            FontSize="11"
                                            Padding="10,3"
                                            Margin="0,6,0,0"
                                            HorizontalAlignment="Center"
                                            ToolTip="{res:Loc Wizard_Step2_QrClickToEnlarge}"
                                            Click="WizardEnlargeQr_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="ZoomIn24" FontSize="13" Foreground="#66C0F4" Margin="0,0,4,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{res:Loc Wizard_Step2_EnlargeQr}" FontSize="11" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                        <ui:SymbolIcon Symbol="QrCode24" FontSize="16" Foreground="#66C0F4" Margin="0,0,6,0" />
                                        <TextBlock Text="{res:Loc Wizard_Step2_QrTitle}" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    </StackPanel>
                                    <TextBlock Text="{res:Loc Wizard_Step2_QrDesc}"
                                               FontSize="11.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8" />

                                    <!-- QR Mode Selector (WrapPanel so it never truncates) -->
                                    <WrapPanel Margin="0,0,0,8">
                                        <RadioButton x:Name="WizardQrWifiRadio" Content="{res:Loc Wizard_Step2_QrWifi}" IsChecked="True" GroupName="WizardQrGroup" FontSize="11.5" Checked="WizardQrMode_Checked" Margin="0,0,12,4" />
                                        <RadioButton x:Name="WizardQrDirectRadio" Content="{res:Loc Wizard_Step2_QrDirect}" GroupName="WizardQrGroup" FontSize="11.5" Checked="WizardQrMode_Checked" Margin="0,0,0,4" />
                                    </WrapPanel>

                                    <!-- QR Size Selector & Hint -->
                                    <Border Background="#162230" BorderBrush="#253A50" BorderThickness="1" CornerRadius="4" Padding="10,5" Margin="0,2,0,0" HorizontalAlignment="Left">
                                        <WrapPanel VerticalAlignment="Center">
                                            <TextBlock Text="{res:Loc Wizard_Step2_QrSizeLabel}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                            <RadioButton x:Name="WizardQrSizeNormalRadio" Content="{res:Loc Wizard_Step2_QrSizeNormal}" IsChecked="True" GroupName="WizardQrSizeGroup" FontSize="11" Checked="WizardQrSize_Checked" Margin="0,0,10,0" VerticalAlignment="Center" />
                                            <RadioButton x:Name="WizardQrSizeLargeRadio" Content="{res:Loc Wizard_Step2_QrSizeLarge}" GroupName="WizardQrSizeGroup" FontSize="11" Checked="WizardQrSize_Checked" VerticalAlignment="Center" />
                                        </WrapPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Live Auth Status -->
                        <Border x:Name="WizardAuthStatusCard"
                                Background="#101822" BorderBrush="#253548" BorderThickness="1"
                                CornerRadius="6" Padding="12,8" Margin="0,4,0,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,3">
                                    <ui:ProgressRing x:Name="WizardAuthSpinner" IsIndeterminate="True" Width="14" Height="14" Margin="0,0,8,0" Visibility="Collapsed" />
                                    <ui:SymbolIcon x:Name="WizardAuthStatusIcon" Symbol="Info24" FontSize="15" Foreground="#66C0F4" Margin="0,0,6,0" />
                                    <TextBlock x:Name="WizardAuthStatusTitle" Text="{res:Loc Wizard_Step2_StatusReadyTitle}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="12.5" />
                                </StackPanel>
                                <TextBlock x:Name="WizardAuthStatusDetail" Text="{res:Loc Wizard_Step2_StatusReadyDesc}"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11.5" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Expander for Manual URL / Token / Offline import -->
                <Expander Header="{res:Loc Wizard_Step2_ExpanderHeader}"
                          Margin="0,0,0,14"
                          Background="{DynamicResource SteamBgCardBrush}"
                          BorderBrush="{DynamicResource SteamBorderDefaultBrush}"
                          Expanded="Expander_Toggled"
                          Collapsed="Expander_Toggled">
                    <Border Padding="14,10">
                        <StackPanel>
                            <TextBlock Text="{res:Loc Wizard_Step2_ManualDesc}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,10" TextWrapping="Wrap" FontSize="12" />

                            <!-- Copy Link -->
                            <TextBlock Text="{res:Loc Wizard_Step2_OptionA}" FontWeight="SemiBold" Margin="0,0,0,4" FontSize="12" />
                            <Button x:Name="WizardCopyUrlBtn" Content="{res:Loc Wizard_Step2_CopyUrlBtn}"
                                    Style="{StaticResource SteamSecondaryButtonStyle}"
                                    HorizontalAlignment="Left"
                                    Margin="0,0,0,12" Click="WizardCopyUrl_Click" />

                            <!-- Paste Code / URL -->
                            <TextBlock Text="{res:Loc Wizard_Step2_OptionB}" FontWeight="SemiBold" Margin="0,0,0,4" FontSize="12" />
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:TextBox x:Name="WizardManualCodeBox" PlaceholderText="{res:Loc Wizard_Step2_PastePlaceholder}" Grid.Column="0" />
                                <Button x:Name="WizardSubmitCodeBtn" Content="{res:Loc Wizard_Step2_SubmitCodeBtn}"
                                        Style="{StaticResource SteamBlueButtonStyle}"
                                        Grid.Column="1" Margin="8,0,0,0" Padding="16,5" Click="WizardSubmitCode_Click" />
                            </Grid>

                            <!-- Import File -->
                            <TextBlock Text="{res:Loc Wizard_Step2_OptionC}" FontWeight="SemiBold" Margin="0,0,0,4" FontSize="12" />
                            <Button Content="{res:Loc Wizard_Step2_BrowseFileBtn}"
                                    Style="{StaticResource SteamSecondaryButtonStyle}"
                                    HorizontalAlignment="Left"
                                    Click="WizardBrowseTokenFile_Click" />
                        </StackPanel>
                    </Border>
                </Expander>

                <Grid>
                    <Button Content="{res:Loc Wizard_Step2_Back}"
                            Style="{StaticResource SteamSecondaryButtonStyle}"
                            HorizontalAlignment="Left"
                            Padding="20,8"
                            Click="Step2Back_Click" />
                    <Button x:Name="Step2NextBtn" Content="{res:Loc Wizard_Step2_Next}"
                            Style="{StaticResource SteamPlayButtonStyle}"
                            HorizontalAlignment="Right"
                            Padding="24,8"
                            IsEnabled="False"
                            Click="Step2Next_Click" />
                </Grid>
            </StackPanel>

            <!-- ════════════════════════════════════════════════════════════════ -->
            <!-- STEP 3 PANEL: Confirmation & Finish                            -->
            <!-- ════════════════════════════════════════════════════════════════ -->
            <StackPanel x:Name="Step3Panel" Visibility="Collapsed">
                <Border Background="#102518" BorderBrush="#2B6B38" BorderThickness="1" CornerRadius="8" Padding="16,10" Margin="0,0,0,10">
                    <StackPanel HorizontalAlignment="Center">
                        <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="36" Foreground="#A4D007" HorizontalAlignment="Center" Margin="0,0,0,6" />
                        <TextBlock Text="{res:Loc Wizard_Step3_Title}"
                                   FontSize="17" FontWeight="Bold" Foreground="#A4D007" HorizontalAlignment="Center" Margin="0,0,0,3" />
                        <TextBlock Text="{res:Loc Wizard_Step3_Desc}"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextAlignment="Center" TextWrapping="Wrap" FontSize="12" />
                    </StackPanel>
                </Border>

                <!-- Configuration Summary -->
                <TextBlock Text="{res:Loc Wizard_Step3_SummaryHeader}" FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,5" />

                <ui:CardControl Margin="0,0,0,5">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="{res:Loc Wizard_Step3_StorageProvider}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="12.5" />
                            <TextBlock Text="{res:Loc Wizard_Step3_StorageProviderDesc}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11.5" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:SymbolIcon Symbol="CloudCheckmark24" FontSize="18" Foreground="#A4D007" />
                </ui:CardControl>

                <ui:CardControl Margin="0,0,0,5">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="{res:Loc Wizard_Step3_RemoteDest}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="12.5" />
                            <TextBlock Text="{res:Loc Wizard_Step3_RemoteDestDesc}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11.5" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:SymbolIcon Symbol="Folder24" FontSize="18" Foreground="#66C0F4" />
                </ui:CardControl>

                <ui:CardControl Margin="0,0,10,0">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="{res:Loc Wizard_Step3_Protection}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="12.5" />
                            <TextBlock Text="{res:Loc Wizard_Step3_ProtectionDesc}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11.5" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:SymbolIcon Symbol="ShieldCheckmark24" FontSize="18" Foreground="#A4D007" />
                </ui:CardControl>

                <!-- Final Action Buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                    <Button Content="{res:Loc Wizard_Step3_FinishBtn}"
                            Style="{StaticResource SteamPlayButtonStyle}"
                            FontSize="13.5" FontWeight="SemiBold"
                            Padding="26,9"
                            Click="FinishWizard_Click" />
                </StackPanel>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
