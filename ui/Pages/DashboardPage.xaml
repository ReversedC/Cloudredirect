<Page x:Class="CloudRedirect.Pages.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:res="clr-namespace:CloudRedirect.Resources"
      ScrollViewer.CanContentScroll="False">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,10">
        <DockPanel LastChildFill="True">

            <!-- Hidden banner kept for backward compatibility if needed -->
            <Border x:Name="UpdateBanner" Visibility="Collapsed" />

            <!-- Header with Title & Active Status Badge -->
            <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{res:Loc Dashboard_Title}"
                               FontSize="24" FontWeight="Bold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Text="{res:Loc Dashboard_Subtitle}"
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Margin="0,3,0,0" />
                </StackPanel>

                <!-- Header Controls: Language switcher, Settings button & Live Auto-Save Pulse Badge -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#16202D"
                            BorderBrush="#2A3F5A"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="8,2,6,2"
                            Margin="0,0,10,0"
                            MinHeight="36"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Globe24"
                                           FontSize="16"
                                           Foreground="#66C0F4"
                                           VerticalAlignment="Center"
                                           Margin="2,0,8,0" />
                            <ComboBox x:Name="LanguageComboBox"
                                      Width="205"
                                      Height="32"
                                      MinHeight="32"
                                      VerticalAlignment="Center"
                                      VerticalContentAlignment="Center"
                                      SelectionChanged="LanguageComboBox_SelectionChanged"
                                      BorderThickness="0"
                                      Background="Transparent"
                                      Padding="4,2,24,2"
                                      MaxDropDownHeight="320" />
                        </StackPanel>
                    </Border>
                    <ui:Button Appearance="Secondary"
                               Icon="{ui:SymbolIcon QuestionCircle24}"
                               Content="{res:Loc Dashboard_GuideBtn}"
                               ToolTip="{res:Loc Dashboard_GuideTooltip}"
                               Click="OpenGuide_Click"
                               Margin="0,0,10,0"
                               Padding="12,6"
                               Cursor="Hand" />
                    <ui:Button x:Name="SuoRemoteTopBtn"
                               Appearance="Secondary"
                               Icon="{ui:SymbolIcon Globe24}"
                               Content="SUO Remote"
                               ToolTip="Open SUO Remote Web Dashboard"
                               Click="SuoRemote_Click"
                               Visibility="Collapsed"
                               Margin="0,0,10,0"
                               Padding="12,6"
                               Cursor="Hand" />
                    <ui:Button Appearance="Secondary"
                               Icon="{ui:SymbolIcon Settings24}"
                               Content="{res:Loc Nav_Settings}"
                               Click="SettingsAction_Click"
                               Margin="0,0,10,0"
                               Padding="12,6"
                               Cursor="Hand" />
                    <Border Background="#1A2D22"
                            BorderBrush="#FF4C7515"
                            BorderThickness="1"
                            CornerRadius="16"
                            Padding="10,5"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="#FFA4D007" Margin="0,0,6,0">
                                <Ellipse.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                 From="1.0" To="0.3" Duration="0:0:1.2" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Ellipse.Triggers>
                            </Ellipse>
                            <TextBlock Text="{res:Loc Dashboard_AutoSaveSyncActive}"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="#FFA4D007" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>


            <!-- LIVE ACTIVE GAME BANNER (Auto-Detect Active Game) -->
            <Border DockPanel.Dock="Top"
                    x:Name="ActiveGameCard"
                    Visibility="Collapsed"
                    Background="#192A1A"
                    BorderBrush="#4C7815"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14,10"
                    Margin="0,4,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Steam Game Poster / Capsule Artwork -->
                    <Border Grid.Column="0"
                            x:Name="ActiveGameArtworkBorder"
                            Width="104" Height="48"
                            CornerRadius="5"
                            Margin="0,0,12,0"
                            VerticalAlignment="Center"
                            Background="#182A1A"
                            BorderBrush="#3D681C"
                            BorderThickness="1"
                            ClipToBounds="True">
                        <Grid>
                            <ui:SymbolIcon x:Name="ActiveGameFallbackIcon"
                                           Symbol="Games24" FontSize="22"
                                           Foreground="#A4D007"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Image x:Name="ActiveGamePosterImage"
                                   Stretch="UniformToFill"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                        </Grid>
                    </Border>

                    <!-- Active Game Details -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="ActiveGameBadgeDot" Width="8" Height="8" Fill="#A4D007" Margin="0,0,6,0">
                                <Ellipse.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                 From="1.0" To="0.2" Duration="0:0:0.8" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Ellipse.Triggers>
                            </Ellipse>
                            <TextBlock x:Name="ActiveGameBadgeText"
                                       Text="CURRENTLY PLAYING"
                                       FontSize="10" FontWeight="Bold"
                                       Foreground="#A4D007" />
                        </StackPanel>
                        <TextBlock x:Name="ActiveGameTitle"
                                   Text="Game Name"
                                   FontWeight="Bold" FontSize="15"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   Margin="0,2,0,0" />
                        <TextBlock x:Name="ActiveGameSubtitle"
                                   Text="AppID: 1245620 • Cloud Save Watcher Armed"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <!-- Action Button & Status Pill -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                        <ui:Button x:Name="ActiveGameFixSyncButton"
                                   Visibility="Collapsed"
                                   Content="{res:Loc Dashboard_ActiveGame_FixSync}"
                                   Icon="{ui:SymbolIcon Flash24}"
                                   Appearance="Caution"
                                   Background="#D37B00"
                                   Foreground="#FFFFFF"
                                   FontWeight="SemiBold"
                                   FontSize="11"
                                   Padding="10,4"
                                   Margin="0,0,8,0"
                                   Click="FixSync_Click"
                                   Cursor="Hand" />
                        <Border x:Name="ActiveGameStatusBorder"
                                Background="#142B1A" BorderBrush="#3D681C" BorderThickness="1"
                                CornerRadius="12" Padding="12,5" VerticalAlignment="Center">
                            <TextBlock x:Name="ActiveGameStatusPill"
                                       Text="Sync Active" FontSize="11" FontWeight="SemiBold"
                                       Foreground="#A4D007" />
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Real-Time Auto-Save Activity / Progress Notification Banner -->
            <Border DockPanel.Dock="Top"
                    x:Name="SaveActivityCard"
                    Background="#142433"
                    BorderBrush="#FF1B527A"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14,8"
                    Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Animated Icon -->
                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18"
                            Background="#1E384D" Margin="0,0,12,0" VerticalAlignment="Center">
                        <ui:SymbolIcon x:Name="ActivityIcon" Symbol="ArrowSync24" FontSize="18"
                                       Foreground="#FF66C0F4" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <!-- Activity Details -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="ActivityTitle"
                                   Text="{res:Loc Dashboard_AllSavesSynchronized}"
                                   FontWeight="SemiBold" FontSize="13"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock x:Name="ActivityDetail"
                                   Text="{res:Loc Dashboard_MonitoringGameSaves}"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Margin="0,2,0,0" />
                        <ProgressBar x:Name="ActivityProgressBar"
                                     Height="3" Margin="0,6,0,0"
                                     Visibility="Collapsed"
                                     IsIndeterminate="True"
                                     Foreground="#FF1A9FFF" Background="#0F1822" />
                    </StackPanel>

                    <!-- Status Pill -->
                    <Border Grid.Column="2" x:Name="ActivityStatusBadge"
                            Background="#183321" BorderBrush="#FF3B6B22" BorderThickness="1"
                            CornerRadius="12" Padding="10,4" VerticalAlignment="Center" Margin="12,0,0,0">
                        <TextBlock x:Name="ActivityStatusText"
                                   Text="{res:Loc Dashboard_UpToDate}" FontSize="11" FontWeight="SemiBold"
                                   Foreground="#FFA4D007" />
                    </Border>
                </Grid>
            </Border>

            <!-- 2x2 Metric Cards Grid -->
            <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- CARD 1: Cloud Storage Provider (Click to open) -->
                <Border Grid.Row="0" Grid.Column="0"
                        Style="{StaticResource SteamInteractiveCardBorderStyle}"
                        Padding="14,10" Margin="0,0,0,10"
                        MouseLeftButtonUp="CloudProviderCard_Click">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{res:Loc Dashboard_CloudProvider}"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="#FF8F98A0" />
                                <TextBlock Text="{res:Loc Dashboard_ClickToOpen}"
                                           FontSize="11" Foreground="#FF1A9FFF" Margin="6,0,0,0" />
                            </StackPanel>
                            <TextBlock x:Name="ProviderStatus"
                                       Text="{res:Loc Dashboard_NotConfigured}"
                                       FontSize="15" FontWeight="Bold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       Margin="0,3,0,3" />
                            <TextBlock Text="{res:Loc Dashboard_PersonalCloudSync}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <Border Grid.Column="1" Width="40" Height="40" CornerRadius="20"
                                Background="#1A2D3E" VerticalAlignment="Top">
                            <ui:SymbolIcon x:Name="ProviderIcon" Symbol="Cloud24" FontSize="20"
                                           Foreground="#FF1A9FFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </Border>

                <!-- CARD 2: Steam Client Integration -->
                <Border Grid.Row="0" Grid.Column="2"
                        Background="#15212D" BorderBrush="#263E52" BorderThickness="1"
                        CornerRadius="8" Padding="14,10" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{res:Loc Dashboard_SteamInstallation}"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="#FF8F98A0" />
                            <TextBlock x:Name="SteamStatus"
                                       Text="{res:Loc Dashboard_Detecting}"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       Margin="0,3,0,3" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{res:Loc Dashboard_SteamHooked}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <Border Grid.Column="1" Width="40" Height="40" CornerRadius="20"
                                Background="#1A2D3E" VerticalAlignment="Top">
                            <ui:SymbolIcon Symbol="Desktop24" FontSize="20"
                                           Foreground="#FF66C0F4" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </Border>

                <!-- CARD 3: Game Saves (Click to open) -->
                <Border Grid.Row="1" Grid.Column="0"
                        Style="{StaticResource SteamInteractiveCardBorderStyle}"
                        Padding="14,10"
                        MouseLeftButtonUp="AppsSyncingCard_Click">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{res:Loc Dashboard_AppsSyncing}"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="#FF8F98A0" />
                                <TextBlock Text="{res:Loc Dashboard_ClickToOpen}"
                                           FontSize="11" Foreground="#FFA4D007" Margin="6,0,0,0" />
                            </StackPanel>
                            <TextBlock x:Name="AppCount"
                                       Text="{res:Loc Dashboard_AppCountDefault}"
                                       FontSize="15" FontWeight="Bold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       Margin="0,3,0,3" />
                            <TextBlock Text="{res:Loc Dashboard_ProtectedCloudVersioning}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <Border Grid.Column="1" Width="40" Height="40" CornerRadius="20"
                                Background="#1A3322" VerticalAlignment="Top">
                            <ui:SymbolIcon Symbol="Apps24" FontSize="20"
                                           Foreground="#FFA4D007" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </Border>

                <!-- CARD 4: Lua Files Found (Local & Cloud) -->
                <Border Grid.Row="1" Grid.Column="2"
                        Style="{StaticResource SteamInteractiveCardBorderStyle}"
                        Padding="14,10"
                        Cursor="Hand"
                        MouseLeftButtonUp="LuaFilesCard_Click">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{res:Loc Dashboard_LuaFilesSync}"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="#FF8F98A0" />
                                <TextBlock Text="{res:Loc Dashboard_ClickToOpen}"
                                           FontSize="11" Foreground="#FF1A9FFF" Margin="6,0,0,0" />
                            </StackPanel>
                            <TextBlock x:Name="LuaFilesCount"
                                       Text="{res:Loc Dashboard_Detecting}"
                                       FontSize="15" FontWeight="Bold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       Margin="0,3,0,3" />
                            <TextBlock x:Name="LuaFilesDetail"
                                       Text=""
                                       FontSize="11"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="8,0,0,0">
                            <Border Background="#183321" BorderBrush="#3B6B22" BorderThickness="1"
                                    CornerRadius="10" Padding="7,2" HorizontalAlignment="Right" Margin="0,0,0,5">
                                <TextBlock Text="{res:Loc Dashboard_AutoBackupActive}" FontSize="10" FontWeight="SemiBold"
                                           Foreground="#A4D007" HorizontalAlignment="Center" />
                            </Border>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <ui:Button x:Name="LuaBackupBtn"
                                           Appearance="Secondary"
                                           Icon="{ui:SymbolIcon ArrowUpload24}"
                                           Content="{res:Loc Dashboard_Backup}"
                                           Padding="8,4"
                                           Margin="0,0,5,0"
                                           Cursor="Hand"
                                           ToolTip="{res:Loc Dashboard_BackupToolTip}"
                                           Click="LuaBackupManual_Click" />
                                <ui:Button x:Name="LuaRestoreBtn"
                                           Appearance="Secondary"
                                           Icon="{ui:SymbolIcon ArrowDownload24}"
                                           Content="{res:Loc Dashboard_Restore}"
                                           Padding="8,4"
                                           Cursor="Hand"
                                           ToolTip="{res:Loc Dashboard_RestoreToolTip}"
                                           Click="LuaRestoreManual_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- Bottom 2-Column Grid: Universal Cloud Saves & Redirection Core DLL -->
            <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- CARD 5: Universal Cloud Saves (Safe Mode / Hypervisor) -->
                <Border Grid.Column="0"
                        Style="{StaticResource SteamInteractiveCardBorderStyle}"
                        Padding="14,10"
                        MouseLeftButtonUp="UniversalSavesCard_Click">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{res:Loc Dashboard_UniversalSavesTitle}"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="#FF8F98A0" />
                                <TextBlock Text="{res:Loc Dashboard_UniversalSavesSubtitle}"
                                           FontSize="11" Foreground="#FF66C0F4" Margin="6,0,0,0" />
                            </StackPanel>
                            <TextBlock x:Name="UniversalSavesCountText"
                                       Text="Configured Games: 0"
                                       FontSize="15" FontWeight="Bold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       Margin="0,3,0,3" />
                            <TextBlock Text="{res:Loc Dashboard_UniversalSavesDesc}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <Border Grid.Column="1" Width="40" Height="40" CornerRadius="20"
                                Background="#182E40" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="ShieldCheckmark24" FontSize="20"
                                           Foreground="#FF66C0F4" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </Border>

                <!-- CARD 6: Redirection Core DLL -->
                <Border Grid.Column="2"
                        Background="#15212D" BorderBrush="#263E52" BorderThickness="1"
                        CornerRadius="8" Padding="14,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{res:Loc Dashboard_CloudRedirectDll}"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="#FF8F98A0" />
                            <TextBlock x:Name="DllStatus"
                                       Text="{res:Loc Dashboard_DllChecking}"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       Margin="0,3,0,2" />
                            <TextBlock Text="{res:Loc Dashboard_DllHooked}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#1B3322" BorderBrush="#FF4C7515" BorderThickness="1"
                                    CornerRadius="12" Padding="8,3" Margin="0,0,10,0">
                                <TextBlock Text="{res:Loc Dashboard_Active}" FontSize="11" FontWeight="SemiBold"
                                           Foreground="#FFA4D007" />
                            </Border>
                            <ui:SymbolIcon x:Name="DllIcon" Symbol="PlugConnected24" FontSize="20"
                                           Foreground="#FFA4D007" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- Quick Actions Toolbar -->
            <DockPanel DockPanel.Dock="Top">
                <TextBlock DockPanel.Dock="Top"
                           Text="{res:Loc Dashboard_QuickActions}"
                           FontSize="16" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           Margin="0,0,0,6" />

                <WrapPanel>
                    <!-- Steam Play Green Button -->
                    <ui:Button Content="{res:Loc Dashboard_RestartSteam}"
                               Icon="{ui:SymbolIcon ArrowSync24}"
                               Background="#FF5C7E10"
                               BorderBrush="#FF75B022"
                               Foreground="#FFFFFFFF"
                               FontWeight="SemiBold"
                               Padding="14,6"
                               Margin="0,0,8,6"
                               Cursor="Hand"
                               Click="RestartSteam_Click" />

                    <ui:Button Content="{res:Loc Nav_Cleanup}"
                               Icon="{ui:SymbolIcon Delete24}"
                               Padding="12,6"
                               Margin="0,0,8,6"
                               Cursor="Hand"
                               Click="CleanUpAction_Click" />

                    <ui:Button Content="{res:Loc Nav_Stats}"
                               Icon="{ui:SymbolIcon Trophy24}"
                               Padding="12,6"
                               Margin="0,0,8,6"
                               Cursor="Hand"
                               Click="StatsAction_Click" />

                    <ui:Button Content="{res:Loc Nav_Migration}"
                               Icon="{ui:SymbolIcon ArrowSync24}"
                               Padding="12,6"
                               Margin="0,0,8,6"
                               Cursor="Hand"
                               Click="MigrationAction_Click" />

                    <!-- Utility Buttons -->
                    <ui:Button Content="{res:Loc Dashboard_OpenLogFile}"
                               Icon="{ui:SymbolIcon Document24}"
                               Padding="12,6"
                               Margin="0,0,8,6"
                               Cursor="Hand"
                               Click="OpenLog_Click" />
                </WrapPanel>
            </DockPanel>
        </DockPanel>
    </ScrollViewer>
</Page>
