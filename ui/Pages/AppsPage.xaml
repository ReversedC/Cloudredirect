<Page x:Class="CloudRedirect.Pages.AppsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:res="clr-namespace:CloudRedirect.Resources"
      xmlns:conv="clr-namespace:CloudRedirect.Converters">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:UrlToImageSourceConverter x:Key="UrlToImageSource" />

        <!-- Subtle delete button that only turns red on hover -->
        <Style x:Key="SubtleDeleteButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#55687D" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#381B1D" />
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="#8A2528" />
                                <Setter Property="Foreground" Value="#FF6B6E" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#521F22" />
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="#B3363B" />
                                <Setter Property="Foreground" Value="#FFA4A7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Steam game card container style with subtle border & hover glow -->
        <Style x:Key="GameCardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SteamBgCardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SteamBorderSubtleBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,9" />
            <Setter Property="MinHeight" Value="72" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource SteamAccentCyanBrush}" />
                    <Setter Property="Background" Value="{DynamicResource SteamBgCardSecondaryBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Card list items: no ListBox selection/hover chrome, stretch wide. -->
        <Style x:Key="CardItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <!-- Header + action bar fixed on top; a pixel-virtualizing ListBox fills the
         rest and owns the only scrollbar. Pixel scroll keeps the mouse wheel
         working over cards while still UI-virtualizing (only visible cards are
         realized / images decoded), which kills the navigate-to-Apps lag. -->
    <DockPanel Margin="24">

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
            <TextBlock Text="{res:Loc Apps_Title}"
                       FontSize="28" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                       Margin="0,0,12,0" />
            <Border Background="#121A24"
                    BorderBrush="#253548"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="8,3"
                    VerticalAlignment="Center">
                <TextBlock x:Name="AppVersionText"
                           Text="v2.6.5"
                           FontFamily="Cascadia Code,Consolas,Courier New"
                           FontSize="12"
                           FontWeight="Medium"
                           Foreground="{DynamicResource SteamAccentCyanBrush}"
                           VerticalAlignment="Center" />
            </Border>
        </StackPanel>

        <TextBlock DockPanel.Dock="Top"
                   Text="{res:Loc Apps_Description}"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Margin="0,0,0,16" />

            <!-- app-list mode and restore mode overlay here, one visible -->
            <Grid>

            <DockPanel x:Name="AppListPanel">

                <WrapPanel x:Name="ActionBar" DockPanel.Dock="Top" Margin="0,0,0,16">
                    <ui:TextBox x:Name="AppSearchBox"
                                PlaceholderText="{res:Loc Search_Placeholder}"
                                Width="220"
                                TextChanged="AppSearchBox_TextChanged"
                                Margin="0,0,12,6" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,6">
                        <RadioButton x:Name="FilterAllAppsRadio" Style="{StaticResource SteamFilterChipStyle}"
                                     Content="{res:Loc Apps_FilterAll}" IsChecked="True" Click="FilterChip_Click" Tag="all" />
                        <RadioButton x:Name="FilterSyncedAppsRadio" Style="{StaticResource SteamFilterChipStyle}"
                                     Content="{res:Loc Apps_FilterSynced}" Click="FilterChip_Click" Tag="synced" />
                        <RadioButton x:Name="FilterOrphansAppsRadio" Style="{StaticResource SteamFilterChipStyle}"
                                     Content="{res:Loc Apps_FilterOrphans}" Click="FilterChip_Click" Tag="orphans" />
                    </StackPanel>
                    <ui:Button x:Name="RestoreSavesButton"
                               Content="{res:Loc Apps_RestoreSaves}"
                               Icon="{ui:SymbolIcon ArrowUndo24}"
                               Click="RestoreSavesButton_Click"
                               Margin="0,0,8,6" />
                    <ui:Button x:Name="ScanOrphansButton"
                               Content="{res:Loc Apps_ScanForOrphans}"
                               Icon="{ui:SymbolIcon Broom24}"
                               Click="ScanOrphans_Click"
                               Margin="0,0,8,6" />
                    <TextBlock x:Name="ScanStatusText"
                               Text=""
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center" />
                </WrapPanel>

                <ListBox x:Name="AppList"
                         BorderThickness="0"
                         Background="Transparent"
                         Padding="0"
                         ItemContainerStyle="{StaticResource CardItemStyle}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.CanContentScroll="False">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,8">
                                <Border Style="{StaticResource GameCardBorderStyle}">
                                    <Border.ContextMenu>
                                        <ContextMenu Background="#1A2634" BorderBrush="#2F4259">
                                            <MenuItem Header="Open in Google Drive" Click="OpenCloudLocation_Click">
                                                <MenuItem.Icon>
                                                    <ui:SymbolIcon Symbol="Cloud20" Foreground="#66C0F4" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Open PatchWiki Tutorial Guide" Click="OpenPatchWikiGuide_Click"
                                                      Visibility="{Binding HasPatchWikiGuide, Converter={StaticResource BoolToVis}}">
                                                <MenuItem.Icon>
                                                    <ui:SymbolIcon Symbol="BookOpen20" Foreground="#A4D007" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Open Local Storage Folder" Click="OpenLocalStorage_Click">
                                                <MenuItem.Icon>
                                                    <ui:SymbolIcon Symbol="FolderOpen20" Foreground="#A4D007" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Open Steam Userdata Folder" Click="OpenSteamUserdata_Click">
                                                <MenuItem.Icon>
                                                    <ui:SymbolIcon Symbol="Folder20" Foreground="#8F98A0" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <Separator Background="#2F4259" />
                                            <MenuItem Header="Save Version History &amp; Rollback" Click="SaveHistory_Click">
                                                <MenuItem.Icon>
                                                    <ui:SymbolIcon Symbol="History20" Foreground="#66C0F4" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <Separator Background="#2F4259" />
                                            <MenuItem Header="Delete App Saves..." Click="DeleteApp_Click">
                                                <MenuItem.Icon>
                                                    <ui:SymbolIcon Symbol="Delete20" Foreground="#FF6B6E" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                        </ContextMenu>
                                    </Border.ContextMenu>

                                    <StackPanel>
                                        <Grid Height="52">
                                            <Grid.ColumnDefinitions>
                                                <!-- Game Header Artwork -->
                                                <ColumnDefinition Width="Auto" />
                                                <!-- Title & Structured Info -->
                                                <ColumnDefinition Width="*" />
                                                <!-- Delete / Action Buttons -->
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Game Header Artwork -->
                                            <Border Grid.Column="0"
                                                    Width="104" Height="48"
                                                    CornerRadius="4"
                                                    Margin="0,0,10,0"
                                                    VerticalAlignment="Center"
                                                    Background="#121922"
                                                    BorderBrush="#253548"
                                                    BorderThickness="1"
                                                    ClipToBounds="True">
                                                <Grid>
                                                    <ui:SymbolIcon Symbol="Games24"
                                                                   FontSize="20"
                                                                   Foreground="#223344"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center" />
                                                    <Border>
                                                        <Border.Background>
                                                            <ImageBrush ImageSource="{Binding HeaderUrl, Converter={StaticResource UrlToImageSource}}"
                                                                        Stretch="UniformToFill"
                                                                        RenderOptions.BitmapScalingMode="HighQuality" />
                                                        </Border.Background>
                                                    </Border>
                                                </Grid>
                                            </Border>

                                            <!-- Middle: Title + Badges (Single Row, Never Wraps) -->
                                            <Grid Grid.Column="1" VerticalAlignment="Center" Margin="0,0,6,0">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <!-- Line 1: Title -->
                                                <TextBlock Grid.Row="0"
                                                           Text="{Binding DisplayName}"
                                                           FontSize="13.5" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource SteamTextPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           Margin="0,0,0,4" />

                                                <!-- Line 2: Compact Cohesive Badges with Interactive Drive Pill -->
                                                <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <!-- AppID Pill -->
                                                    <Border Background="#121A24"
                                                            BorderBrush="#233246"
                                                            BorderThickness="1"
                                                            CornerRadius="4"
                                                            Padding="6,2"
                                                            Margin="0,0,6,0">
                                                        <TextBlock Text="{Binding AppId}"
                                                                   FontFamily="Cascadia Code,Consolas,Courier New"
                                                                   FontSize="10.5"
                                                                   Foreground="#8F98A0"
                                                                   VerticalAlignment="Center" />
                                                    </Border>

                                                    <!-- Interactive Files & Size Pill (Click to open Google Drive save folder) -->
                                                    <Border Background="#121A24"
                                                            BorderBrush="#233246"
                                                            BorderThickness="1"
                                                            CornerRadius="4"
                                                            Padding="7,2"
                                                            Margin="0,0,6,0"
                                                            Cursor="Hand"
                                                            ToolTip="Click to open save folder in Google Drive (or local storage)"
                                                            MouseLeftButtonUp="CloudFilesPill_Click">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="#121A24" />
                                                                <Setter Property="BorderBrush" Value="#233246" />
                                                                <Style.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="Background" Value="#172738" />
                                                                        <Setter Property="BorderBrush" Value="#3888D8" />
                                                                    </Trigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <ui:SymbolIcon Symbol="Cloud20"
                                                                           FontSize="11"
                                                                           Foreground="{DynamicResource SteamAccentCyanBrush}"
                                                                           Margin="0,0,5,0"
                                                                           VerticalAlignment="Center" />
                                                            <TextBlock FontSize="10.5"
                                                                       Foreground="#C6D4DF"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       VerticalAlignment="Center">
                                                                <Run Text="{Binding FileCount, Mode=OneWay}" />
                                                                <Run Text=" " />
                                                                <Run Text="{res:Loc Apps_Files}" />
                                                                <Run Text="  •  " Foreground="#41556C" />
                                                                <Run Text="{Binding TotalSize}" />
                                                            </TextBlock>
                                                            <ui:SymbolIcon Symbol="Open20"
                                                                           FontSize="10"
                                                                           Foreground="#66C0F4"
                                                                           Margin="6,0,1,0"
                                                                           VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- Change Number Pill -->
                                                    <Border Background="#121A24"
                                                            BorderBrush="#233246"
                                                            BorderThickness="1"
                                                            CornerRadius="4"
                                                            Padding="6,2">
                                                        <TextBlock FontSize="10.5" Foreground="#8F98A0" VerticalAlignment="Center">
                                                            <Run Text="{res:Loc Apps_ChangeNumber}" Foreground="#55697E" />
                                                            <Run Text=" " />
                                                            <Run Text="{Binding ChangeNumber, Mode=OneWay}" />
                                                        </TextBlock>
                                                    </Border>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Actions: Orphans, Drive, History, Delete -->
                                            <StackPanel Grid.Column="2"
                                                        Orientation="Horizontal"
                                                        VerticalAlignment="Center">
                                                <ui:Button Content="{Binding OrphansToggleText}"
                                                           Appearance="Caution"
                                                           VerticalAlignment="Center"
                                                           Click="OrphansToggle_Click"
                                                           Visibility="{Binding HasOrphans, Converter={StaticResource BoolToVis}}"
                                                           Margin="0,0,6,0" />
                                                <ui:Button Appearance="Secondary"
                                                           VerticalAlignment="Center"
                                                           Click="PatchWikiGuide_Click"
                                                           ToolTip="{Binding PatchWikiTitle, FallbackValue='Open PatchWiki Tutorial Guide in Mini Window'}"
                                                           Visibility="{Binding HasPatchWikiGuide, Converter={StaticResource BoolToVis}}"
                                                           Margin="0,0,6,0"
                                                           Padding="8,5">
                                                    <StackPanel Orientation="Horizontal">
                                                        <ui:SymbolIcon Symbol="BookOpen24" FontSize="14" Margin="0,0,4,0" Foreground="#A4D007" />
                                                        <TextBlock Text="Guide" FontSize="11" Foreground="#A4D007" FontWeight="SemiBold" />
                                                    </StackPanel>
                                                </ui:Button>
                                                <ui:Button Appearance="Secondary"
                                                           VerticalAlignment="Center"
                                                           Click="OpenCloudLocation_Click"
                                                           ToolTip="Open save folder in Google Drive (or active cloud provider)"
                                                           Margin="0,0,6,0"
                                                           Padding="8,5">
                                                    <StackPanel Orientation="Horizontal">
                                                        <ui:SymbolIcon Symbol="FolderOpen24" FontSize="14" Margin="0,0,4,0" Foreground="#66C0F4" />
                                                        <TextBlock Text="Drive" FontSize="11" />
                                                    </StackPanel>
                                                </ui:Button>
                                                <ui:Button Appearance="Secondary"
                                                           VerticalAlignment="Center"
                                                           Click="SaveHistory_Click"
                                                           ToolTip="View Save Version History &amp; 1-Click Rollback"
                                                           Margin="0,0,6,0"
                                                           Padding="8,5">
                                                    <StackPanel Orientation="Horizontal">
                                                        <ui:SymbolIcon Symbol="History24" FontSize="14" Margin="0,0,4,0" Foreground="#66C0F4" />
                                                        <TextBlock Text="History" FontSize="11" />
                                                    </StackPanel>
                                                </ui:Button>
                                                <Button Click="DeleteApp_Click"
                                                        ToolTip="{res:Loc Apps_DeleteTooltip}"
                                                        Width="30" Height="30"
                                                        Cursor="Hand"
                                                        Style="{StaticResource SubtleDeleteButtonStyle}">
                                                    <ui:SymbolIcon Symbol="Delete24"
                                                                   FontSize="16" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Orphans Detail Panel -->
                                        <Border Visibility="{Binding OrphansDetailVisibility}"
                                                Margin="0,8,0,0"
                                                Padding="10,8"
                                                Background="#121820"
                                                BorderBrush="#253548"
                                                BorderThickness="1"
                                                CornerRadius="4">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding OrphanSummary}"
                                                               Foreground="{DynamicResource SteamTextSecondaryBrush}"
                                                               FontSize="11.5"
                                                               VerticalAlignment="Center" />
                                                    <ui:Button Grid.Column="1"
                                                               Content="{res:Loc Apps_PruneAll}"
                                                               Icon="{ui:SymbolIcon Delete24}"
                                                               Appearance="Danger"
                                                               Padding="8,4"
                                                               Click="PruneOrphans_Click" />
                                                </Grid>
                                                <ItemsControl ItemsSource="{Binding OrphanFilesPreview}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding}"
                                                                       FontFamily="Cascadia Code,Consolas,Courier New"
                                                                       FontSize="11"
                                                                       Margin="0,1"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Foreground="{DynamicResource SteamTextPrimaryBrush}" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

            </DockPanel>

            <DockPanel x:Name="RestorePanel" Visibility="Collapsed">

                <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                    <ui:Button x:Name="BackButton"
                               Content="{res:Loc Apps_Back}"
                               Icon="{ui:SymbolIcon ArrowLeft24}"
                               Click="BackToApps_Click"
                               Margin="0,0,8,0" />
                    <ui:Button x:Name="RefreshBackupsButton"
                               Content="{res:Loc Apps_Refresh}"
                               Icon="{ui:SymbolIcon ArrowSync24}"
                               Click="RefreshBackupsButton_Click"
                               Margin="0,0,8,0" />
                    <ui:TextBox x:Name="RestoreSearchBox"
                                PlaceholderText="{res:Loc Search_Placeholder}"
                                Width="250"
                                TextChanged="RestoreSearchBox_TextChanged"
                                Margin="0,0,8,0" />
                    <TextBlock x:Name="RestoreStatus"
                               Text=""
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center" />
                </WrapPanel>

                <TextBlock DockPanel.Dock="Top"
                           Text="{res:Loc Apps_RestoreDescription}"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,16" />

                <StackPanel x:Name="RestoreLoadingPanel"
                            DockPanel.Dock="Top"
                            Visibility="Collapsed"
                            HorizontalAlignment="Center"
                            Margin="0,40,0,40">
                    <ui:ProgressRing IsIndeterminate="True" Width="48" Height="48" Margin="0,0,0,12" />
                    <TextBlock Text="{res:Loc Apps_LoadingBackups}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Center" />
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="BackupListPanel" />
                </ScrollViewer>

            </DockPanel>

            </Grid>
    </DockPanel>
</Page>
