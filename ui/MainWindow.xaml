<ui:FluentWindow x:Class="CloudRedirect.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:pages="clr-namespace:CloudRedirect.Pages"
        xmlns:res="clr-namespace:CloudRedirect.Resources"
        Title="{res:Loc MainWindow_Title}"
        Height="590" Width="960"
        MinHeight="450" MinWidth="700"
        WindowStartupLocation="CenterScreen"
        WindowBackdropType="None"
        Background="{DynamicResource SteamWindowBackgroundGradient}"
        ExtendsContentIntoTitleBar="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <ui:TitleBar x:Name="AppTitleBar" Title="{res:Loc MainWindow_TitleBar}">
                <ui:TitleBar.Icon>
                    <ui:ImageIcon Source="pack://application:,,,/steam_logo3.ico" />
                </ui:TitleBar.Icon>
                <ui:TitleBar.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="TitleBarAppNameText"
                                   Text="{res:Loc MainWindow_TitleBar}"
                                   FontSize="12"
                                   FontWeight="Normal"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   VerticalAlignment="Center" />

                        <!-- CloudRedirect Version Badge -->
                        <Border x:Name="AppVersionBadge"
                                Background="#141E28"
                                BorderBrush="#253548"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="6,1"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                ToolTip="{res:Loc AppUpdate_CurrentVersionTooltip}">
                            <TextBlock x:Name="AppVersionText"
                                       Text="v2.9.65"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#66C0F4"
                                       VerticalAlignment="Center" />
                        </Border>

                        <!-- Update Available Badge (Prompt to update now or later) -->
                        <Border x:Name="TitleUpdateBadge"
                                Visibility="Collapsed"
                                Background="#16341B"
                                BorderBrush="#5BA32B"
                                BorderThickness="1"
                                CornerRadius="9"
                                Padding="7,2"
                                Margin="8,0,0,0"
                                Cursor="Hand"
                                ToolTip="{res:Loc AppUpdate_BadgeTooltip}"
                                MouseLeftButtonUp="TitleUpdateBadge_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="ArrowDownload16" FontSize="11" Foreground="#A4D007" Margin="0,0,4,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="TitleUpdateBadgeText"
                                           Text="{res:Loc AppUpdate_AvailableBadge}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="#A4D007"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ui:TitleBar.Header>
                <ui:TitleBar.TrailingContent>
                    <!-- Responsive Auto-Fit & Zoom Controls Pill -->
                    <Border VerticalAlignment="Center" Margin="0,0,8,0"
                            Background="#16222F" BorderBrush="#253A4E" BorderThickness="1"
                            CornerRadius="13" Padding="4,2">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="ZoomOutBtn"
                                    ToolTip="{res:Loc Zoom_ZoomOut_Tooltip}"
                                    Width="22" Height="22" Padding="0" Margin="0"
                                    Background="Transparent" BorderThickness="0"
                                    Foreground="#8F98A0" Cursor="Hand" Click="ZoomOut_Click">
                                <ui:SymbolIcon Symbol="SubtractCircle20" FontSize="14" />
                            </Button>
                            <TextBlock x:Name="ZoomPercentText"
                                       Text="Auto Fit"
                                       ToolTip="{res:Loc Zoom_Percent_Tooltip}"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="#66C0F4"
                                       VerticalAlignment="Center" Margin="5,0,5,0"
                                       Cursor="Hand" MouseDown="ZoomPercent_MouseDown" />
                            <Button x:Name="ZoomInBtn"
                                    ToolTip="{res:Loc Zoom_ZoomIn_Tooltip}"
                                    Width="22" Height="22" Padding="0" Margin="0"
                                    Background="Transparent" BorderThickness="0"
                                    Foreground="#8F98A0" Cursor="Hand" Click="ZoomIn_Click">
                                <ui:SymbolIcon Symbol="AddCircle20" FontSize="14" />
                            </Button>
                            <Button x:Name="AutoFitBtn"
                                    ToolTip="{res:Loc Zoom_AutoFit_Tooltip}"
                                    Width="22" Height="22" Padding="0" Margin="2,0,0,0"
                                    Background="#1C354A" BorderThickness="0"
                                    Foreground="#A4D007" Cursor="Hand" Click="AutoFit_Click">
                                <ui:SymbolIcon Symbol="FullScreenMaximize20" FontSize="13" />
                            </Button>
                        </StackPanel>
                    </Border>
                </ui:TitleBar.TrailingContent>
            </ui:TitleBar>
        </Grid>

        <Border x:Name="UpdateBanner"
                Grid.Row="1"
                Visibility="Collapsed"
                Background="#261A2B15"
                BorderBrush="#FF5C7E10"
                BorderThickness="1"
                CornerRadius="6"
                Padding="16"
                Margin="12,8,12,0">
            <StackPanel>
                <DockPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                        <ui:Button x:Name="UpdateReleaseNotesButton"
                                   Content="{res:Loc AppUpdate_ReleaseNotes}"
                                   Appearance="Secondary"
                                   Visibility="Collapsed"
                                   Margin="0,0,8,0"
                                   Click="UpdateReleaseNotes_Click" />
                        <ui:Button x:Name="UpdateSkipButton"
                                   Content="{res:Loc AppUpdate_Skip}"
                                   Appearance="Secondary"
                                   Margin="0,0,8,0"
                                   Click="UpdateSkip_Click" />
                        <ui:Button x:Name="UpdateNowButton"
                                   Content="{res:Loc AppUpdate_UpdateNow}"
                                   Appearance="Success"
                                   Click="UpdateNow_Click" />
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock x:Name="UpdateBannerTitle"
                                   Text=""
                                   FontWeight="SemiBold" FontSize="14"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock x:Name="UpdateBannerStatus"
                                   Text=""
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </DockPanel>
                <ScrollViewer x:Name="UpdateChangelogScroll"
                              Visibility="Collapsed"
                              MaxHeight="120"
                              VerticalScrollBarVisibility="Auto"
                              Margin="0,8,0,0">
                    <TextBlock x:Name="UpdateChangelogText"
                               Text=""
                               TextWrapping="Wrap"
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </ScrollViewer>
                <ProgressBar x:Name="UpdateProgressBar"
                             Visibility="Collapsed"
                             Minimum="0" Maximum="100" Value="0"
                             IsIndeterminate="True"
                             Height="3"
                             Margin="0,8,0,0" />
            </StackPanel>
        </Border>

        <!-- Top Navigation Bar (Visible when browsing sub-pages like Apps, Cloud Provider, etc.) -->
        <Border x:Name="TopNavHeader"
                Grid.Row="2"
                Visibility="Collapsed"
                Background="#17222E"
                BorderBrush="#263E52"
                BorderThickness="0,0,0,1"
                Padding="24,10">
            <DockPanel>
                <ui:Button x:Name="BackToDashboardBtn"
                           Appearance="Secondary"
                           Icon="{ui:SymbolIcon ArrowLeft24}"
                           Content="{res:Loc Nav_BackToDashboard}"
                           Click="BackToDashboard_Click"
                           Cursor="Hand" />
                <TextBlock x:Name="CurrentPageTitle"
                           Text=""
                           FontSize="15"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           VerticalAlignment="Center"
                           Margin="16,0,0,0" />
            </DockPanel>
        </Border>

        <!-- Main Content Area: Zero-Sidebar Clean Frame with Dynamic Auto-Fit Scale -->
        <Grid x:Name="ContentAreaHost" Grid.Row="3" ClipToBounds="True">
            <Frame x:Name="RootFrame"
                   NavigationUIVisibility="Hidden"
                   Background="Transparent"
                   Focusable="False">
                <Frame.LayoutTransform>
                    <ScaleTransform x:Name="GuiScaleTransform" ScaleX="1.0" ScaleY="1.0" />
                </Frame.LayoutTransform>
            </Frame>
        </Grid>
    </Grid>
</ui:FluentWindow>
