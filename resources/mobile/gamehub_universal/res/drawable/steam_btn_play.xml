<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:startColor="#8AB800" android:endColor="#6E9400" android:angle="90" />
            <corners android:radius="8dp" />
            <stroke android:width="1dp" android:color="#B5E815" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:startColor="#6FA006" android:endColor="#547A03" android:angle="90" />
            <corners android:radius="8dp" />
            <stroke android:width="1dp" android:color="#8FC407" />
        </shape>
    </item>
</selector>
